@model AumoFinance.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Mobile";
    var idr = new System.Globalization.CultureInfo("id-ID");
}

<style>
    /* Mobile Custom Styles */
    body {
        padding-bottom: 75px; /* Spasi agar tidak tertutup Bottom Nav */
        background-color: var(--bs-body-bg);
    }
    .kpi-scroll-wrapper {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 12px;
        padding-bottom: 8px;
        -webkit-overflow-scrolling: touch;
    }
    .kpi-card-mobile {
        min-width: 82%;
        scroll-snap-align: start;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
    }
    [data-bs-theme="light"] .kpi-card-mobile {
        border-color: rgba(0,0,0,0.08);
    }
    .trend-up { color: #198754; }
    .trend-down { color: #dc3545; }
    
    /* Sticky Bottom Nav */
    .mobile-bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1030;
        background: var(--bs-body-bg);
        border-top: 1px solid rgba(255,255,255,0.1);
    }
    [data-bs-theme="light"] .mobile-bottom-nav {
        border-top-color: rgba(0,0,0,0.1);
    }
</style>

<div class="container-fluid px-3 pt-3">

    <!-- Header Ringkas -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold mb-0">Financial Overview</h5>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fs-8">
                @Model.ActivePeriodName
            </span>
        </div>
        <a asp-controller="App" asp-action="JournalInput" class="btn btn-warning btn-sm rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width:40px; height:40px;">
            <i class="bi bi-plus-lg fs-5"></i>
        </a>
    </div>

    <!-- KPI Horizontal Swipe Cards -->
    <div class="kpi-scroll-wrapper mb-3">
        
        <!-- Cash -->
        <div class="card kpi-card-mobile border-0 shadow-sm p-3 bg-body-tertiary">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary fs-8 fw-bold text-uppercase">Cash &amp; Equivalents</span>
                <i class="bi bi-wallet2 text-success fs-5"></i>
            </div>
            <h3 class="fw-bold mb-1">@Model.TotalCashAndEquivalents.ToString("C0", idr)</h3>
            <div class="small @(Model.CashTrendPercent is null ? "text-secondary" : (Model.CashTrendPercent >= 0 ? "trend-up" : "trend-down"))">
                @if (Model.CashTrendPercent.HasValue)
                {
                    <i class="bi @(Model.CashTrendPercent >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                    <span>@(Math.Abs(Model.CashTrendPercent.Value).ToString("0.0"))% vs prior</span>
                }
                else { <span>—</span> }
            </div>
        </div>

        <!-- Net Income -->
        <div class="card kpi-card-mobile border-0 shadow-sm p-3 text-white" style="background: linear-gradient(135deg, var(--bs-primary), #0d6efdcc);">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="fs-8 fw-bold text-white-50 text-uppercase">Net Income</span>
                <i class="bi bi-shield-check text-warning fs-5"></i>
            </div>
            <h3 class="fw-bold mb-1">@Model.NetIncome.ToString("C0", idr)</h3>
            <div class="small text-white-50">
                @if (Model.NetIncomeTrendPercent.HasValue)
                {
                    <i class="bi @(Model.NetIncomeTrendPercent >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                    <span>@(Math.Abs(Model.NetIncomeTrendPercent.Value).ToString("0.0"))% vs prior</span>
                }
                else { <span>—</span> }
            </div>
        </div>

        <!-- Revenue -->
        <div class="card kpi-card-mobile border-0 shadow-sm p-3 bg-body-tertiary">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary fs-8 fw-bold text-uppercase">Revenue</span>
                <i class="bi bi-graph-up-arrow text-primary fs-5"></i>
            </div>
            <h3 class="fw-bold text-primary mb-1">@Model.RevenueThisPeriod.ToString("C0", idr)</h3>
            <div class="small @(Model.RevenueTrendPercent is null ? "text-secondary" : (Model.RevenueTrendPercent >= 0 ? "trend-up" : "trend-down"))">
                @if (Model.RevenueTrendPercent.HasValue)
                {
                    <i class="bi @(Model.RevenueTrendPercent >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                    <span>@(Math.Abs(Model.RevenueTrendPercent.Value).ToString("0.0"))% vs prior</span>
                }
                else { <span>—</span> }
            </div>
        </div>

        <!-- Expenses -->
        <div class="card kpi-card-mobile border-0 shadow-sm p-3 bg-body-tertiary">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary fs-8 fw-bold text-uppercase">Expenses</span>
                <i class="bi bi-exclamation-triangle text-danger fs-5"></i>
            </div>
            <h3 class="fw-bold text-danger mb-1">@Model.OperatingExpenses.ToString("C0", idr)</h3>
            <div class="small @(Model.ExpenseTrendPercent is null ? "text-secondary" : (Model.ExpenseTrendPercent >= 0 ? "trend-down" : "trend-up"))">
                @if (Model.ExpenseTrendPercent.HasValue)
                {
                    <i class="bi @(Model.ExpenseTrendPercent >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                    <span>@(Math.Abs(Model.ExpenseTrendPercent.Value).ToString("0.0"))% vs prior</span>
                }
                else { <span>—</span> }
            </div>
        </div>

    </div>

    <!-- Ringkasan Mini Assets & Liabilities -->
    <div class="row g-2 mb-3">
        <div class="col-6">
            <div class="p-2 border rounded-3 bg-body-tertiary">
                <span class="text-secondary fs-8 d-block">Total Assets</span>
                <span class="fw-bold fs-7">@Model.TotalAssets.ToString("C0", idr)</span>
            </div>
        </div>
        <div class="col-6">
            <div class="p-2 border rounded-3 bg-body-tertiary">
                <span class="text-secondary fs-8 d-block">Total Liabilities</span>
                <span class="fw-bold fs-7">@Model.TotalLiabilities.ToString("C0", idr)</span>
            </div>
        </div>
    </div>

    <!-- Chart Trend -->
    <div class="card border-0 shadow-sm rounded-3 mb-3 bg-body-tertiary">
        <div class="card-body p-3">
            <h6 class="fw-bold mb-2 fs-7">Revenue vs Expenses</h6>
            @if (Model.ChartLabels.Any())
            {
                <div style="height:200px;"><canvas id="trendChart"></canvas></div>
            }
            else
            {
                <div class="text-center text-secondary py-3 fs-8">No transaction data available.</div>
            }
        </div>
    </div>

    <!-- Recent Journals (List View Mobile) -->
    <div class="card border-0 shadow-sm rounded-3 mb-3 bg-body-tertiary">
        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 fs-7">Recent Entries</h6>
        </div>
        <div class="list-group list-group-flush">
            @if (Model.RecentJournals != null && Model.RecentJournals.Any())
            {
                foreach (var j in Model.RecentJournals.Take(5))
                {
                    <div class="list-group-item bg-transparent px-3 py-2 border-0 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-semibold d-block fs-8">@j.Date.ToString("dd MMM yyyy")</span>
                            <span class="text-success fs-8">Dr: @j.TotalDebit.ToString("N0", idr)</span>
                        </div>
                        <span class="text-danger fs-8 fw-semibold">Cr: @j.TotalCredit.ToString("N0", idr)</span>
                    </div>
                }
            }
            else
            {
                <div class="p-3 text-center text-secondary fs-8">No journal entries.</div>
            }
        </div>
    </div>

</div>

<!-- Bottom Navigation Bar (Android Native Feel) -->
<div class="mobile-bottom-nav py-2">
    <div class="d-flex justify-content-around text-center">
        <a asp-controller="App" asp-action="Dashboard" class="text-primary text-decoration-none">
            <i class="bi bi-grid-1x2-fill fs-5 d-block"></i>
            <span class="fs-8 fw-bold">Dashboard</span>
        </a>
        <a asp-controller="App" asp-action="JournalInput" class="text-secondary text-decoration-none">
            <i class="bi bi-pencil-square fs-5 d-block"></i>
            <span class="fs-8">Input Jurnal</span>
        </a>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
    Chart.defaults.color = isDark ? '#adb5bd' : '#6c757d';
    Chart.defaults.borderColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';

    const trendCanvas = document.getElementById('trendChart');
    if (trendCanvas) {
        new Chart(trendCanvas.getContext('2d'), {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
                datasets: [
                    {
                        label: 'Revenue',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartRevenue)),
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25,135,84,0.1)',
                        fill: true, tension: 0.3, borderWidth: 2, pointRadius: 2
                    },
                    {
                        label: 'Expenses',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartExpenses)),
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220,53,69,0.1)',
                        fill: true, tension: 0.3, borderWidth: 2, pointRadius: 2
                    }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { ticks: { display: false }, grid: { display: false } },
                    x: { grid: { display: false } }
                }
            }
        });
    }
});
</script>
}
