<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Paksa RootNamespace agar sesuai dengan namespace komponen & code-behind lama -->
    <RootNamespace>AumoFinance</RootNamespace>
    <UserSecretsId>3b80a545-4808-45e1-aed8-8b28c45e72fe</UserSecretsId>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project Reference ke Backend -->
    <ProjectReference Include="..\backend\AumoBackend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paket Komponen Web & Autentikasi untuk Blazor UI -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0-preview.1.25120.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0-preview.1.25120.3" />
  </ItemGroup>

</Project>
