<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3b80a545-4808-45e1-aed8-8b28c45e72fe</UserSecretsId>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project Reference ke Backend -->
    <ProjectReference Include="..\backend\AumoBackend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Override/Penyesuaian Paket khusus untuk Blazor UI jika dibutuhkan -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0-preview.1.25120.3" />
  </ItemGroup>

</Project>
