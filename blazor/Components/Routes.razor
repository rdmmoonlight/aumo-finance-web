@using AumoBlazor

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <div class="container text-center mt-5 py-5">
                        <div class="card shadow-sm border-0 rounded-4 max-w-md mx-auto p-4">
                            <i class="bi bi-shield-lock text-warning display-4 mb-3"></i>
                            <h3 class="fw-bold">Access Denied</h3>
                            <p class="text-secondary">You must sign in to access this page.</p>
                            <div class="mt-3">
                                <a href="/auth/login" class="btn btn-primary px-4 fw-semibold">Sign In</a>
                            </div>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not Found - Aumo Finance</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <div class="container text-center mt-5 py-5">
                    <div class="card shadow-sm border-0 rounded-4 max-w-md mx-auto p-4">
                        <i class="bi bi-exclamation-triangle text-danger display-4 mb-3"></i>
                        <h3 class="fw-bold">Page Not Found</h3>
                        <p class="text-secondary">The page you requested could not be found.</p>
                        <div class="mt-3">
                            <a href="/" class="btn btn-secondary px-4 fw-semibold">Return to Home</a>
                        </div>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
