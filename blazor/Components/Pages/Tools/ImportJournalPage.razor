@page "/tools/import-journal"
@namespace AumoFinance.Components.Pages.Tools
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Import Journal Entries</PageTitle>

<div class="container-fluid py-4 px-4">
    <!-- Header Navigation -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/tools" class="text-decoration-none">Tools &amp; Utilities</a></li>
                <li class="breadcrumb-item active" aria-current="page">Import Journal</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-body-emphasis mb-1">
                    <i class="bi bi-file-earmark-spreadsheet-fill me-2 text-success"></i> Import Journal Entries (.xlsx)
                </h2>
                <p class="text-secondary mb-0">Upload batch journal entries from Excel with instant preview.</p>
            </div>
            <a href="/tools" class="btn btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Tools
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (successMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- UPLOAD CARD -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center mb-3">
                <div class="col-12 col-md-8">
                    <h5 class="fw-bold mb-1"><i class="bi bi-cloud-arrow-up me-2 text-primary"></i> Select Excel File</h5>
                    <p class="text-secondary small mb-0">Select an <code>.xlsx</code> file, then click <strong>"Preview"</strong> to inspect entries inside the pop-up modal.</p>
                </div>
                <div class="col-12 col-md-4 text-md-end mt-2 mt-md-0">
                    <a href="/api/Tools/DownloadJournalTemplate" class="btn btn-outline-success btn-sm rounded-3">
                        <i class="bi bi-download me-1"></i> Download Template (.xlsx)
                    </a>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-9">
                    <InputFile class="form-control form-control-lg rounded-3" OnChange="OnFileSelected" accept=".xlsx" />
                </div>
                <div class="col-12 col-md-3">
                    <button type="button" class="btn btn-primary btn-lg w-100 fw-semibold rounded-3 shadow-sm"
                            disabled="@(selectedFile == null || isBusy || UserId == Guid.Empty)" @onclick="HandlePreview">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-eye me-2"></i>
                        }
                        Preview
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PREVIEW MODAL -->
<div class="modal fade" id="indexPreviewModal" tabindex="-1" aria-labelledby="indexPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="indexPreviewModalLabel">
                        <i class="bi bi-file-earmark-check me-2 text-success"></i> Journal Entries Preview
                    </h5>
                    <small class="text-secondary">
                        @if (parseResult != null)
                        {
                            @($"Found {parseResult.TotalTransactionsRead} transactions with {parseResult.TotalLinesRead} row entries.")
                        }
                        else
                        {
                            @:Review entries below before importing.
                        }
                    </small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                @if (parseResult != null)
                {
                    @if (parseResult.Warnings.Any())
                    {
                        <div class="alert alert-warning rounded-3 mb-4">
                            <ul class="small mb-0 ps-3">
                                @foreach (var w in parseResult.Warnings)
                                {
                                    <li>@w</li>
                                }
                            </ul>
                        </div>
                    }

                    @foreach (var tx in parseResult.Transactions)
                    {
                        <div class="card border mb-3 rounded-3 shadow-sm">
                            <div class="card-header bg-body d-flex justify-content-between align-items-center py-2 px-3">
                                <span class="badge bg-primary">@tx.JournalType Journal</span>
                                <strong><i class="bi bi-calendar-event me-1"></i> @tx.Date.ToString("MMMM d, yyyy")</strong>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover table-striped mb-0 align-middle small">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 50px;" class="text-center">#</th>
                                            <th style="width: 100px;" class="text-center">Ref</th>
                                            <th>Account Name</th>
                                            <th>Description</th>
                                            <th style="width: 150px;" class="text-end">Debit</th>
                                            <th style="width: 150px;" class="text-end">Credit</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in tx.Lines)
                                        {
                                            <tr>
                                                <td class="text-center text-secondary">@line.RowIndex</td>
                                                <td class="text-center fw-semibold">@line.RefNumber</td>
                                                <td>
                                                    @line.AccountName
                                                    @if (line.IsNewAccount)
                                                    {
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">New COA</span>
                                                    }
                                                </td>
                                                <td class="text-secondary">@line.Description</td>
                                                <td class="text-end fw-semibold text-success">@(line.Debit.HasValue ? $"Rp {line.Debit.Value.ToString("N0", Idr)}" : "-")</td>
                                                <td class="text-end fw-semibold text-danger">@(line.Credit.HasValue ? $"Rp {line.Credit.Value.ToString("N0", Idr)}" : "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-group-divider fw-bold">
                                        <tr>
                                            <td colspan="4" class="text-end">Total Amount:</td>
                                            <td class="text-end text-success">Rp @tx.Lines.Sum(l => l.Debit ?? 0).ToString("N0", Idr)</td>
                                            <td class="text-end text-danger">Rp @tx.Lines.Sum(l => l.Credit ?? 0).ToString("N0", Idr)</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success rounded-3 px-4 fw-semibold shadow-sm"
                        disabled="@(parseResult == null || !parseResult.Transactions.Any() || isBusy)" @onclick="HandleConfirmImport">
                    @if (isBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-check2-all me-1"></i>
                    }
                    Import Data
                </button>
            </div>
        </div>
    </div>
</div>
