@model AumoFinance.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card p-4 shadow-lg" style="width: 100%; max-width: 420px;">
        <h3 class="mb-3 text-center fw-bold">Welcome Back</h3>
        <p class="text-muted text-center mb-4">Sign in to Aumo Finance</p>

        @* --- DISPLAY TEMPDATA NOTIFICATIONS --- *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show p-2 small" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show p-2 small" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show p-2 small" role="alert">
                @TempData["InfoMessage"]
                <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @* --- DISPLAY MODELSTATE / LOGIN ERRORS --- *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger p-2 small" role="alert">
                <div asp-validation-summary="ModelOnly" class="mb-0"></div>
            </div>
        }

        <form method="post" asp-controller="Auth" asp-action="Login">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="text-end mb-3">
                <a asp-controller="Auth" asp-action="ForgotPassword" class="small text-decoration-none">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">Login</button>
        </form>

        <p class="text-center small mt-3 mb-0">
            Don't have an account yet? <a asp-controller="Auth" asp-action="Register" class="text-decoration-none">Register</a>
        </p>
        <p class="text-center small mt-1 mb-0">
            <a asp-controller="Auth" asp-action="ResendVerification" class="text-decoration-none">Resend verification email</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
