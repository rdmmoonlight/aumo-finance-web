<div class="container py-4">
    <!-- 1. KOTAK INFORMASI OTOMATIS (AI LIVE INSIGHTS) -->
    <div class="card border-0 shadow-sm bg-primary bg-gradient text-white mb-4 rounded-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-2">
                <i class="bi bi-robot fs-3 me-2"></i>
                <h5 class="card-title mb-0 fw-bold">Ringkasan Otomatis AI</h5>
            </div>
            <!-- Pesan ini dimuat via Javascript saat halaman terbuka -->
            <p id="aiSummaryText" class="card-text opacity-90 mb-0">
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                Menganalisis data keuangan kamu bulan ini...
            </p>
        </div>
    </div>

    <!-- 2. KOTAK-KOTAK PRESET PROMPT (KLIK LANGSUNG NANYA) -->
    <h6 class="fw-bold mb-3 text-secondary">Tanyakan Sesuatu atau Pilih Topik:</h6>
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm text-start p-3 preset-card rounded-3" onclick="sendQuickPrompt('Bagaimana kondisi arus kas saya bulan ini?')">
                <div class="text-primary mb-2 fs-4"><i class="bi bi-cash-coin"></i></div>
                <div class="fw-semibold text-dark small">Arus Kas Bulan Ini</div>
                <div class="text-muted text-truncate" style="font-size: 0.75rem;">Apakah kas aman untuk operasional?</div>
            </button>
        </div>
        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm text-start p-3 preset-card rounded-3" onclick="sendQuickPrompt('Apakah ada pengeluaran yang membengkak?')">
                <div class="text-danger mb-2 fs-4"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="fw-semibold text-dark small">Deteksi Boros</div>
                <div class="text-muted text-truncate" style="font-size: 0.75rem;">Cek pos pengeluaran terdepan.</div>
            </button>
        </div>
        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm text-start p-3 preset-card rounded-3" onclick="sendQuickPrompt('Berapa estimasi laba bersih hingga akhir periode?')">
                <div class="text-success mb-2 fs-4"><i class="bi bi-piggy-bank"></i></div>
                <div class="fw-semibold text-dark small">Proyeksi Laba</div>
                <div class="text-muted text-truncate" style="font-size: 0.75rem;">Estimasi profitabilitas berjalan.</div>
            </button>
        </div>
        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm text-start p-3 preset-card rounded-3" onclick="sendQuickPrompt('Berikan saran efisiensi keuangan singkat.')">
                <div class="text-warning mb-2 fs-4"><i class="bi bi-lightbulb"></i></div>
                <div class="fw-semibold text-dark small">Saran Efisiensi</div>
                <div class="text-muted text-truncate" style="font-size: 0.75rem;">Tips hemat rasional & pragmatis.</div>
            </button>
        </div>
    </div>

    <!-- 3. BOX CHAT / RESPONS AI -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div id="chatHistory" class="mb-3 overflow-auto" style="max-height: 400px;">
                <!-- Respons dari prompt yang di-klik atau diketik bakal muncul di sini -->
            </div>
            
            <div class="input-group">
                <input type="text" id="userInput" class="form-control border-light-subtle" placeholder="Ketik pertanyaan lain di sini...">
                <button class="btn btn-primary px-4" type="button" onclick="sendMessage()">Kirim</button>
            </div>
        </div>
    </div>
</div>

<style>
    .preset-card {
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
        background-color: #ffffff;
    }
    .preset-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>
