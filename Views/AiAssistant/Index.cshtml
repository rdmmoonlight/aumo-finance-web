@{
    ViewData["Title"] = "AI Financial Assistant";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-robot text-primary me-2"></i>AI Financial Assistant
            </h3>
            <p class="text-muted small mb-0">Business analysis, expense detection, and instant financial advice.</p>
        </div>
    </div>

    <!-- 1. AI LIVE INSIGHT (Auto Summary Box) -->
    <div class="card border-0 shadow-sm bg-primary bg-gradient text-white mb-4 rounded-4 overflow-hidden">
        <div class="card-body p-4 position-relative">
            <div class="d-flex align-items-center mb-2">
                <span class="badge bg-white text-primary fw-bold px-2 py-1 rounded-pill me-2" style="font-size: 0.75rem;">
                    <i class="bi bi-lightning-charge-fill me-1"></i>LIVE SUMMARY
                </span>
                <small class="text-white-50" id="summaryTime"></small>
            </div>
            
            <p id="aiSummaryText" class="card-text fs-6 fw-normal mb-0 opacity-90 leading-relaxed">
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                Analyzing your current cash flow & transactions...
            </p>
        </div>
    </div>

    <!-- 2. PRESET PROMPT CARDS (Quick Question Boxes) -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h6 class="fw-bold text-secondary mb-0">Recommended Quick Questions:</h6>
        <span class="text-muted style-tiny" style="font-size: 0.8rem;">Click a card to ask instantly</span>
    </div>

    <div class="row g-3 mb-4">
        <!-- Card 1: Cash Position -->
        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm p-3 preset-card rounded-4 text-start bg-body" 
                    onclick="sendQuickPrompt('How is my cash position and liquidity looking right now?')">
                <div class="badge bg-primary-subtle text-primary p-2 rounded-3 mb-2 fit-content">
                    <i class="bi bi-cash-stack fs-5"></i>
                </div>
                <div class="fw-bold text-dark small mb-1">Cash Health</div>
                <div class="text-muted text-truncate w-100" style="font-size: 0.75rem;">Check current liquid cash safety</div>
            </button>
        </div>

        <!-- Card 2: Expense Spike -->
        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm p-3 preset-card rounded-4 text-start bg-body" 
                    onclick="sendQuickPrompt('Are there any overspending areas or expenses that need review?')">
                <div class="badge bg-danger-subtle text-danger p-2 rounded-3 mb-2 fit-content">
                    <i class="bi bi-graph-up-arrow fs-5"></i>
                </div>
                <div class="fw-bold text-dark small mb-1">Overspending Alert</div>
                <div class="text-muted text-truncate w-100" style="font-size: 0.75rem;">Detect highest expense categories</div>
            </button>
        </div>

        <!-- Card 3: Profit Projection -->
        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm p-3 preset-card rounded-4 text-start bg-body" 
                    onclick="sendQuickPrompt('What is the estimated net income and revenue trend for this period?')">
                <div class="badge bg-success-subtle text-success p-2 rounded-3 mb-2 fit-content">
                    <i class="bi bi-pie-chart-fill fs-5"></i>
                </div>
                <div class="fw-bold text-dark small mb-1">Profit Forecast</div>
                <div class="text-muted text-truncate w-100" style="font-size: 0.75rem;">Project net profit for active period</div>
            </button>
        </div>

        <!-- Card 4: Efficiency Tips -->
        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm p-3 preset-card rounded-4 text-start bg-body" 
                    onclick="sendQuickPrompt('Give me 3 actionable tips to optimize financial performance.')">
                <div class="badge bg-warning-subtle text-warning p-2 rounded-3 mb-2 fit-content">
                    <i class="bi bi-lightbulb-fill fs-5"></i>
                </div>
                <div class="fw-bold text-dark small mb-1">Efficiency Tips</div>
                <div class="text-muted text-truncate w-100" style="font-size: 0.75rem;">Pragmatic cost-saving insights</div>
            </button>
        </div>
    </div>

    <!-- 3. INTERACTIVE CHAT BOX -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-chat-dots me-2 text-primary"></i>Conversation</h6>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="clearChat()">
                <i class="bi bi-trash me-1"></i>Clear
            </button>
        </div>
        <div class="card-body p-4">
            <!-- Chat Container -->
            <div id="chatHistory" class="mb-3 pe-2 overflow-y-auto style-scrollbar" style="height: 380px;">
                <div class="text-center text-muted my-5 py-4" id="emptyState">
                    <i class="bi bi-robot fs-1 text-secondary opacity-50 d-block mb-2"></i>
                    <p class="small mb-0">Click any card above or type a question below to start the discussion.</p>
                </div>
            </div>

            <!-- Input Box -->
            <div class="input-group bg-light p-2 rounded-4 border">
                <input type="text" id="userInput" class="form-control border-0 bg-transparent shadow-none" 
                       placeholder="Ask anything or request custom analysis..." 
                       onkeydown="if(event.key === 'Enter') sendMessage()">
                <button class="btn btn-primary rounded-3 px-4 fw-semibold" type="button" onclick="sendMessage()" id="btnSend">
                    <i class="bi bi-send-fill me-1"></i> Send
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .preset-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
    }
    .preset-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.08) !important;
    }
    .fit-content {
        width: fit-content;
    }
    .style-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .style-scrollbar::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 10px;
    }
</style>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetchQuickSummary();
    });

    function fetchQuickSummary() {
        fetch('/api/ai/quick-summary')
            .then(res => {
                if (!res.ok) throw new Error();
                return res.json();
            })
            .then(data => {
                document.getElementById('aiSummaryText').innerText = data.summary;
                document.getElementById('summaryTime').innerText = "Updated just now";
            })
            .catch(() => {
                document.getElementById('aiSummaryText').innerText = "Failed to load automated summary. Make sure connection and journal data exist.";
            });
    }

    function sendQuickPrompt(promptText) {
        document.getElementById('userInput').value = promptText;
        sendMessage();
    }

    function sendMessage() {
        const input = document.getElementById('userInput');
        const message = input.value.trim();
        if (!message) return;

        const emptyState = document.getElementById('emptyState');
        if (emptyState) emptyState.remove();

        const chatHistory = document.getElementById('chatHistory');

        // Render User Bubble
        const userBubble = `
            <div class="d-flex justify-content-end mb-3">
                <div class="bg-primary text-white p-3 rounded-4 shadow-sm" style="max-width: 80%; border-bottom-right-radius: 4px !important;">
                    <p class="mb-0 small">${escapeHtml(message)}</p>
                </div>
            </div>`;
        chatHistory.innerHTML += userBubble;

        input.value = '';
        toggleLoading(true);

        // Render Loading Bubble
        const loadingId = 'loading-' + Date.now();
        const loadingBubble = `
            <div id="${loadingId}" class="d-flex justify-content-start mb-3">
                <div class="bg-light border text-dark p-3 rounded-4 shadow-sm" style="border-bottom-left-radius: 4px !important;">
                    <div class="d-flex align-items-center small text-muted">
                        <span class="spinner-border spinner-border-sm me-2"></span> AI is analyzing data...
                    </div>
                </div>
            </div>`;
        chatHistory.innerHTML += loadingBubble;
        scrollToBottom();

        // Send API Request
        fetch('/api/ai/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: message })
        })
        .then(res => res.json())
        .then(data => {
            document.getElementById(loadingId).remove();
            
            const replyContent = data.reply || "Sorry, an error occurred while processing the response.";
            const aiBubble = `
                <div class="d-flex justify-content-start mb-3">
                    <div class="bg-light border text-dark p-3 rounded-4 shadow-sm" style="max-width: 85%; border-bottom-left-radius: 4px !important;">
                        <div class="small leading-relaxed">${formatMarkdown(replyContent)}</div>
                    </div>
                </div>`;
            chatHistory.innerHTML += aiBubble;
            scrollToBottom();
        })
        .catch(() => {
            document.getElementById(loadingId).remove();
            chatHistory.innerHTML += `
                <div class="d-flex justify-content-start mb-3">
                    <div class="bg-danger-subtle text-danger p-3 rounded-4 small">
                        Failed to connect to AI. Please try again later.
                    </div>
                </div>`;
            scrollToBottom();
        })
        .finally(() => {
            toggleLoading(false);
        });
    }

    function clearChat() {
        document.getElementById('chatHistory').innerHTML = `
            <div class="text-center text-muted my-5 py-4" id="emptyState">
                <i class="bi bi-robot fs-1 text-secondary opacity-50 d-block mb-2"></i>
                <p class="small mb-0">Click any card above or type a question below to start the discussion.</p>
            </div>`;
    }

    function scrollToBottom() {
        const chatHistory = document.getElementById('chatHistory');
        chatHistory.scrollTop = chatHistory.scrollHeight;
    }

    function toggleLoading(isLoading) {
        document.getElementById('btnSend').disabled = isLoading;
        document.getElementById('userInput').disabled = isLoading;
    }

    function escapeHtml(text) {
        return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function formatMarkdown(text) {
        return text
            .replace(/\n/g, '<br>')
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    }
</script>
}
