@model List<AumoFinance.Models.JournalEntry>
@{
    var period = (AumoFinance.Models.Period)ViewBag.Period;
    ViewData["Title"] = $"Period Details - {period.PeriodName}";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-eye me-2 text-primary"></i> @period.PeriodName
                @if (period.IsClosed)
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-2 align-middle"><i class="bi bi-lock-fill me-1"></i>Closed</span>
                }
                else
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle ms-2 align-middle">Open</span>
                }
            </h2>
            <p class="text-secondary mb-0">
                Read-only view of all transactions dated @period.StartDate.ToString("dd MMM yyyy") &ndash; @period.EndDate.ToString("dd MMM yyyy").
                @if (period.IsClosed)
                {
                    <span>This period is locked — data here is hidden from General/Adjusting Journal and cannot be edited.</span>
                }
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Periods
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 text-center" style="width: 5%;">Tgl</th>
                            <th style="width: 10%;">Ref.</th>
                            <th style="width: 22%;">Account</th>
                            <th style="width: 27%;">Description</th>
                            <th class="text-end" style="width: 16%;">Debit</th>
                            <th class="text-end pe-4" style="width: 16%;">Credit</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model.Any())
                        {
                            string lastDate = "";
                            int dateGroupIndex = 0;

                            for (int e = 0; e < Model.Count; e++)
                            {
                                var entry = Model[e];
                                var allLines = entry.Lines.OrderBy(l => l.LineOrder).ToList();

                                var currentDateStr = entry.EntryDate.ToString("dd-MM-yyyy");
                                var showDate = (currentDateStr != lastDate);
                                if (showDate) { lastDate = currentDateStr; dateGroupIndex++; }

                                var entryShade = (dateGroupIndex % 2 == 0) ? "" : "bg-body-secondary bg-opacity-25";

                                for (int i = 0; i < allLines.Count; i++)
                                {
                                    var line = allLines[i];
                                    var isFirstRow = (i == 0);
                                    var isDebit = line.Debit > 0;

                                    <tr class="@entryShade">
                                        <td class="ps-4 text-center align-top">
                                            @if (isFirstRow && showDate)
                                            {
                                                <span class="badge rounded-pill bg-body-secondary text-body-emphasis fw-bold small px-2 py-1">@entry.EntryDate.Day</span>
                                            }
                                        </td>
                                        <td class="align-top">
                                            @if (isFirstRow)
                                            {
                                                <code>@entry.ReferenceNumber</code>
                                            }
                                        </td>
                                        <td class="align-top @(isDebit ? "fw-semibold text-body" : "ps-4 text-body")">
                                            @line.Account?.AccountName
                                        </td>
                                        <td class="text-secondary small align-top">
                                            @line.LineDescription
                                        </td>
                                        <td class="text-end align-top @(isDebit ? "text-success fw-semibold" : "text-secondary")">
                                            @(line.Debit > 0 ? line.Debit.ToString("N0") : null)
                                        </td>
                                        <td class="text-end pe-4 align-top @(!isDebit ? "text-danger fw-semibold" : "text-secondary")">
                                            @(line.Credit > 0 ? line.Credit.ToString("N0") : null)
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-secondary">
                                    <i class="bi bi-journal-x mb-3 d-block" style="font-size: 2.5rem;"></i>
                                    No journal entries recorded in this period.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
