@model IEnumerable<AumoFinance.Models.Period> 
@{
    ViewData["Title"] = "Financial Periods";
}

<div class="container-fluid py-4 px-4">
    
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-calendar3 text-primary me-2"></i> Financial Periods
            </h2>
            <p class="text-secondary mb-0">
                Manage accounting periods, monitor statuses, and lock closed months to secure historical data.
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-4 fw-semibold shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Open New Period
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Section -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3">Period Name</th>
                            <th class="py-3">Start Date</th>
                            <th class="py-3">End Date</th>
                            <th class="py-3">Status</th>
                            <th class="text-end pe-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-body">
                                        @item.PeriodName 
                                        <!-- Contoh: "July 2026" -->
                                    </td>
                                    <td class="text-secondary">
                                        @item.StartDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td class="text-secondary">
                                        @item.EndDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        @if (item.IsClosed)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                                <i class="bi bi-lock-fill me-1"></i> Closed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-unlock-fill me-1"></i> Open
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit Period">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            
                                            @if (!item.IsClosed)
                                            {
                                                <form asp-action="ClosePeriod" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Close Period" onclick="return confirm('Are you sure you want to close this period? This will lock all transactions within these dates.');">
                                                        <i class="bi bi-door-closed"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <div class="mb-3">
                                        <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
                                    </div>
                                    <h5 class="fw-bold text-body">No Periods Found</h5>
                                    <p class="mb-0">You haven't set up any financial periods yet. Start by opening a new period.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
