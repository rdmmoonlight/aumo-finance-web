@model IEnumerable<AumoFinance.Models.Period>
@{
    ViewData["Title"] = "Accounting Periods";
}

<div class="container-fluid py-4 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-calendar3 me-2 text-primary"></i> Accounting Periods
            </h2>
            <p class="text-secondary mb-0">Manage your financial reporting cycles and accounting periods.</p>
        </div>
        <div>
            <!-- Tombol untuk membuka periode baru -->
            <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Open New Period
            </a>
        </div>
    </div>

    <!-- Alert Notifications (Sangat Penting untuk menangkap pesan dari Controller) -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm py-2" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center px-4">
            <h5 class="mb-0 fw-bold text-body-emphasis">Period List</h5>
            <span class="text-secondary small fw-semibold">Total Periods: @(Model?.Count() ?? 0)</span>
        </div>
        
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Period Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var period in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-body">
                                        @period.PeriodName
                                    </td>
                                    <td>
                                        <span class="text-secondary">@period.StartDate.ToString("dd MMM yyyy")</span>
                                    </td>
                                    <td>
                                        <span class="text-secondary">@period.EndDate.ToString("dd MMM yyyy")</span>
                                    </td>
                                    <td class="text-center">
                                        @if (period.IsClosed)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1">
                                                <i class="bi bi-lock-fill me-1"></i> Closed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                                <i class="bi bi-unlock-fill me-1"></i> Active
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <!-- Placeholder Action Buttons -->
                                        <div class="btn-group shadow-sm">
                                            <button class="btn btn-sm btn-outline-secondary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            @if (!period.IsClosed)
                                            {
                                                <button class="btn btn-sm btn-outline-warning" title="Close Period">
                                                    <i class="bi bi-lock"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="bi bi-calendar-x mb-3 d-block" style="font-size: 2.5rem;"></i>
                                    <p class="mb-0">No accounting periods have been initialized yet.</p>
                                    <small>Click "Open New Period" to start your first accounting cycle.</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
