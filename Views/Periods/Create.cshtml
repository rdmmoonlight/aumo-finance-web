@model AumoFinance.Models.OpenPeriodViewModel
@{
    ViewData["Title"] = "Open New Period";
}

<div class="container-fluid py-4 px-4">
    <div class="mb-4">
        <h2 class="fw-bold text-body-emphasis mb-1">
            <i class="bi bi-calendar-plus text-primary me-2"></i> Open New Period & Init COA
        </h2>
        <p class="text-secondary mb-0">
            Initialize a new accounting cycle. This process will register your core accounts (Cash, Bank, Equity) into the Chart of Accounts and automatically post the opening balances.
        </p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm py-2">
            <div asp-validation-summary="ModelOnly" class="mb-0 small fw-semibold"></div>
        </div>
    }

    <div class="row g-4">
        <!-- ============================================= -->
        <!-- FORM: Period Setup + New Account Init          -->
        <!-- ============================================= -->
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="openPeriodForm">

                        <!-- 1. Period Setup -->
                        <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary">1. Period Setup</h5>
                        <div class="row g-3 mb-5">
                            <div class="col-md-6">
                                <label asp-for="Month" class="form-label fw-semibold small">Month</label>
                                <select asp-for="Month" class="form-select">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Year" class="form-label fw-semibold small">Year</label>
                                <input asp-for="Year" class="form-control" type="number" min="2000" max="2100" />
                            </div>
                        </div>

                        <!-- 2. Cash Account -->
                        <h5 class="fw-bold mb-3 border-bottom pb-2 text-success">2. Cash Account Initialization (Debit)</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label asp-for="CashAccountCode" class="form-label fw-semibold small">Reference</label>
                                <input asp-for="CashAccountCode" class="form-control" placeholder="e.g., 101" autocomplete="off" />
                                <span asp-validation-for="CashAccountCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="CashAccountName" class="form-label fw-semibold small">Account Name</label>
                                <input asp-for="CashAccountName" class="form-control" placeholder="e.g., Cash" autocomplete="off" />
                                <span asp-validation-for="CashAccountName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CashBalance" class="form-label fw-semibold small">Opening Balance</label>
                                <div class="input-group">
                                    <span class="input-group-text">Rp</span>
                                    <input type="text" inputmode="numeric" name="CashBalance" id="CashBalance"
                                           value="@(Model.CashBalance == 0 ? "" : Model.CashBalance.ToString("N0"))"
                                           class="form-control text-end currency-input" placeholder="0" autocomplete="off" />
                                </div>
                                <span asp-validation-for="CashBalance" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 3. Bank Account -->
                        <h5 class="fw-bold mb-3 border-bottom pb-2 text-success">3. Bank Account Initialization (Debit)</h5>
                        <div class="row g-3 mb-5">
                            <div class="col-md-3">
                                <label asp-for="BankAccountCode" class="form-label fw-semibold small">Reference</label>
                                <input asp-for="BankAccountCode" class="form-control" placeholder="e.g., 102" autocomplete="off" />
                                <span asp-validation-for="BankAccountCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="BankAccountName" class="form-label fw-semibold small">Account Name</label>
                                <input asp-for="BankAccountName" class="form-control" placeholder="e.g., Bank Central" autocomplete="off" />
                                <span asp-validation-for="BankAccountName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BankBalance" class="form-label fw-semibold small">Opening Balance</label>
                                <div class="input-group">
                                    <span class="input-group-text">Rp</span>
                                    <input type="text" inputmode="numeric" name="BankBalance" id="BankBalance"
                                           value="@(Model.BankBalance == 0 ? "" : Model.BankBalance.ToString("N0"))"
                                           class="form-control text-end currency-input" placeholder="0" autocomplete="off" />
                                </div>
                                <span asp-validation-for="BankBalance" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 4. Equity / Retained Earnings -->
                        <h5 class="fw-bold mb-3 border-bottom pb-2 text-warning">4. Equity Equivalence (Credit)</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label asp-for="RetainedEarningsAccountCode" class="form-label fw-semibold small">Reference</label>
                                <input asp-for="RetainedEarningsAccountCode" class="form-control" placeholder="e.g., 301" autocomplete="off" />
                                <span asp-validation-for="RetainedEarningsAccountCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-9">
                                <label asp-for="RetainedEarningsAccountName" class="form-label fw-semibold small">Retained Earnings / Capital Account Name</label>
                                <input asp-for="RetainedEarningsAccountName" class="form-control" placeholder="e.g., Retained Earnings" autocomplete="off" />
                                <span asp-validation-for="RetainedEarningsAccountName" class="text-danger small"></span>
                                <div class="form-text text-secondary mt-2">
                                    <i class="bi bi-info-circle"></i> The system will automatically credit this account with the sum of the Cash and Bank balances (<strong>Rp <span id="creditPreview">0</span></strong>).
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Initialize & Open Period
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>

        <!-- ============================================= -->
        <!-- SIDEBAR: Existing Chart of Accounts Reference   -->
        <!-- ============================================= -->
        <div class="col-12 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary h-100">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <h6 class="fw-bold mb-0 text-body-emphasis">
                        <i class="bi bi-card-list me-2 text-secondary"></i> Existing Chart of Accounts
                    </h6>
                    <small class="text-secondary">Check which ref. numbers are already in use before assigning new ones above.</small>
                </div>
                <div class="card-body p-0" style="max-height: 640px; overflow-y: auto;">
                    @if (Model.ExistingAccounts != null && Model.ExistingAccounts.Any())
                    {
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="ps-3" style="width: 70px;">Ref</th>
                                    <th>Account Name</th>
                                    <th class="text-end pe-3">Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var acc in Model.ExistingAccounts)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@acc.ReferenceNumber</td>
                                        <td>@acc.AccountName</td>
                                        <td class="text-end pe-3">
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle small">@acc.Type</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center text-secondary py-5 px-3">
                            <i class="bi bi-inbox mb-2 d-block" style="font-size: 2rem;"></i>
                            <small>No accounts registered yet. The three accounts created below will be the first entries in your Chart of Accounts.</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("openPeriodForm");
        const creditPreviewEl = document.getElementById("creditPreview");

        function formatNumber(value) {
            if (!value) return "";
            let cleanValue = value.replace(/\D/g, "");
            if (!cleanValue) return "";
            return parseInt(cleanValue, 10).toLocaleString("id-ID");
        }

        function parseRawNumber(value) {
            if (!value) return 0;
            return parseInt(value.replace(/\./g, ""), 10) || 0;
        }

        function updateCreditPreview() {
            const cash = parseRawNumber(document.getElementById("CashBalance").value);
            const bank = parseRawNumber(document.getElementById("BankBalance").value);
            creditPreviewEl.textContent = (cash + bank).toLocaleString("id-ID");
        }

        form.addEventListener("input", function (e) {
            if (e.target.classList.contains("currency-input")) {
                const cursorPosition = e.target.selectionStart;
                const originalLength = e.target.value.length;

                e.target.value = formatNumber(e.target.value);

                const newLength = e.target.value.length;
                e.target.setSelectionRange(cursorPosition + (newLength - originalLength), cursorPosition + (newLength - originalLength));

                updateCreditPreview();
            }
        });

        // Terapkan formatting awal pada nilai yang sudah dirender dari server
        document.querySelectorAll(".currency-input").forEach(input => {
            if (input.value) {
                input.value = formatNumber(input.value);
            }
        });

        updateCreditPreview();
    });
</script>
