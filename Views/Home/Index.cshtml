@{
    ViewData["Title"] = "Home";
}

<div class="container py-5 mt-4">
    
    <!-- 1. Hero Section -->
    <div class="text-center mb-5">
        <div class="mb-4 text-warning">
            <!-- Main Application Icon -->
            <i class="bi bi-shield-lock-fill" style="font-size: 4.5rem;"></i>
        </div>
        <h1 class="display-5 fw-bold text-body-emphasis mb-3">^^</h1>
        <p class="lead text-secondary mb-4 mx-auto" style="max-width: 650px;">
            An integrated financial and accounting information system. Manage your full accounting cycle—from general journal entries to trial balance—with precision, discipline, and absolute accuracy.
        </p>

        <!-- Market Indicators Widget -->
        <div class="d-inline-flex flex-wrap align-items-center justify-content-center gap-3 p-2 px-3 rounded-pill bg-body-tertiary border shadow-sm mt-2" style="font-size: 0.85rem;">
            <!-- USD Rate Indicator -->
            <div class="d-flex align-items-center gap-2" title="USD to IDR Rate">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">USD</span>
                <span id="usdRate" class="fw-semibold text-body">Loading...</span>
            </div>

            <span class="text-secondary opacity-25">|</span>

            <!-- IHSG Index Indicator -->
            <div class="d-flex align-items-center gap-2" title="IHSG Index">
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">IHSG</span>
                <span id="ihsgIndex" class="fw-semibold text-body">Loading...</span>
            </div>

            <span class="text-secondary opacity-25">|</span>

            <!-- BI-Rate Indicator -->
            <div class="d-flex align-items-center gap-2" title="Bank Indonesia Policy Rate">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">BI-RATE</span>
                <span id="biRate" class="fw-semibold text-body">Loading...</span>
            </div>
        </div>
    </div>

    <hr class="my-5 text-secondary opacity-25" />

</div>

@section Scripts {
    <script>
        /**
         * Internal Server Fetcher (CORS Free & Always Working)
         */
        async function fetchMarketData() {
            const usdEl = document.getElementById('usdRate');
            const ihsgEl = document.getElementById('ihsgIndex');
            const biRateEl = document.getElementById('biRate');

            try {
                const res = await fetch('/Market/GetMarketData');
                const data = await res.json();

                if (data.success) {
                    // Render USD
                    if (usdEl && data.usd) {
                        const price = Math.round(data.usd.price);
                        const colorClass = data.usd.isUp ? 'text-success' : 'text-danger';
                        const iconClass = data.usd.isUp ? 'bi-caret-up-fill' : 'bi-caret-down-fill';
                        const percent = Math.abs(data.usd.percent).toFixed(2);

                        usdEl.innerHTML = `
                            Rp ${price.toLocaleString('id-ID')} 
                            <span class="${colorClass} ms-1" style="font-size: 0.75rem;">
                                <i class="bi ${iconClass}"></i>${percent}%
                            </span>`;
                    }

                    // Render IHSG
                    if (ihsgEl && data.ihsg) {
                        const price = data.ihsg.price;
                        const colorClass = data.ihsg.isUp ? 'text-success' : 'text-danger';
                        const iconClass = data.ihsg.isUp ? 'bi-caret-up-fill' : 'bi-caret-down-fill';
                        const percent = Math.abs(data.ihsg.percent).toFixed(2);
                        const formattedPrice = price.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                        ihsgEl.innerHTML = `
                            ${formattedPrice} 
                            <span class="${colorClass} ms-1" style="font-size: 0.75rem;">
                                <i class="bi ${iconClass}"></i>${percent}%
                            </span>`;
                    }

                    // Render BI-Rate
                    if (biRateEl && data.biRate) {
                        biRateEl.innerText = data.biRate;
                    }
                } else {
                    if (usdEl) usdEl.innerText = '-';
                    if (ihsgEl) ihsgEl.innerText = '-';
                    if (biRateEl) biRateEl.innerText = '-';
                }
            } catch (err) {
                if (usdEl) usdEl.innerText = '-';
                if (ihsgEl) ihsgEl.innerText = '-';
                if (biRateEl) biRateEl.innerText = '-';
            }
        }

        document.addEventListener('DOMContentLoaded', fetchMarketData);
    </script>
}
