@using AumoFinance.Components
@{
    ViewData["Title"] = "Home";
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8 text-center">
            
            <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary bg-opacity-75 p-4 p-md-5 backdrop-blur">
                <div class="card-body p-0">
                    
                    <!-- Main Application Icon -->
                    <div class="mb-3 text-warning d-inline-block p-3 rounded-circle bg-warning-subtle bg-opacity-50">
                        <i class="bi bi-shield-lock-fill display-4 lh-1"></i>
                    </div>

                    <!-- Blazor Market Widget Component -->
                    <div class="d-block mb-4">
                        <component type="typeof(MarketWidget)" render-mode="ServerPrerendered" />
                    </div>

                    <!-- Title & Description -->
                    <h1 class="fw-bold text-body-emphasis mb-3 tracking-tight">
                        Financial & Accounting System
                    </h1>
                    <p class="lead text-secondary mb-4 mx-auto style-description" style="max-width: 620px; font-size: 1.05rem;">
                        An integrated financial and accounting information system. Manage your full accounting cycle—from general journal entries to trial balance—with precision, discipline, and absolute accuracy.
                    </p>

                    <!-- Quick Navigation Actions -->
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a href="/Dashboard" class="btn btn-primary px-4 py-2 rounded-pill fw-medium">
                            <i class="bi bi-speedometer2 me-1"></i> Go to Dashboard
                        </a>
                        <a href="/Journal" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-medium">
                            <i class="bi bi-journal-text me-1"></i> General Journal
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
