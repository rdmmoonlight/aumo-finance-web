@model AumoFinance.Models.SettingsViewModel
@{
    ViewData["Title"] = "Pengaturan";
}

<div class="container-fluid p-0">
    <h2 class="mb-4">Pengaturan Aplikasi</h2>

    <div class="row">
        <!-- Panel 1: Penampilan & Tema -->
        <div class="col-md-6 mb-4">
            <div class="card p-4 h-100 shadow-sm border-0">
                <h5 class="card-title mb-4">
                    <i class="bi bi-palette-fill me-2 text-primary"></i>Penampilan & Tema
                </h5>
                
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="mb-1">Mode Gelap (Dark Mode)</h6>
                        <small class="text-muted">Kurangi ketegangan mata saat bekerja di ruangan minim cahaya.</small>
                    </div>
                    <div class="form-check form-switch fs-4">
                        <input class="form-check-input" type="checkbox" role="switch" id="themeToggleSwitch" checked="@Model.IsDarkMode">
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel 2: Notifikasi & Rutinitas -->
        <div class="col-md-6 mb-4">
            <div class="card p-4 h-100 shadow-sm border-0">
                <h5 class="card-title mb-4">
                    <i class="bi bi-bell-fill me-2 text-warning"></i>Notifikasi & Pengingat
                </h5>
                
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="mb-1">Peringatan Sistem</h6>
                        <small class="text-muted">Terima notifikasi untuk aktivitas sistem penting.</small>
                    </div>
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" role="switch" id="systemAlertToggle" checked="@Model.EnableSystemAlerts">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
  <div id="settingsToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body">
        Pengaturan berhasil disimpan.
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // --- DOM Elements ---
            const themeSwitch = document.getElementById('themeToggleSwitch');
            const systemAlertSwitch = document.getElementById('systemAlertToggle');
            const toastElement = document.getElementById('settingsToast');
            
            // --- Initialize Bootstrap Toast ---
            const toast = new bootstrap.Toast(toastElement, { delay: 3000 });

            // --- Load Saved Settings ---
            // Kunci 'aumo_theme' harus sama dengan yang dipakai _Layout.cshtml /
            // window.setAppTheme, supaya toggle di halaman ini sinkron dengan
            // pilihan tema di TopBar. Jika belum ada nilai tersimpan, pertahankan
            // nilai yang sudah dirender dari Model (server-side).
            const savedTheme = localStorage.getItem('aumo_theme');

            if (savedTheme !== null) {
                themeSwitch.checked = (savedTheme === 'dark');
            }

            // --- Function to Show Toast ---
            const showToast = (message) => {
                toastElement.querySelector('.toast-body').textContent = message;
                toast.show();
            };

            // --- Event Listeners ---
            
            // 1. Theme Toggle
            themeSwitch.addEventListener('change', function () {
                const selectedTheme = this.checked ? 'dark' : 'light';

                // window.setAppTheme (didefinisikan di _Layout.cshtml) yang
                // menyimpan ke localStorage['aumo_theme'] sekaligus menerapkan
                // atribut data-bs-theme. Jangan tulis key terpisah di sini agar
                // tidak kembali tidak sinkron dengan TopBar.
                if (typeof window.setAppTheme === 'function') {
                    window.setAppTheme(selectedTheme);
                } else {
                    document.documentElement.setAttribute('data-bs-theme', selectedTheme);
                    localStorage.setItem('aumo_theme', selectedTheme);
                }
                showToast(`Tema diubah ke mode ${selectedTheme === 'dark' ? 'Gelap' : 'Terang'}.`);
            });
        });
    </script>
}
