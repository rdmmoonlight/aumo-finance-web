@model AumoFinance.Models.DTOs.JournalImportResultDto

@{
    ViewData["Title"] = "Import Journal Entries";
}

<div class="container-fluid py-4 px-4">
    <!-- Header Navigation -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Tools & Utilities</a></li>
                <li class="breadcrumb-item active" aria-current="page">Import Journal</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-body-emphasis mb-1">
                    <i class="bi bi-file-earmark-spreadsheet-fill me-2 text-success"></i> Import Journal Entries (.xlsx)
                </h2>
                <p class="text-secondary mb-0">Upload, preview, and review batch journal entries before saving to the database.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Tools
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- UPLOAD CARD -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center mb-3">
                <div class="col-12 col-md-8">
                    <h5 class="fw-bold mb-1"><i class="bi bi-cloud-arrow-up me-2 text-primary"></i> 1. Select Excel File</h5>
                    <p class="text-secondary small mb-0">Select an <code>.xlsx</code> file. The preview pop-up will appear instantly upon file selection.</p>
                </div>
                <div class="col-12 col-md-4 text-md-end mt-2 mt-md-0">
                    <a asp-action="DownloadJournalTemplate" class="btn btn-outline-success btn-sm rounded-3">
                        <i class="bi bi-download me-1"></i> Download Template (.xlsx)
                    </a>
                </div>
            </div>

            <form asp-action="PreviewJournal" method="post" enctype="multipart/form-data" id="mainUploadForm">
                <div class="row g-3">
                    <div class="col-12 col-md-9">
                        <input class="form-control form-control-lg rounded-3" 
                               type="file" 
                               id="excelFileInput" 
                               name="excelFile" 
                               accept=".xlsx" 
                               required />
                    </div>
                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold rounded-3 shadow-sm">
                            <i class="bi bi-search me-2"></i> Preview Data
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- PREVIEW RESULTS TABLE (IF PARSED BY SERVER) -->
    @if (Model != null && Model.IsSuccess)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
            <div class="card-header bg-transparent border-bottom p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1"><i class="bi bi-eye me-2 text-info"></i> 2. Review Parsed Entries</h5>
                    <small class="text-secondary">Found <strong>@Model.TotalTransactionsRead</strong> transactions (@Model.TotalLinesRead rows).</small>
                </div>
                <form asp-action="ConfirmImport" method="post">
                    <button type="submit" class="btn btn-success btn-lg px-4 fw-semibold rounded-3 shadow-sm">
                        <i class="bi bi-check2-all me-2"></i> Confirm & Save Entries
                    </button>
                </form>
            </div>
            <div class="card-body p-4">
                @foreach (var tx in Model.Transactions)
                {
                    decimal totalDebit = tx.Lines.Sum(l => l.Debit ?? 0m);
                    decimal totalCredit = tx.Lines.Sum(l => l.Credit ?? 0m);

                    <div class="card border mb-3 rounded-3 shadow-sm">
                        <div class="card-header bg-body d-flex justify-content-between align-items-center py-2 px-3">
                            <span class="badge bg-primary">@tx.JournalType Journal</span>
                            <strong><i class="bi bi-calendar-event me-1"></i> @tx.Date.ToString("MMMM dd, yyyy")</strong>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 align-middle small">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center">#</th>
                                        <th class="text-center">Ref</th>
                                        <th>Account Name</th>
                                        <th>Description</th>
                                        <th class="text-end">Debit ($)</th>
                                        <th class="text-end">Credit ($)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in tx.Lines)
                                    {
                                        <tr>
                                            <td class="text-center text-secondary">@line.RowIndex</td>
                                            <td class="text-center fw-semibold">@line.RefNumber</td>
                                            <td>@line.AccountName</td>
                                            <td class="text-secondary">@line.Description</td>
                                            <td class="text-end text-success">@(line.Debit.HasValue ? line.Debit.Value.ToString("N2") : "-")</td>
                                            <td class="text-end text-danger">@(line.Credit.HasValue ? line.Credit.Value.ToString("N2") : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- INSTANT POP-UP PREVIEW MODAL -->
<div class="modal fade" id="filePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i> Instant File Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalPreviewBody">
                <!-- Dynamic content loaded via JS -->
            </div>
            <div class="modal-footer border-top px-4">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" onclick="document.getElementById('mainUploadForm').submit();">
                    Proceed to Server Process <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include SheetJS for Instant Client-Side XLSX Reading -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script>
        document.getElementById('excelFileInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: 'array' });

                let htmlContent = '';
                workbook.SheetNames.forEach(sheetName => {
                    const worksheet = workbook.Sheets[sheetName];
                    const json = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                    if (json.length > 0) {
                        htmlContent += `<h6 class="fw-bold mt-3 mb-2 text-primary">Sheet: ${sheetName}</h6>`;
                        htmlContent += `<div class="table-responsive mb-4"><table class="table table-sm table-bordered small">`;
                        
                        json.forEach((row, idx) => {
                            if (row.length === 0) return;
                            const isHeader = idx < 4;
                            htmlContent += `<tr class="${isHeader ? 'table-dark' : ''}">`;
                            row.forEach(cell => {
                                htmlContent += `<${isHeader ? 'th' : 'td'}>${cell ?? ''}</${isHeader ? 'th' : 'td'}>`;
                            });
                            htmlContent += `</tr>`;
                        });
                        htmlContent += `</table></div>`;
                    }
                });

                document.getElementById('modalPreviewBody').innerHTML = htmlContent || '<p class="text-muted">No readable data found in this file.</p>';
                
                // Show Bootstrap Modal
                const modal = new bootstrap.Modal(document.getElementById('filePreviewModal'));
                modal.show();
            };
            reader.readAsArrayBuffer(file);
        });
    </script>
}
