@model AumoFinance.Models.DTOs.JournalImportResultDto

@{
    ViewData["Title"] = "Import Journal Entries";
}

<div class="container-fluid py-4 px-4">
    <!-- Header Navigation -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Tools & Utilities</a></li>
                <li class="breadcrumb-item active" aria-current="page">Import Journal</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-body-emphasis mb-1">
                    <i class="bi bi-file-earmark-spreadsheet-fill me-2 text-success"></i> Import Journal Entries (.xlsx)
                </h2>
                <p class="text-secondary mb-0">Upload batch journal entries from Excel with instant client-side preview.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Tools
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- UPLOAD CARD -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center mb-3">
                <div class="col-12 col-md-8">
                    <h5 class="fw-bold mb-1"><i class="bi bi-cloud-arrow-up me-2 text-primary"></i> 1. Select Excel File</h5>
                    <p class="text-secondary small mb-0">Choosing an <code>.xlsx</code> file will instantly pop up the preview dialog.</p>
                </div>
                <div class="col-12 col-md-4 text-md-end mt-2 mt-md-0">
                    <a asp-action="DownloadJournalTemplate" class="btn btn-outline-success btn-sm rounded-3">
                        <i class="bi bi-download me-1"></i> Download Template (.xlsx)
                    </a>
                </div>
            </div>

            <form asp-action="PreviewJournal" method="post" enctype="multipart/form-data" id="mainUploadForm">
                <div class="row g-3">
                    <div class="col-12 col-md-9">
                        <input class="form-control form-control-lg rounded-3" 
                               type="file" 
                               id="excelFileInput" 
                               name="excelFile" 
                               accept=".xlsx" 
                               required />
                    </div>
                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold rounded-3 shadow-sm">
                            <i class="bi bi-search me-2"></i> Preview Data
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- PREVIEW RESULTS TABLE (PARSED BY SERVER) -->
    @if (Model != null && Model.IsSuccess)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
            <div class="card-header bg-transparent border-bottom p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1"><i class="bi bi-eye me-2 text-info"></i> 2. Review Parsed Entries</h5>
                    <small class="text-secondary">Found <strong>@Model.TotalTransactionsRead</strong> transactions (@Model.TotalLinesRead rows).</small>
                </div>
                <form asp-action="ConfirmImport" method="post">
                    <button type="submit" class="btn btn-success btn-lg px-4 fw-semibold rounded-3 shadow-sm">
                        <i class="bi bi-check2-all me-2"></i> Confirm & Save Entries
                    </button>
                </form>
            </div>
            <div class="card-body p-4">
                @foreach (var tx in Model.Transactions)
                {
                    decimal totalDebit = tx.Lines.Sum(l => l.Debit ?? 0m);
                    decimal totalCredit = tx.Lines.Sum(l => l.Credit ?? 0m);

                    <div class="card border mb-3 rounded-3 shadow-sm">
                        <div class="card-header bg-body d-flex justify-content-between align-items-center py-2 px-3">
                            <span class="badge bg-primary">@tx.JournalType Journal</span>
                            <strong><i class="bi bi-calendar-event me-1"></i> @tx.Date.ToString("MMMM dd, yyyy")</strong>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 align-middle small">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center">#</th>
                                        <th class="text-center">Ref</th>
                                        <th>Account Name</th>
                                        <th>Description</th>
                                        <th class="text-end">Debit ($)</th>
                                        <th class="text-end">Credit ($)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in tx.Lines)
                                    {
                                        <tr>
                                            <td class="text-center text-secondary">@line.RowIndex</td>
                                            <td class="text-center fw-semibold">@line.RefNumber</td>
                                            <td>
                                                @line.AccountName
                                                @if (line.IsNewAccount)
                                                {
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">New COA</span>
                                                }
                                            </td>
                                            <td class="text-secondary">@line.Description</td>
                                            <td class="text-end text-success">@(line.Debit.HasValue ? line.Debit.Value.ToString("N2") : "-")</td>
                                            <td class="text-end text-danger">@(line.Credit.HasValue ? line.Credit.Value.ToString("N2") : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- INSTANT POP-UP PREVIEW MODAL -->
<div class="modal fade" id="filePreviewModal" tabindex="-1" aria-labelledby="filePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4">
                <h5 class="modal-title fw-bold" id="filePreviewModalLabel">
                    <i class="bi bi-file-earmark-check me-2 text-success"></i> File Selected
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center" id="modalPreviewBody">
                <div class="p-3 bg-light rounded-3 mb-3 text-start">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-file-earmark-spreadsheet fs-2 text-success me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-0" id="modalFileName">filename.xlsx</h6>
                            <small class="text-muted" id="modalFileSize">0 KB</small>
                        </div>
                    </div>
                </div>
                <p class="text-secondary small mb-0">
                    File is ready to be parsed. Click <strong>"Process & Preview Entries"</strong> to view structured debit/credit entries before saving.
                </p>
            </div>
            <div class="modal-footer border-top px-4">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" id="btnSubmitModal">
                    Process & Preview Entries <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Use Global Event Listener to prevent missing bindings
        document.addEventListener('change', function (e) {
            if (e.target && e.target.id === 'excelFileInput') {
                const input = e.target;
                if (!input.files || input.files.length === 0) return;

                const file = input.files[0];

                // Populate file details into modal
                document.getElementById('modalFileName').innerText = file.name;
                document.getElementById('modalFileSize').innerText = (file.size / 1024).toFixed(2) + ' KB';

                // Show Bootstrap Modal
                const modalEl = document.getElementById('filePreviewModal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        });

        // Modal Action Button Submit
        document.getElementById('btnSubmitModal').addEventListener('click', function () {
            document.getElementById('mainUploadForm').submit();
        });
    </script>
}
