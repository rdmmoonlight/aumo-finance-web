@{
    ViewData["Title"] = "Import Journal Entries";
}

<div class="container-fluid py-4 px-4">
    <!-- Header Navigation -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Tools & Utilities</a></li>
                <li class="breadcrumb-item active" aria-current="page">Import Journal</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-body-emphasis mb-1">
                    <i class="bi bi-file-earmark-spreadsheet-fill me-2 text-success"></i> Import Journal Entries (.xlsx)
                </h2>
                <p class="text-secondary mb-0">Upload batch journal entries from Excel with instant modal preview.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Tools
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- UPLOAD FORM CARD -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center mb-3">
                <div class="col-12 col-md-8">
                    <h5 class="fw-bold mb-1"><i class="bi bi-cloud-arrow-up me-2 text-primary"></i> Select Excel File</h5>
                    <p class="text-secondary small mb-0">Select an <code>.xlsx</code> file, then click <strong>"Preview"</strong> to inspect entries inside a pop-up modal before saving.</p>
                </div>
                <div class="col-12 col-md-4 text-md-end mt-2 mt-md-0">
                    <a asp-action="DownloadJournalTemplate" class="btn btn-outline-success btn-sm rounded-3">
                        <i class="bi bi-download me-1"></i> Download Template (.xlsx)
                    </a>
                </div>
            </div>

            <form id="previewForm" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-12 col-md-9">
                        <input class="form-control form-control-lg rounded-3" 
                               type="file" 
                               id="excelFileInput" 
                               name="excelFile" 
                               accept=".xlsx" 
                               required />
                    </div>
                    <div class="col-12 col-md-3">
                        <button type="submit" id="btnPreview" class="btn btn-primary btn-lg w-100 fw-semibold rounded-3 shadow-sm">
                            <span id="btnSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status"></span>
                            <i class="bi bi-eye me-2" id="btnIcon"></i> Preview
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- PREVIEW MODAL -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="previewModalLabel">
                        <i class="bi bi-file-earmark-check me-2 text-success"></i> Journal Entries Preview
                    </h5>
                    <small class="text-secondary" id="modalSubHeader">Review entries below before importing.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4" id="modalBodyContainer">
                <!-- Parsed transactions table loaded dynamically via JavaScript -->
            </div>

            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="ConfirmImport" method="post" class="m-0">
                    <button type="submit" class="btn btn-success rounded-3 px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check2-all me-1"></i> Import Data
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('previewForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const fileInput = document.getElementById('excelFileInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Please select an Excel file first.');
                return;
            }

            const btnPreview = document.getElementById('btnPreview');
            const btnSpinner = document.getElementById('btnSpinner');
            const btnIcon = document.getElementById('btnIcon');

            // UI Loading state
            btnPreview.disabled = true;
            btnSpinner.classList.remove('d-none');
            btnIcon.classList.add('d-none');

            const formData = new FormData();
            formData.append('excelFile', fileInput.files[0]);

            try {
                const response = await fetch('@Url.Action("PreviewJournal", "Tools")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (!result.success) {
                    alert('Error: ' + result.message);
                    return;
                }

                // Render Modal Content
                renderModalBody(result.data);

                // Open Bootstrap Modal
                const modal = new bootstrap.Modal(document.getElementById('previewModal'));
                modal.show();

            } catch (err) {
                alert('An unexpected error occurred while parsing the Excel file.');
                console.error(err);
            } finally {
                // Restore button state
                btnPreview.disabled = false;
                btnSpinner.classList.add('d-none');
                btnIcon.classList.remove('d-none');
            }
        });

        function renderModalBody(data) {
            const container = document.getElementById('modalBodyContainer');
            document.getElementById('modalSubHeader').innerText = `Found ${data.totalTransactionsRead} transactions with ${data.totalLinesRead} line entries.`;

            let html = '';

            // Warnings section
            if (data.warnings && data.warnings.length > 0) {
                html += `<div class="alert alert-warning rounded-3 mb-4"><ul class="small mb-0 ps-3">`;
                data.warnings.forEach(w => html += `<li>${w}</li>`);
                html += `</ul></div>`;
            }

            // Transactions tables loop
            data.transactions.forEach(tx => {
                let totalDebit = 0;
                let totalCredit = 0;

                let rowsHtml = '';
                tx.lines.forEach(line => {
                    const debVal = line.debit != null ? line.debit : 0;
                    const credVal = line.credit != null ? line.credit : 0;
                    totalDebit += debVal;
                    totalCredit += credVal;

                    const debText = line.debit != null ? line.debit.toLocaleString('en-US', { minimumFractionDigits: 2 }) : '-';
                    const credText = line.credit != null ? line.credit.toLocaleString('en-US', { minimumFractionDigits: 2 }) : '-';

                    const newBadge = line.isNewAccount ? `<span class="badge bg-info-subtle text-info border border-info-subtle ms-1">New COA</span>` : '';

                    rowsHtml += `
                        <tr>
                            <td class="text-center text-secondary">${line.rowIndex}</td>
                            <td class="text-center fw-semibold">${line.refNumber}</td>
                            <td>${line.accountName} ${newBadge}</td>
                            <td class="text-secondary">${line.description}</td>
                            <td class="text-end fw-semibold text-success">${debText}</td>
                            <td class="text-end fw-semibold text-danger">${credText}</td>
                        </tr>
                    `;
                });

                const formattedDate = new Date(tx.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

                html += `
                    <div class="card border mb-3 rounded-3 shadow-sm">
                        <div class="card-header bg-body d-flex justify-content-between align-items-center py-2 px-3">
                            <span class="badge bg-primary">${tx.journalType} Journal</span>
                            <strong><i class="bi bi-calendar-event me-1"></i> ${formattedDate}</strong>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 align-middle small">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50px;" class="text-center">#</th>
                                        <th style="width: 100px;" class="text-center">Ref</th>
                                        <th>Account Name</th>
                                        <th>Description</th>
                                        <th style="width: 150px;" class="text-end">Debit ($)</th>
                                        <th style="width: 150px;" class="text-end">Credit ($)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${rowsHtml}
                                </tbody>
                                <tfoot class="table-group-divider fw-bold">
                                    <tr>
                                        <td colspan="4" class="text-end">Total Amount:</td>
                                        <td class="text-end text-success">${totalDebit.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                                        <td class="text-end text-danger">${totalCredit.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }
    </script>
}
