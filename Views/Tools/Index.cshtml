@{
    ViewData["Title"] = "Tools & Utilities";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-tools me-2 text-warning"></i> Tools & Utilities
            </h2>
            <p class="text-secondary mb-0">System operations, batch data processing, and period-end maintenance.</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        
        <!-- ========================================== -->
        <!-- 1. IMPORT JOURNAL ENTRIES (.XLSX)          -->
        <!-- ========================================== -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-body-tertiary">
                <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0 px-4">
                    <h5 class="fw-bold"><i class="bi bi-file-earmark-spreadsheet text-success me-2"></i> Import Journal Entries</h5>
                </div>
                <div class="card-body px-4">
                    <p class="text-secondary small mb-4">
                        Upload batch journal entries using the standard <code>.xlsx</code> format. Strict validation will be applied to verify debit/credit balance before committing records to the ledger.
                    </p>

                    <!-- Template Format Info -->
                    <div class="bg-body rounded-3 p-3 mb-4 border">
                        <span class="d-block fw-semibold small mb-2">Required Columns (Row 1 Header):</span>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-secondary">Date</span>
                            <span class="badge bg-secondary">Account Name</span>
                            <span class="badge bg-secondary">Description</span>
                            <span class="badge bg-secondary">Ref</span>
                            <span class="badge bg-secondary">Debit</span>
                            <span class="badge bg-secondary">Credit</span>
                        </div>
                        <ul class="text-secondary small mb-3 ps-3">
                            <li>2 Worksheets: <strong>GJ</strong> (General Journal) and <strong>AJ</strong> (Adjusting Journal).</li>
                            <li>Rows sharing the same <strong>Date</strong> will be grouped as a single entry.</li>
                            <li><strong>Ref</strong> corresponds to Chart of Accounts (COA) numbers. Missing accounts will be created automatically.</li>
                        </ul>
                        <a asp-action="DownloadJournalTemplate" class="btn btn-sm btn-outline-success rounded-3">
                            <i class="bi bi-download me-1"></i> Download Template (.xlsx)
                        </a>
                    </div>

                    <!-- Upload & Preview Form -->
                    <form id="indexPreviewForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="indexExcelFileInput" class="form-label fw-semibold small">Select Excel File</label>
                            <input class="form-control" type="file" id="indexExcelFileInput" name="excelFile" accept=".xlsx" required>
                        </div>
                        <button type="submit" id="btnIndexPreview" class="btn btn-primary px-4 fw-semibold shadow-sm w-100 rounded-3">
                            <span id="btnIndexSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status"></span>
                            <i class="bi bi-eye me-2" id="btnIndexIcon"></i> Preview Entries
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 2. END OF PERIOD / MONTH-END CLOSE         -->
        <!-- ========================================== -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-body-tertiary">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-3">
                        <i class="bi bi-calendar-check text-warning" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold">Month-End Close</h5>
                    <p class="text-secondary small">
                        Lock transactions for the selected accounting period and calculate Retained Earnings to ensure historical ledger integrity.
                    </p>
                    
                    <form asp-action="MonthEndClose" method="post" class="mt-auto">
                        <div class="mb-3">
                            <input type="month" class="form-control form-control-sm rounded-3" name="period" required />
                        </div>
                        <button type="submit" class="btn btn-outline-warning w-100 btn-sm fw-semibold rounded-3" onclick="return confirm('Are you sure you want to close this period? No further edits will be allowed.')">
                            <i class="bi bi-lock me-1"></i> Execute Closing
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 3. SYSTEM MAINTENANCE & UTILITIES          -->
        <!-- ========================================== -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-body-tertiary">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-3">
                        <i class="bi bi-database-gear text-info" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold">System Maintenance</h5>
                    <p class="text-secondary small mb-4">
                        Utilities to verify structural integrity and safeguard financial records across all ledgers.
                    </p>

                    <div class="d-grid gap-2 mt-auto">
                        <a asp-action="RecalculateLedger" class="btn btn-outline-info btn-sm text-start rounded-3" onclick="return confirm('This will rebuild all running ledger balances. Continue?')">
                            <i class="bi bi-arrow-repeat me-2"></i> Recalculate Ledger Balances
                        </a>
                        <a asp-action="BackupDatabase" class="btn btn-outline-secondary btn-sm text-start rounded-3">
                            <i class="bi bi-file-earmark-excel me-2"></i> Export All Data (.xlsx)
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- INSTANT PREVIEW MODAL -->
<div class="modal fade" id="indexPreviewModal" tabindex="-1" aria-labelledby="indexPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="indexPreviewModalLabel">
                        <i class="bi bi-file-earmark-check me-2 text-success"></i> Journal Entries Preview
                    </h5>
                    <small class="text-secondary" id="modalSubHeader">Review entries below before importing.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4" id="modalBodyContainer">
                <!-- Parsed transactions table loaded dynamically via JS -->
            </div>

            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="ConfirmImport" method="post" class="m-0">
                    <button type="submit" class="btn btn-success rounded-3 px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check2-all me-1"></i> Import Data
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('indexPreviewForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const fileInput = document.getElementById('indexExcelFileInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Please select an Excel file first.');
                return;
            }

            const btnPreview = document.getElementById('btnIndexPreview');
            const btnSpinner = document.getElementById('btnIndexSpinner');
            const btnIcon = document.getElementById('btnIndexIcon');

            btnPreview.disabled = true;
            btnSpinner.classList.remove('d-none');
            btnIcon.classList.add('d-none');

            const formData = new FormData();
            formData.append('excelFile', fileInput.files[0]);

            try {
                const response = await fetch('@Url.Action("PreviewJournal", "Tools")', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error(`Server status ${response.status}`);
                }

                const result = await response.json();

                if (!result.success) {
                    alert('Error: ' + result.message);
                    return;
                }

                renderModalBody(result.data);

                const modal = new bootstrap.Modal(document.getElementById('indexPreviewModal'));
                modal.show();

            } catch (err) {
                alert('Failed to process file: ' + err.message);
                console.error(err);
            } finally {
                btnPreview.disabled = false;
                btnSpinner.classList.add('d-none');
                btnIcon.classList.remove('d-none');
            }
        });

        function renderModalBody(data) {
            const container = document.getElementById('modalBodyContainer');
            document.getElementById('modalSubHeader').innerText = `Found ${data.totalTransactionsRead} transactions with ${data.totalLinesRead} line entries.`;

            let html = '';

            if (data.warnings && data.warnings.length > 0) {
                html += `<div class="alert alert-warning rounded-3 mb-4"><ul class="small mb-0 ps-3">`;
                data.warnings.forEach(w => html += `<li>${w}</li>`);
                html += `</ul></div>`;
            }

            data.transactions.forEach(tx => {
                let totalDebit = 0;
                let totalCredit = 0;

                let rowsHtml = '';
                tx.lines.forEach(line => {
                    const debVal = line.debit != null ? line.debit : 0;
                    const credVal = line.credit != null ? line.credit : 0;
                    totalDebit += debVal;
                    totalCredit += credVal;

                    const debText = line.debit != null ? line.debit.toLocaleString('en-US', { minimumFractionDigits: 2 }) : '-';
                    const credText = line.credit != null ? line.credit.toLocaleString('en-US', { minimumFractionDigits: 2 }) : '-';

                    const newBadge = line.isNewAccount ? `<span class="badge bg-info-subtle text-info border border-info-subtle ms-1">New COA</span>` : '';

                    rowsHtml += `
                        <tr>
                            <td class="text-center text-secondary">${line.rowIndex}</td>
                            <td class="text-center fw-semibold">${line.refNumber}</td>
                            <td>${line.accountName} ${newBadge}</td>
                            <td class="text-secondary">${line.description}</td>
                            <td class="text-end fw-semibold text-success">${debText}</td>
                            <td class="text-end fw-semibold text-danger">${credText}</td>
                        </tr>
                    `;
                });

                const formattedDate = new Date(tx.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

                html += `
                    <div class="card border mb-3 rounded-3 shadow-sm">
                        <div class="card-header bg-body d-flex justify-content-between align-items-center py-2 px-3">
                            <span class="badge bg-primary">${tx.journalType} Journal</span>
                            <strong><i class="bi bi-calendar-event me-1"></i> ${formattedDate}</strong>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 align-middle small">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50px;" class="text-center">#</th>
                                        <th style="width: 100px;" class="text-center">Ref</th>
                                        <th>Account Name</th>
                                        <th>Description</th>
                                        <th style="width: 150px;" class="text-end">Debit ($)</th>
                                        <th style="width: 150px;" class="text-end">Credit ($)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${rowsHtml}
                                </tbody>
                                <tfoot class="table-group-divider fw-bold">
                                    <tr>
                                        <td colspan="4" class="text-end">Total Amount:</td>
                                        <td class="text-end text-success">${totalDebit.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                                        <td class="text-end text-danger">${totalCredit.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }
    </script>
}
