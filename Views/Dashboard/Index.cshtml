@model AumoFinance.Models.DashboardViewModel
@{
    var idr = (ViewData["IdrCulture"] as System.Globalization.CultureInfo) 
              ?? new System.Globalization.CultureInfo("id-ID");
    var currentPeriod = ViewData["CurrentPeriodType"]?.ToString() ?? "monthly";
}

@if (!Model.HasSelectedPeriod)
{
    <!-- Prompt Jika Tidak Ada Periode Terpilih -->
    <div class="card glass-card border-0 shadow-sm rounded-4 p-5 text-center my-4">
        <div class="py-4">
            <i class="bi bi-calendar-x text-warning display-4 mb-3 d-block"></i>
            <h4 class="fw-bold mb-2">No Active Period Selected</h4>
            <p class="text-secondary max-w-md mx-auto mb-4">
                Please select an accounting period using the view icon (<i class="bi bi-eye"></i>) on the Periods page to display financial analytics and trends.
            </p>
            <a asp-controller="Period" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-calendar3 me-2"></i>Go to Periods
            </a>
        </div>
    </div>
}
else
{
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="pulse-dot"></span>
                <h4 class="fw-bold mb-0">Financial Overview</h4>
            </div>
            <p class="text-secondary small mb-0">
                Active Period: <span class="fw-semibold text-body">@Model.ActivePeriodName</span>
                @if (Model.ActivePeriodStart.HasValue && Model.ActivePeriodEnd.HasValue)
                {
                    <span class="ms-1 opacity-75">
                        (@Model.ActivePeriodStart.Value.ToString("dd MMM yyyy") – @Model.ActivePeriodEnd.Value.ToString("dd MMM yyyy"))
                    </span>
                }
                · <i class="bi bi-clock-history me-1"></i> Live updated
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Period Toggle -->
            <div class="btn-group btn-group-sm p-1 bg-body-tertiary border border-opacity-10 rounded-pill shadow-sm" role="group">
                <a asp-controller="Dashboard" asp-action="Index" asp-route-period="monthly"
                   class="btn btn-sm rounded-pill px-3 fw-semibold transition-all @(currentPeriod == "monthly" ? "btn-primary shadow-sm" : "btn-link text-body text-decoration-none opacity-75")">
                    Monthly
                </a>
                <a asp-controller="Dashboard" asp-action="Index" asp-route-period="annual"
                   class="btn btn-sm rounded-pill px-3 fw-semibold transition-all @(currentPeriod == "annual" ? "btn-primary shadow-sm" : "btn-link text-body text-decoration-none opacity-75")">
                    Annual
                </a>
            </div>

            <a asp-controller="JournalEntry" asp-action="Create"
               class="btn btn-warning btn-sm fw-semibold shadow-sm d-flex align-items-center gap-2 px-3 rounded-3">
                <i class="bi bi-plus-lg"></i> New Entry
            </a>
            <a asp-controller="Reports" asp-action="IncomeStatement"
               class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 px-3 rounded-3">
                <i class="bi bi-file-earmark-bar-graph"></i> Report
            </a>
        </div>
    </div>

    <!-- Predictive Analytics & Financial Health Section -->
    <div class="row g-3 mb-4">
        <!-- Health Score Widget -->
        <div class="col-12 col-md-6">
            <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Financial Health Index</span>
                    <i class="bi bi-activity text-primary fs-5"></i>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative d-inline-flex align-items-center justify-content-center">
                        <div class="health-circle" style="--score-deg: @(Model.FinancialHealthScore * 3.6)deg;">
                            <span class="fw-bold fs-4 text-body">@Model.FinancialHealthScore</span>
                        </div>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">
                            @if (Model.FinancialHealthScore >= 80) { <span class="text-success">Excellent Condition</span> }
                            else if (Model.FinancialHealthScore >= 60) { <span class="text-info">Stable Operations</span> }
                            else { <span class="text-warning">Attention Required</span> }
                        </h6>
                        <p class="text-secondary fs-8 mb-0">Analyzed from liquidity, debt coverage, and net profit margin.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cash Runway Widget -->
        <div class="col-12 col-md-6">
            <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Cash Runway &amp; Burn Rate</span>
                    <i class="bi bi-speedometer2 text-warning fs-5"></i>
                </div>
                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <h4 class="fw-bold mb-0">
                        @(double.IsNaN(Model.CashRunwayMonths) || double.IsInfinity(Model.CashRunwayMonths) || Model.CashRunwayMonths >= 99 
                            ? "∞" 
                            : Model.CashRunwayMonths.ToString("0.0")) 
                        <span class="fs-6 text-secondary fw-normal">Months Runway</span>
                    </h4>
                    <span class="fs-8 text-secondary">Burn: <strong class="text-body">@Model.MonthlyBurnRate.ToString("C0", idr)</strong>/mo</span>
                </div>
                <div class="progress rounded-pill bg-body-tertiary" style="height: 8px;">
                    <div class="progress-bar @(Model.CashRunwayMonths > 6 ? "bg-success" : (Model.CashRunwayMonths > 3 ? "bg-warning" : "bg-danger")) rounded-pill" 
                         role="progressbar" 
                         style="width: @(Math.Min(Model.CashRunwayMonths * 8.3, 100))%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main KPI Cards Grid -->
    <div class="row g-3 mb-3">
        <!-- Cash -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3 glow-hover-success">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Cash &amp; Equivalents</span>
                    <div class="icon-square bg-success-subtle text-success rounded-3"><i class="bi bi-wallet2"></i></div>
                </div>
                <h4 class="fw-bold mb-1">@Model.TotalCashAndEquivalents.ToString("C0", idr)</h4>
                <div class="small text-secondary fs-8">Liquid Reserves</div>
            </div>
        </div>

        <!-- Revenue -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3 glow-hover-primary">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Revenue</span>
                    <div class="icon-square bg-primary-subtle text-primary rounded-3"><i class="bi bi-graph-up-arrow"></i></div>
                </div>
                <h4 class="fw-bold text-primary mb-1">@Model.RevenueThisPeriod.ToString("C0", idr)</h4>
                <div class="small @(Model.RevenueTrendPercent.HasValue ? (Model.RevenueTrendPercent >= 0 ? "text-success" : "text-danger") : "text-secondary") fs-8 fw-semibold">
                    @if (Model.RevenueTrendPercent.HasValue) {
                        <i class="bi @(Model.RevenueTrendPercent >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                        <span>@(Math.Abs(Model.RevenueTrendPercent.Value).ToString("0.0"))% vs prior</span>
                    } else { <span>—</span> }
                </div>
            </div>
        </div>

        <!-- Expenses -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3 glow-hover-danger">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Expenses</span>
                    <div class="icon-square bg-danger-subtle text-danger rounded-3"><i class="bi bi-arrow-down-left-circle"></i></div>
                </div>
                <h4 class="fw-bold text-danger mb-1">@Model.OperatingExpenses.ToString("C0", idr)</h4>
                <div class="small @(Model.ExpenseTrendPercent.HasValue ? (Model.ExpenseTrendPercent <= 0 ? "text-success" : "text-danger") : "text-secondary") fs-8 fw-semibold">
                    @if (Model.ExpenseTrendPercent.HasValue) {
                        <i class="bi @(Model.ExpenseTrendPercent >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                        <span>@(Math.Abs(Model.ExpenseTrendPercent.Value).ToString("0.0"))% vs prior</span>
                    } else { <span>—</span> }
                </div>
            </div>
        </div>

        <!-- Net Income -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 text-white gradient-neon-blue">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold text-white-50 text-uppercase tracking-wider">Net Income</span>
                    <i class="bi bi-shield-check text-warning fs-5"></i>
                </div>
                <h4 class="fw-bold mb-1">@Model.NetIncome.ToString("C0", idr)</h4>
                <div class="small text-white-50 fs-8 fw-semibold">
                    @if (Model.NetIncomeTrendPercent.HasValue) {
                        <i class="bi @(Model.NetIncomeTrendPercent >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                        <span>@(Math.Abs(Model.NetIncomeTrendPercent.Value).ToString("0.0"))% vs prior</span>
                    } else { <span>—</span> }
                </div>
            </div>
        </div>
    </div>

    <!-- Assets & Liabilities Summary -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider d-block">Total Assets</span>
                        <h5 class="fw-bold mb-0 mt-1">@Model.TotalAssets.ToString("C0", idr)</h5>
                    </div>
                    <div class="icon-square bg-info-subtle text-info rounded-3 fs-5"><i class="bi bi-building"></i></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider d-block">Total Liabilities</span>
                        <h5 class="fw-bold mb-0 mt-1">@Model.TotalLiabilities.ToString("C0", idr)</h5>
                    </div>
                    <div class="icon-square bg-warning-subtle text-warning rounded-3 fs-5"><i class="bi bi-credit-card"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Visual Charts Section -->
    <div class="row g-3 mb-4">
        <!-- Trend Line Chart -->
        <div class="col-12 col-xl-8">
            <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="fw-bold mb-0">Financial Trend</h6>
                        <span class="text-secondary fs-8">Revenue vs Operating Expenses</span>
                    </div>
                    <div class="icon-square bg-primary-subtle text-primary rounded-3"><i class="bi bi-graph-up"></i></div>
                </div>
                <div class="chart-container" style="position: relative; height: 280px;">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Expense Doughnut Chart -->
        <div class="col-12 col-xl-4">
            <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="fw-bold mb-0">Expense Composition</h6>
                        <span class="text-secondary fs-8">Breakdown by Account</span>
                    </div>
                    <div class="icon-square bg-danger-subtle text-danger rounded-3"><i class="bi bi-pie-chart"></i></div>
                </div>
                
                @if (Model.HasExpenseData)
                {
                    <div class="chart-container" style="position: relative; height: 280px;">
                        <canvas id="expenseDoughnut"></canvas>
                    </div>
                }
                else
                {
                    <div class="text-center text-secondary py-4 d-flex flex-column align-items-center justify-content-center h-100">
                        <i class="bi bi-pie-chart fs-1 d-block mb-2 opacity-50"></i>
                        <span>No expense data for this period.</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Data Tables Section -->
    <div class="row g-3">
        <!-- Key Accounts Overview -->
        <div class="col-12 col-xl-6">
            <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold mb-0">Key Accounts Overview</h6>
                    <a asp-controller="ChartOfAccounts" asp-action="Index" class="btn btn-link btn-sm text-decoration-none p-0 fs-8 fw-semibold">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-borderless align-middle mb-0">
                        <thead class="text-secondary fs-8 border-bottom">
                            <tr>
                                <th>CODE</th>
                                <th>ACCOUNT NAME</th>
                                <th class="text-end">BALANCE</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (Model.MainCoaBalances != null && Model.MainCoaBalances.Any())
                            {
                                @foreach (var item in Model.MainCoaBalances)
                                {
                                    <tr class="account-item">
                                        <td class="fw-bold text-secondary">@item.AccountCode</td>
                                        <td class="fw-semibold">@item.AccountName</td>
                                        <td class="text-end fw-bold">@item.Balance.ToString("C0", idr)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-secondary py-3">No account balances found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="col-12 col-xl-6">
            <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold mb-0">Recent Activity</h6>
                    <a asp-controller="JournalEntry" asp-action="Index" class="btn btn-link btn-sm text-decoration-none p-0 fs-8 fw-semibold">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-borderless align-middle mb-0">
                        <thead class="text-secondary fs-8 border-bottom">
                            <tr>
                                <th>DATE</th>
                                <th class="text-end">DEBIT</th>
                                <th class="text-end">CREDIT</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (Model.RecentJournals != null && Model.RecentJournals.Any())
                            {
                                @foreach (var journal in Model.RecentJournals)
                                {
                                    <tr class="account-item">
                                        <td class="text-secondary">@journal.Date.ToString("dd MMM yyyy")</td>
                                        <td class="text-end fw-semibold text-success">@journal.TotalDebit.ToString("C0", idr)</td>
                                        <td class="text-end fw-semibold text-danger">@journal.TotalCredit.ToString("C0", idr)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-secondary py-3">No recent journals recorded.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
