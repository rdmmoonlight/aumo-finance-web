@using AumoFinance.Components.Dashboard
@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard";
    var userId = Guid.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
}

<component type="typeof(AumoFinance.Components.DashboardPage)" render-mode="ServerPrerendered" param-UserId="@userId" />

@section Scripts {
    <!-- Pustaka Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Modul JS Dashboard (dipanggil langsung oleh komponen Blazor lewat JS interop) -->
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
}
