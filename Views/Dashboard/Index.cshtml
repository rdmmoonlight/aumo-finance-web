@model AumoFinance.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["IdrCulture"] = new System.Globalization.CultureInfo("id-ID");
}

<style>
    /* Styling High-Tech & Glassmorphism Elegan (upgrade-fut2) */
    .tracking-wider { letter-spacing: 0.05em; }
    .fs-8 { font-size: 0.75rem; }
    
    .glass-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    [data-bs-theme="light"] .glass-card {
        background: rgba(255, 255, 255, 0.85);
        border-color: rgba(0, 0, 0, 0.06) !important;
    }
    
    /* Glow Hover Accent */
    .glow-hover-success:hover { border-color: rgba(25, 135, 84, 0.4) !important; box-shadow: 0 8px 25px -6px rgba(25, 135, 84, 0.25) !important; transform: translateY(-3px); }
    .glow-hover-primary:hover { border-color: rgba(13, 110, 253, 0.4) !important; box-shadow: 0 8px 25px -6px rgba(13, 110, 253, 0.25) !important; transform: translateY(-3px); }
    .glow-hover-danger:hover { border-color: rgba(220, 53, 69, 0.4) !important; box-shadow: 0 8px 25px -6px rgba(220, 53, 69, 0.25) !important; transform: translateY(-3px); }

    .gradient-neon-blue {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        box-shadow: 0 8px 20px -5px rgba(13, 110, 253, 0.4);
    }

    .icon-square {
        width: 36px; height: 36px;
        display: flex; align-items: center; justify-content: center;
    }

    /* Live Pulse Dot */
    .pulse-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background-color: #198754;
        box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7);
        animation: pulse-animation 1.8s infinite;
    }
    @@keyframes pulse-animation {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(25, 135, 84, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); }
    }

    /* Radial Health Score Circle */
    .health-circle {
        width: 60px; height: 60px;
        border-radius: 50%;
        background: conic-gradient(var(--bs-primary) var(--score-deg), rgba(255,255,255,0.1) 0deg);
        display: flex; align-items: center; justify-content: center;
        position: relative;
    }
    .health-circle::before {
        content: ""; position: absolute;
        width: 48px; height: 48px;
        border-radius: 50%;
        background: var(--bs-body-bg);
    }
    .health-circle span { position: relative; z-index: 1; }

    /* Command Palette Badge */
    .cmd-badge {
        font-size: 0.7rem; padding: 2px 6px; border-radius: 4px;
        background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.2);
    }
    .chart-container { position: relative; height: 280px; }
    .account-item { transition: background-color 0.15s ease; }
    .account-item:hover { background-color: rgba(255,255,255,0.04); }
</style>

<div class="container-fluid px-0">
    <!-- Header -->
    <partial name="_DashboardHeader" model="Model" />

    <!-- Predictive Widgets & KPI Cards -->
    <partial name="_KpiCards" model="Model" />

    <!-- Charts Section -->
    <partial name="_ChartsSection" model="Model" />

    <!-- Recent Tables -->
    <partial name="_RecentDataTables" model="Model" />
</div>

<!-- Command Palette Modal (Ctrl + K) -->
<div class="modal fade" id="commandPaletteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex align-items-center gap-2">
                <i class="bi bi-search text-secondary"></i>
                <input type="text" id="cmdInput" class="form-control border-0 bg-transparent shadow-none" placeholder="Type a command or page name..." autofocus>
                <span class="cmd-badge text-secondary">ESC</span>
            </div>
            <div class="list-group list-group-flush small py-2">
                <a asp-controller="JournalEntry" asp-action="Create" class="list-group-item list-group-item-action bg-transparent border-0 px-3 py-2 text-body d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-plus-circle me-2 text-primary"></i> Create New Journal Entry</span>
                    <span class="cmd-badge text-secondary">Action</span>
                </a>
                <a asp-controller="AiAssistant" asp-action="Index" class="list-group-item list-group-item-action bg-transparent border-0 px-3 py-2 text-body d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-robot me-2 text-warning"></i> Open AI Financial Controller</span>
                    <span class="cmd-badge text-secondary">AI</span>
                </a>
                <a asp-controller="Reports" asp-action="IncomeStatement" class="list-group-item list-group-item-action bg-transparent border-0 px-3 py-2 text-body d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-file-earmark-bar-graph me-2 text-info"></i> View Income Statement</span>
                    <span class="cmd-badge text-secondary">Report</span>
                </a>
                <a asp-controller="ChartOfAccounts" asp-action="Index" class="list-group-item list-group-item-action bg-transparent border-0 px-3 py-2 text-body d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-diagram-3 me-2 text-success"></i> Manage Chart of Accounts</span>
                    <span class="cmd-badge text-secondary">Setup</span>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    // 1. Shortcut Keyboard Ctrl + K / Cmd + K untuk Command Palette
    const cmdModal = new bootstrap.Modal(document.getElementById('commandPaletteModal'));
    document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            cmdModal.show();
        }
    });

    // 2. Setup Chart.js
    const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
    const textColor = isDark ? '#adb5bd' : '#6c757d';
    const gridColor = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';
    Chart.defaults.color = textColor;
    Chart.defaults.borderColor = gridColor;

    const trendCanvas = document.getElementById('trendChart');
    if (trendCanvas) {
        new Chart(trendCanvas.getContext('2d'), {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
                datasets: [
                    {
                        label: 'Revenue',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartRevenue)),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13,110,253,0.12)',
                        fill: true, tension: 0.4, borderWidth: 2.5, pointRadius: 4, pointHoverRadius: 6
                    },
                    {
                        label: 'Expenses',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartExpenses)),
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220,53,69,0.08)',
                        fill: true, tension: 0.4, borderWidth: 2.5, pointRadius: 4, pointHoverRadius: 6
                    }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'top' } },
                scales: {
                    y: { beginAtZero: true, ticks: { callback: v => 'Rp ' + v.toLocaleString('id-ID') } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    const doughnutCanvas = document.getElementById('expenseDoughnut');
    if (doughnutCanvas) {
        new Chart(doughnutCanvas.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategoryLabels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategoryValues)),
                    backgroundColor: ['#0d6efd','#198754','#ffc107','#dc3545','#6f42c1','#0dcaf0','#fd7e14'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '72%',
                plugins: { legend: { position: 'bottom' } }
            }
        });
    }
});
</script>
}
    <!-- 3. Charts Section -->
    <partial name="_ChartsSection" model="Model" />

    <!-- 4. Data Tables Section -->
    <partial name="_RecentDataTables" model="Model" />
</div>

@section Scripts {
