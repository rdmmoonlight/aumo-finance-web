@model List<AumoFinance.Models.Guardian.TrustedDeviceViewModel>

@{
    ViewData["Title"] = "Trusted Devices";
}


<div class="container-fluid">


    <!-- Header -->


    <div class="d-flex justify-content-between align-items-center mb-4">


        <div>


            <h2 class="fw-bold">


                <i class="bi bi-laptop text-warning"></i>


                Trusted Devices


            </h2>



            <p class="text-secondary mb-0">


                Devices allowed to access your Aumo Finance account.


            </p>


        </div>



        <a asp-action="Index"
           class="btn btn-outline-secondary">


            <i class="bi bi-arrow-left me-2"></i>


            Back


        </a>



    </div>





    <!-- Information -->


    <div class="alert alert-info">


        <i class="bi bi-info-circle-fill me-2"></i>


        Trusted devices allow faster login without additional verification.


    </div>





    <!-- Devices -->


    <div class="row g-3">



        @foreach(var device in Model)
        {


            <div class="col-xl-4 col-md-6">



                <div class="card shadow-sm border-0 h-100">



                    <div class="card-body">



                        <div class="d-flex align-items-center mb-3">


                            <div class="fs-2 me-3">


                                <i class="bi bi-pc-display-horizontal"></i>


                            </div>



                            <div>


                                <h5 class="mb-0">


                                    @device.Name


                                </h5>


                                <small class="text-muted">


                                    @device.Browser


                                </small>


                            </div>



                        </div>





                        <hr />



                        <div class="small text-secondary mb-3">


                            Added


                        </div>



                        <div class="fw-semibold mb-3">


                            @device.AddedOn
                                .ToString("dd MMMM yyyy")


                        </div>




                        <button class="btn btn-outline-danger w-100">


                            <i class="bi bi-trash me-2"></i>


                            Remove Device


                        </button>



                    </div>


                </div>



            </div>


        }



    </div>



</div>
