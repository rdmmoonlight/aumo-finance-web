@model List<AumoFinance.Models.Guardian.ActiveSessionViewModel>

@{
    ViewData["Title"] = "Active Sessions";
}

<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-pc-display text-warning"></i>

                Active Sessions

            </h2>

            <p class="text-secondary mb-0">

                Manage devices currently signed into your account.

            </p>

        </div>


        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>

            Back

        </a>

    </div>



    <!-- Warning -->

    <div class="alert alert-warning">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        Review your active sessions regularly. 
        Terminate sessions you do not recognize.

    </div>



    <!-- Sessions Table -->

    <div class="card shadow-sm border-0">


        <div class="card-header bg-dark text-white">

            <i class="bi bi-shield-lock me-2"></i>

            Logged In Devices

        </div>



        <div class="card-body p-0">


            <div class="table-responsive">


                <table class="table table-hover align-middle mb-0">


                    <thead>

                        <tr>

                            <th>
                                Device
                            </th>

                            <th>
                                Browser
                            </th>

                            <th>
                                IP Address
                            </th>

                            <th>
                                Country
                            </th>

                            <th>
                                Last Activity
                            </th>

                            <th class="text-center">
                                Status
                            </th>

                            <th></th>

                        </tr>

                    </thead>



                    <tbody>


                    @foreach(var session in Model)
                    {

                        <tr>


                            <td>

                                <i class="bi bi-display me-2"></i>

                                @session.DeviceName


                            </td>



                            <td>

                                @session.Browser

                            </td>



                            <td>

                                @session.IpAddress

                            </td>



                            <td>

                                @session.Country

                            </td>



                            <td>

                                @session.LastActivity
                                    .ToString("dd MMM yyyy HH:mm")

                            </td>



                            <td class="text-center">


                                @if(session.IsCurrent)
                                {

                                    <span class="badge bg-success">

                                        Current

                                    </span>

                                }
                                else
                                {

                                    <span class="badge bg-secondary">

                                        Active

                                    </span>

                                }


                            </td>



                            <td class="text-end">


                                @if(!session.IsCurrent)
                                {

                                    <button class="btn btn-sm btn-outline-danger">

                                        <i class="bi bi-x-circle me-1"></i>

                                        Terminate

                                    </button>

                                }


                            </td>


                        </tr>

                    }


                    </tbody>


                </table>


            </div>


        </div>


    </div>


</div>
