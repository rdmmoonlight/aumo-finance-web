@model AumoFinance.Models.GuardianViewModel
@{
    ViewData["Title"] = "Guardian";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-shield-check text-warning me-2"></i>Guardian
            </h4>
            <small class="text-secondary">Security monitoring and active sessions</small>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Active Sessions -->
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-header border-secondary">
            <strong><i class="bi bi-laptop me-2"></i>Active Sessions</strong>
        </div>
        <div class="card-body p-0">
            @if (Model.Sessions.Count == 0)
            {
                <div class="p-3 text-secondary">No active sessions found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Device</th>
                                <th>Browser</th>
                                <th>IP Address</th>
                                <th>Last Activity</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var session in Model.Sessions)
                        {
                            <tr>
                                <td>
                                    @session.DeviceName
                                    @if (session.IsCurrent)
                                    {
                                        <span class="badge bg-success ms-2">Current</span>
                                    }
                                </td>
                                <td>@session.Browser</td>
                                <td>@session.IpAddress</td>
                                <td>@session.LastActivityAt</td>
                                <td class="text-end">
                                    <form asp-action="RevokeSession" method="post">
                                        <input type="hidden" name="id" value="@session.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-box-arrow-right"></i> Sign Out
                                        </button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Login Activity -->
    <div class="card bg-dark border-secondary">
        <div class="card-header border-secondary">
            <strong><i class="bi bi-clock-history me-2"></i>Login History</strong>
        </div>
        <div class="card-body p-0">
            @if (Model.Activities.Count == 0)
            {
                <div class="p-3 text-secondary">No login activity found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Activity</th>
                                <th>Device</th>
                                <th>IP Address</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var activity in Model.Activities)
                        {
                            <tr>
                                <td>@activity.ActivityType</td>
                                <td>@activity.Device</td>
                                <td>@activity.IpAddress</td>
                                <td>
                                    @if (activity.IsSuccess)
                                    {
                                        <span class="badge bg-success">Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Failed</span>
                                    }
                                </td>
                                <td>@activity.CreatedAt</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
