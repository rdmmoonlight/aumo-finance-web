@model AumoFinance.Models.GuardianViewModel
@{
    ViewData["Title"] = "Guardian";
}

<div class="container-fluid">

    <!-- Header & Overall Health Badge -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-shield-check text-warning me-2"></i>Guardian
            </h4>
            <small class="text-secondary">Security health monitoring, active sessions, and protection controls</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success fs-6">
                <i class="bi bi-heart-pulse-fill me-1"></i> Account Healthy
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- SUB-TABS NAVIGATION (Nav Pills) -->
    <ul class="nav nav-pills mb-4 border-bottom border-secondary pb-3" id="guardianTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold text-white" id="health-tab" data-bs-toggle="pill" data-bs-target="#health-content" type="button" role="tab">
                <i class="bi bi-activity text-danger me-2"></i>Security Health
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-white fw-bold" id="sessions-tab" data-bs-toggle="pill" data-bs-target="#sessions-content" type="button" role="tab">
                <i class="bi bi-laptop text-info me-2"></i>Active Sessions
                <span class="badge bg-secondary ms-1">@(Model.Sessions?.Count ?? 0)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-white fw-bold" id="protection-tab" data-bs-toggle="pill" data-bs-target="#protection-content" type="button" role="tab">
                <i class="bi bi-sliders text-warning me-2"></i>Protection & Logs
            </button>
        </li>
    </ul>

    <!-- TAB CONTENTS -->
    <div class="tab-content" id="guardianTabsContent">

        <!-- ==================== TAB 1: SECURITY HEALTH ==================== -->
        <div class="tab-pane fade show active" id="health-content" role="tabpanel">
            <div class="card bg-dark border-secondary">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-heart-pulse me-2"></i>Security & Account Health Checkup</strong>
                    <small class="text-secondary">Automated Analysis</small>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush bg-transparent">
                        
                        <!-- Health Point 1: Active Sessions -->
                        <div class="list-group-item bg-transparent text-white border-secondary p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold"><i class="bi bi-laptop text-info me-2"></i>Active Device Sessions</div>
                                <small class="text-secondary">Monitors how many devices are currently signed in.</small>
                            </div>
                            <div>
                                <span class="badge bg-success">@(Model.Sessions?.Count ?? 0) Active Session(s)</span>
                            </div>
                        </div>

                        <!-- Health Point 2: Transaction PIN -->
                        <div class="list-group-item bg-transparent text-white border-secondary p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold"><i class="bi bi-key text-warning me-2"></i>Transaction PIN</div>
                                <small class="text-secondary">Secondary protection for sensitive financial actions.</small>
                            </div>
                            <div>
                                <span class="badge bg-warning text-dark me-2">Not Set</span>
                                <a href="#" class="btn btn-sm btn-outline-warning py-0">Set Up PIN</a>
                            </div>
                        </div>

                        <!-- Health Point 3: Password Age Monitor -->
                        <div class="list-group-item bg-transparent text-white border-secondary p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold"><i class="bi bi-shield-lock text-primary me-2"></i>Password Age</div>
                                <small class="text-secondary">Tracks when your password was last changed (Recommended: &lt; 90 days).</small>
                            </div>
                            <div>
                                <span class="badge bg-success me-2">Updated Recently</span>
                                <a href="#" class="btn btn-sm btn-outline-light py-0">Change</a>
                            </div>
                        </div>

                        <!-- Health Point 4: Failed Login Attempts -->
                        <div class="list-group-item bg-transparent text-white border-secondary p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold"><i class="bi bi-shield-exclamation text-danger me-2"></i>Failed Login Attempts</div>
                                <small class="text-secondary">Unrecognized access attempts detected in the last 30 days.</small>
                            </div>
                            <div>
                                <span class="badge bg-success">0 Threat(s) Found</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== TAB 2: ACTIVE SESSIONS (DIBATASI MAKSIMAL 5) ==================== -->
        <div class="tab-pane fade" id="sessions-content" role="tabpanel">
            <div class="card bg-dark border-secondary">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-laptop me-2"></i>Active Sessions (Max 5)</strong>
                    
                    <!-- Emergency Kill Switch -->
                    <form asp-action="RevokeAllSessions" method="post" onsubmit="return confirm('Emergency Lockout: Are you sure you want to sign out of ALL devices? You will be required to log in again.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-exclamation-octagon me-1"></i> Revoke All Sessions
                        </button>
                        @Html.AntiForgeryToken()
                    </form>
                </div>
                <div class="card-body p-0">
                    @if (Model.Sessions == null || Model.Sessions.Count == 0)
                    {
                        <div class="p-3 text-secondary">No active sessions found.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Device</th>
                                        <th>Browser</th>
                                        <th>IP Address</th>
                                        <th>Last Activity</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var session in Model.Sessions.Take(5))
                                {
                                    <tr>
                                        <td>
                                            @session.DeviceName
                                            @if (session.IsCurrent)
                                            {
                                                <span class="badge bg-success ms-2">Current</span>
                                            }
                                        </td>
                                        <td>@session.Browser</td>
                                        <td class="font-monospace">@session.IpAddress</td>
                                        <td>@session.LastActivityAt</td>
                                        <td class="text-end">
                                            @if (!session.IsCurrent)
                                            {
                                                <form asp-action="RevokeSession" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@session.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-box-arrow-right"></i> Sign Out
                                                    </button>
                                                    @Html.AntiForgeryToken()
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-secondary small">Active now</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ==================== TAB 3: PROTECTION & LOGS ==================== -->
        <div class="tab-pane fade" id="protection-content" role="tabpanel">
            
            <!-- Quick Settings Card -->
            <div class="card bg-dark border-secondary mb-4">
                <div class="card-header border-secondary">
                    <strong><i class="bi bi-sliders me-2"></i>Protection Settings</strong>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <!-- Privacy Mode -->
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">Privacy Mode (Mask Balances)</div>
                                    <small class="text-secondary">Conceal monetary values across the app ($ •••••)</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="privacyToggle">
                                </div>
                            </div>
                        </div>
                        
                        <!-- Auto Lock -->
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">Auto-Lock Timeout</div>
                                    <small class="text-secondary">Automatically lock screen when idle</small>
                                </div>
                                <select class="form-select form-select-sm bg-dark text-white border-secondary w-auto">
                                    <option value="0">Disabled</option>
                                    <option value="5" selected>5 Minutes</option>
                                    <option value="15">15 Minutes</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Login Activity Log (Max 5) -->
            <div class="card bg-dark border-secondary">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-clock-history me-2"></i>Recent Login History (Max 5)</strong>
                    <a asp-action="ExportAuditLog" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-download me-1"></i> Export Log (CSV)
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.Activities == null || Model.Activities.Count == 0)
                    {
                        <div class="p-3 text-secondary">No login activity found.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Activity</th>
                                        <th>Device</th>
                                        <th>IP Address</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var activity in Model.Activities.Take(5))
                                {
                                    <tr>
                                        <td>@activity.ActivityType</td>
                                        <td>@activity.Device</td>
                                        <td class="font-monospace">@activity.IpAddress</td>
                                        <td>
                                            @if (activity.IsSuccess)
                                            {
                                                <span class="badge bg-success">Success</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Failed</span>
                                            }
                                        </td>
                                        <td>@activity.CreatedAt</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>

</div>
