@using System.Globalization
@model List<MobilePendingListItemViewModel>
@{
    ViewData["Title"] = "Mobile Verification";
    var cultureId = new CultureInfo("id-ID");
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-phone me-2 text-warning"></i> Mobile Verification
            </h2>
            <p class="text-secondary mb-0">
                Input dari Android tersimpan terpisah di tabel mobile. Verifikasi di sini
                untuk menggabungkannya ke pembukuan utama (JournalEntries).
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Date</th>
                            <th>Mode</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th>Note</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-secondary py-4">
                                    Tidak ada input mobile yang menunggu verifikasi.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">@item.EntryDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Mode == "Manual")
                                    {
                                        <span class="badge text-bg-info">Manual (@item.LineCount baris)</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Simple</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Mode == "Simple")
                                    {
                                        if (item.Type == "Income")
                                        {
                                            <span class="badge text-bg-success">Income</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-danger">Expense</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="text-end">@item.Amount.ToString("C0", cultureId)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Note) ? "-" : item.Note)</td>
                                <td><span class="badge text-bg-warning">Pending</span></td>
                                <td class="text-end pe-4">
                                    @if (item.Mode == "Manual")
                                    {
                                        <a asp-action="ClassifyManual" asp-route-id="@item.Id" class="btn btn-sm btn-warning fw-semibold">
                                            <i class="bi bi-check2-square me-1"></i> Review
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Classify" asp-route-id="@item.Id" class="btn btn-sm btn-warning fw-semibold">
                                            <i class="bi bi-tags me-1"></i> Classify
                                        </a>
                                    }
                                    <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Tolak transaksi mobile ini?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
