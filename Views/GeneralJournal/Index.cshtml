@model List<AurumFinance.Models.JournalEntry>
@{
    ViewData["Title"] = "General Journal";
}

<div class="container-fluid">
   <!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-journal-bookmark me-2 text-warning"></i> General Journal</h2>
        <p class="text-muted mb-0">Chronological record of financial transactions for Aurum Finance.</p>
    </div>
    <div>
        <a asp-controller="JournalEntry" asp-action="Create" class="btn btn-warning fw-semibold">
            <i class="bi bi-plus-lg me-1"></i> Add Entry
        </a>
    </div>
</div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success bg-dark text-success" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- General Journal Table -->
    <div class="card bg-dark border-secondary text-white shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-active border-bottom border-secondary">
                        <tr>
                            <th>Date</th>
                            <th>Account</th>
                            <th>Description</th>
                            <th class="text-center">Ref.</th>
                            <th class="text-end">Debit</th>
                            <th class="text-end">Credit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var entry in Model)
                            {
                                var orderedLines = entry.Lines.OrderBy(l => l.LineOrder).ToList();
                                var debitLines = orderedLines.Where(l => l.Debit > 0).ToList();
                                var creditLines = orderedLines.Where(l => l.Credit > 0).ToList();

                                @foreach (var line in debitLines)
                                {
                                    <tr>
                                        <td class="text-nowrap">@entry.EntryDate.ToString("dd-MM-yyyy")</td>
                                        <td class="fw-bold"><code class="text-warning me-1">@line.Account?.ReferenceNumber</code> @line.Account?.AccountName</td>
                                        <td class="text-muted small">@(line.LineDescription ?? entry.Memo)</td>
                                        <td class="text-center"><code>@entry.ReferenceNumber</code></td>
                                        <td class="text-end text-success fw-semibold">@line.Debit.ToString("N2")</td>
                                        <td class="text-end text-muted">-</td>
                                    </tr>
                                }
                                @foreach (var line in creditLines)
                                {
                                    <tr>
                                        <td class="text-nowrap">@entry.EntryDate.ToString("dd-MM-yyyy")</td>
                                        <td class="fw-bold ps-4"><code class="text-warning me-1">@line.Account?.ReferenceNumber</code> @line.Account?.AccountName</td>
                                        <td class="text-muted small">@(line.LineDescription ?? entry.Memo)</td>
                                        <td class="text-center"><code>@entry.ReferenceNumber</code></td>
                                        <td class="text-end text-muted">-</td>
                                        <td class="text-end text-danger fw-semibold">@line.Credit.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No journal entries recorded yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
