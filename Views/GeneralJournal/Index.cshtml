@model List<AumoFinance.Models.JournalEntry>
@{
    ViewData["Title"] = "General Journal";
}

<div class="container-fluid py-4 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-journal-bookmark me-2 text-warning"></i> General Journal
            </h2>
            <p class="text-secondary mb-0">Chronological record of financial transactions for Aumo Finance.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="JournalEntry" asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Entry
            </a>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary fw-semibold shadow-sm dropdown-toggle" id="btnEditEntry" data-bs-toggle="dropdown" aria-expanded="false" @(Model.Any() ? "" : "disabled")>
                    <i class="bi bi-pencil me-1"></i> Edit
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="btnEditEntry" style="max-height: 320px; overflow-y: auto; min-width: 280px;">
                    <li><h6 class="dropdown-header">Select an entry to edit</h6></li>
                    @foreach (var entry in Model.OrderByDescending(e => e.EntryDate).ThenByDescending(e => e.Id))
                    {
                        <li>
                            <a class="dropdown-item d-flex justify-content-between align-items-center" asp-controller="JournalEntry" asp-action="Edit" asp-route-id="@entry.Id">
                                <span><code class="me-2">@entry.ReferenceNumber</code>@entry.EntryDate.ToString("dd-MM-yyyy")</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm py-2" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- General Journal Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 text-center" style="width: 5%;">Date</th>
                            <th style="width: 27%;">Account</th>
                            <th style="width: 27%;">Description</th>
                            <th class="text-center" style="width: 8%;">Ref.</th>
                            <th class="text-end" style="width: 16%;">Debit</th>
                            <th class="text-end pe-4" style="width: 16%;">Credit</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model.Any())
                        {
                            string lastDate = "";
                            int dateGroupIndex = 0;

                            for (int e = 0; e < Model.Count; e++)
                            {
                                var entry = Model[e];
                                var allLines = entry.Lines.OrderBy(l => l.LineOrder).ToList();

                                var currentDateStr = entry.EntryDate.ToString("dd-MM-yyyy");
                                var showDate = (currentDateStr != lastDate);
                                if (showDate) { lastDate = currentDateStr; dateGroupIndex++; }

                                var entryShade = (dateGroupIndex % 2 == 0) ? "" : "bg-body-secondary bg-opacity-25";

                                for (int i = 0; i < allLines.Count; i++)
                                {
                                    var line = allLines[i];
                                    var isFirstRow = (i == 0);
                                    var isDebit = line.Debit > 0;

                                    <tr class="@entryShade">
                                        <td class="ps-4 text-center align-top">
                                            @if (isFirstRow && showDate)
                                            {
                                                <span class="badge rounded-pill bg-body-secondary text-body-emphasis fw-bold small px-2 py-1">@entry.EntryDate.Day</span>
                                            }
                                        </td>
                                        <td class="align-top @(isDebit ? "fw-semibold text-body" : "ps-4 text-body")">
                                            @line.Account?.AccountName
                                        </td>
                                        <td class="text-secondary small align-top">
                                            @line.LineDescription
                                        </td>
                                        <td class="text-center align-top">
                                            <code>@line.Account?.ReferenceNumber</code>
                                        </td>
                                        <td class="text-end align-top @(isDebit ? "text-success fw-semibold" : "text-secondary")">
                                            @(line.Debit > 0 ? line.Debit.ToString("N0") : null)
                                        </td>
                                        <td class="text-end pe-4 align-top @(!isDebit ? "text-danger fw-semibold" : "text-secondary")">
                                            @(line.Credit > 0 ? line.Credit.ToString("N0") : null)
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-secondary">
                                    <i class="bi bi-journal-x mb-3 d-block" style="font-size: 2.5rem;"></i>
                                    No journal entries recorded yet in this period.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
