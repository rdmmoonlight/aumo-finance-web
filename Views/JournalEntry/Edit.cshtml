@model AumoFinance.Models.JournalEntryEditViewModel
@{
    ViewData["Title"] = $"Edit Journal Entry {Model.ReferenceNumber}";
}

<div class="container-fluid py-4 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-pencil-square me-2 text-warning"></i> Edit Journal Entry
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-2">@Model.ReferenceNumber</span>
            </h2>
            <p class="text-secondary mb-0">Update this double-entry transaction for Aumo Finance.</p>
        </div>
        <div>
            <a asp-controller="GeneralJournal" asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Journal
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm py-2">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <ul class="mb-0 small fw-semibold">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form id="journalForm" method="post" asp-controller="JournalEntry" asp-action="Edit">
        <input type="hidden" asp-for="Id" />

        <!-- Transaction Header Metadata -->
        <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Reference No.</label>
                        <input type="text" class="form-control bg-body-secondary fw-semibold" value="@Model.ReferenceNumber" readonly tabindex="-1" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Journal Type</label>
                        <select asp-for="JournalType" class="form-select fw-semibold" id="journalType">
                            <option value="General">General Journal (GJ)</option>
                            <option value="Adjusting">Adjusting Entry (AJE)</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Transaction Date</label>
                        <input asp-for="EntryDate" type="date" lang="id-ID" class="form-control" required />
                    </div>
                </div>
            </div>
        </div>

        <!-- Journal Lines Table -->
        <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
            <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3 px-4">
                <h5 class="mb-0 fw-bold text-body-emphasis"><i class="bi bi-list-task me-2 text-warning"></i> Journal Lines</h5>
                <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" id="btnAddRow">
                    <i class="bi bi-plus-lg me-1"></i> Add Line
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="journalTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 10%;" class="ps-4">Ref No.</th>
                                <th style="width: 25%;">Account Name</th>
                                <th style="width: 25%;">Description</th>
                                <th style="width: 15%;" class="text-end">Debit</th>
                                <th style="width: 15%;" class="text-end">Credit</th>
                                <th style="width: 10%;" class="text-center pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody id="journalBody" class="border-top-0">
                            @for (int i = 0; i < Model.Lines.Count; i++)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <input type="text" class="form-control text-center bg-body-secondary ref-display" readonly tabindex="-1" placeholder="---" />
                                    </td>
                                    <td>
                                        <select name="Lines[@i].AccountId" class="form-select account-select" required>
                                            <option value="" selected disabled>Select Account...</option>
                                            @foreach (var acc in Model.AvailableAccounts)
                                            {
                                                <option value="@acc.Id" data-ref="@acc.ReferenceNumber" selected="@(acc.Id == Model.Lines[i].AccountId)">
                                                    @acc.AccountName
                                                </option>
                                            }
                                        </select>
                                    </td>
                                    <td class="position-relative">
                                        <input name="Lines[@i].LineDescription" type="text" value="@Model.Lines[i].LineDescription" class="form-control line-description" placeholder="Note..." autocomplete="off" />
                                    </td>
                                    <td>
                                        <input name="Lines[@i].Debit" type="number" step="0.01" min="0" value="@((Model.Lines[i].Debit ?? 0) == 0 ? "" : Model.Lines[i].Debit.ToString())" class="form-control text-end input-debit" placeholder="0" />
                                    </td>
                                    <td>
                                        <input name="Lines[@i].Credit" type="number" step="0.01" min="0" value="@((Model.Lines[i].Credit ?? 0) == 0 ? "" : Model.Lines[i].Credit.ToString())" class="form-control text-end input-credit" placeholder="0" />
                                    </td>
                                    <td class="text-center pe-4">
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light border-top fw-bold">
                            <tr>
                                <td colspan="3" class="text-end py-3">Total Balance:</td>
                                <td class="text-end text-success fs-6 py-3" id="totalDebit">0.00</td>
                                <td class="text-end text-danger fs-6 py-3" id="totalCredit">0.00</td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end pb-3 border-bottom-0">Status:</td>
                                <td colspan="2" class="text-center pb-3 border-bottom-0" id="balanceStatus">
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Awaiting Input</span>
                                </td>
                                <td class="border-bottom-0"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Row template for JS-added lines -->
        <template id="rowTemplate">
            <tr>
                <td class="ps-4">
                    <input type="text" class="form-control text-center bg-body-secondary ref-display" readonly tabindex="-1" placeholder="---" />
                </td>
                <td>
                    <select name="Lines[__INDEX__].AccountId" class="form-select account-select" required>
                        <option value="" selected disabled>Select Account...</option>
                        @foreach (var acc in Model.AvailableAccounts)
                        {
                            <option value="@acc.Id" data-ref="@acc.ReferenceNumber">@acc.AccountName</option>
                        }
                    </select>
                </td>
                <td class="position-relative">
                    <input name="Lines[__INDEX__].LineDescription" type="text" class="form-control line-description" placeholder="Note..." autocomplete="off" />
                </td>
                <td>
                    <input name="Lines[__INDEX__].Debit" type="number" step="0.01" min="0" class="form-control text-end input-debit" placeholder="0" />
                </td>
                <td>
                    <input name="Lines[__INDEX__].Credit" type="number" step="0.01" min="0" class="form-control text-end input-credit" placeholder="0" />
                </td>
                <td class="text-center pe-4">
                    <button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="bi bi-trash"></i></button>
                </td>
            </tr>
        </template>

        <!-- Form Action Controls -->
        <div class="d-flex justify-content-end gap-2">
            <a asp-controller="GeneralJournal" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm" id="btnSubmit">
                <i class="bi bi-save me-1"></i> Save Changes
            </button>
        </div>
    </form>

    <!-- Dropdown saran deskripsi (posisi diatur lewat JS, mengikuti input yang sedang aktif) -->
    <div id="descSuggestions" class="list-group shadow-sm" style="display:none; position:absolute; z-index:1060; max-height:220px; overflow-y:auto;"></div>
</div>

<!-- Interactive Dynamic Logic (sama seperti Create.cshtml) -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const journalBody = document.getElementById("journalBody");
        const btnAddRow = document.getElementById("btnAddRow");
        const totalDebitEl = document.getElementById("totalDebit");
        const totalCreditEl = document.getElementById("totalCredit");
        const balanceStatusEl = document.getElementById("balanceStatus");
        const btnSubmit = document.getElementById("btnSubmit");
        const rowTemplate = document.getElementById("rowTemplate").innerHTML;

        // Auto-fill Ref No Logic
        function updateRefNumber(selectElement) {
            const selectedOption = selectElement.options[selectElement.selectedIndex];
            const refNumber = selectedOption.getAttribute("data-ref");
            const row = selectElement.closest("tr");
            const refInput = row.querySelector(".ref-display");

            if (refInput) {
                refInput.value = refNumber ? refNumber : "";
            }
        }

        journalBody.addEventListener("change", function (e) {
            if (e.target.classList.contains("account-select")) {
                updateRefNumber(e.target);
            }
        });

        // Trigger on load supaya baris yang sudah terisi (data lama) langsung
        // menampilkan Ref No akunnya, bukan hanya baris baru.
        document.querySelectorAll(".account-select").forEach(select => {
            if (select.value) {
                updateRefNumber(select);
            }
        });

        function nextIndex() {
            return journalBody.querySelectorAll("tr").length;
        }

        btnAddRow.addEventListener("click", function () {
            const html = rowTemplate.replaceAll("__INDEX__", nextIndex());
            journalBody.insertAdjacentHTML("beforeend", html);
        });

        journalBody.addEventListener("click", function (e) {
            const removeBtn = e.target.closest(".btn-remove");
            if (removeBtn) {
                if (journalBody.querySelectorAll("tr").length > 2) {
                    removeBtn.closest("tr").remove();
                    calculateTotals();
                } else {
                    alert("A journal entry must have at least two line items (Debit & Credit).");
                }
            }
        });

        function calculateTotals() {
            let totalDebit = 0;
            let totalCredit = 0;

            document.querySelectorAll(".input-debit").forEach(input => {
                totalDebit += parseFloat(input.value) || 0;
            });

            document.querySelectorAll(".input-credit").forEach(input => {
                totalCredit += parseFloat(input.value) || 0;
            });

            totalDebitEl.textContent = totalDebit.toLocaleString('en-US', { minimumFractionDigits: 2 });
            totalCreditEl.textContent = totalCredit.toLocaleString('en-US', { minimumFractionDigits: 2 });

            const difference = Math.abs(totalDebit - totalCredit);

            if (totalDebit > 0 && totalCredit > 0 && difference < 0.001) {
                balanceStatusEl.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2"><i class="bi bi-check-circle me-1"></i> Balanced</span>`;
                btnSubmit.disabled = false;
            } else {
                const diffFormatted = difference.toLocaleString('en-US', { minimumFractionDigits: 2 });
                balanceStatusEl.innerHTML = `<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2"><i class="bi bi-exclamation-triangle me-1"></i> Unbalanced (${diffFormatted})</span>`;
                btnSubmit.disabled = true;
            }
        }

        journalBody.addEventListener("input", function (e) {
            if (e.target.classList.contains("input-debit") || e.target.classList.contains("input-credit")) {
                calculateTotals();
            }
        });

        calculateTotals();

        // ==== Autocomplete Description (sama seperti Create.cshtml) ====
        const descSuggestions = document.getElementById("descSuggestions");
        let activeDescInput = null;
        let searchTimer = null;

        function hideSuggestions() {
            descSuggestions.style.display = "none";
            descSuggestions.innerHTML = "";
            activeDescInput = null;
        }

        function showSuggestions(input, items) {
            if (!items.length) {
                hideSuggestions();
                return;
            }

            descSuggestions.innerHTML = items.map(text =>
                `<button type="button" class="list-group-item list-group-item-action small py-1 desc-suggestion-item">${text.replace(/</g, "&lt;")}</button>`
            ).join("");

            const rect = input.getBoundingClientRect();
            descSuggestions.style.left = (rect.left + window.scrollX) + "px";
            descSuggestions.style.top = (rect.bottom + window.scrollY) + "px";
            descSuggestions.style.width = rect.width + "px";
            descSuggestions.style.display = "block";
        }

        journalBody.addEventListener("input", function (e) {
            if (!e.target.classList.contains("line-description")) return;

            activeDescInput = e.target;
            const query = e.target.value.trim();

            clearTimeout(searchTimer);

            if (query.length < 2) {
                hideSuggestions();
                return;
            }

            searchTimer = setTimeout(async function () {
                try {
                    const res = await fetch(`/JournalEntry/SearchDescriptions?q=${encodeURIComponent(query)}`);
                    if (!res.ok) return;
                    const data = await res.json();
                    if (activeDescInput === e.target) {
                        showSuggestions(e.target, data);
                    }
                } catch (err) {
                    // Diamkan saja kalau gagal fetch, autocomplete bukan fitur wajib
                }
            }, 250);
        });

        descSuggestions.addEventListener("mousedown", function (e) {
            const item = e.target.closest(".desc-suggestion-item");
            if (!item || !activeDescInput) return;
            e.preventDefault();
            activeDescInput.value = item.textContent;
            hideSuggestions();
        });

        document.addEventListener("click", function (e) {
            if (e.target.closest("#descSuggestions") || e.target.classList.contains("line-description")) return;
            hideSuggestions();
        });

        journalBody.addEventListener("click", function (e) {
            if (e.target.closest(".btn-remove")) {
                hideSuggestions();
            }
        });
    });
</script>
