@model AumoFinance.Models.StatementOfFinancialPositionViewModel
@{
    ViewData["Title"] = "Post-Closing Trial Balance";
}

<div class="container-fluid">
    @if (ViewBag.NoPeriodSelected == true)
    {
        <div class="text-center py-5 my-4">
            <i class="bi bi-eye-slash text-secondary mb-3 d-block" style="font-size: 2.5rem;"></i>
            <h5 class="fw-bold text-body-emphasis mb-2">No Period Selected</h5>
            <p class="text-secondary mb-3">This report follows whichever period you're viewing.</p>
            <a asp-controller="Periods" asp-action="Index" class="btn btn-primary btn-sm fw-semibold shadow-sm px-4">
                <i class="bi bi-calendar3 me-1"></i> Go to Periods
            </a>
        </div>
    }
    else
    {
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-shield-check me-2 text-info"></i> Post-Closing Trial Balance</h2>
            <p class="text-muted mb-0">Displays permanent accounts (Assets, Liabilities, Equity) after closing entries — all nominal accounts have zero balances.</p>
        </div>
        <div>
            <a asp-controller="Reports" asp-action="CashFlowStatement" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right-circle me-1"></i> Cash Flow Statement
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card bg-dark border-secondary text-white shadow-sm h-100">
                <div class="card-header bg-transparent border-secondary fw-bold text-uppercase small text-warning">Assets</div>
                <div class="card-body">
                    <table class="table table-dark table-borderless align-middle mb-0">
                        <tbody>
                            @foreach (var l in Model.Assets)
                            {
                                <tr><td><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">@l.Amount.ToString("N2")</td></tr>
                            }
                            <tr class="border-top border-secondary fw-bold fs-5">
                                <td class="pt-2">Total Assets</td>
                                <td class="text-end pt-2">@Model.TotalAssets.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card bg-dark border-secondary text-white shadow-sm h-100">
                <div class="card-header bg-transparent border-secondary fw-bold text-uppercase small text-warning">Liabilities</div>
                <div class="card-body">
                    <table class="table table-dark table-borderless align-middle mb-0">
                        <tbody>
                            @foreach (var l in Model.Liabilities)
                            {
                                <tr><td><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">@l.Amount.ToString("N2")</td></tr>
                            }
                            <tr class="border-top border-secondary fw-semibold">
                                <td>Total Liabilities</td>
                                <td class="text-end">@Model.TotalLiabilities.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card bg-dark border-secondary text-white shadow-sm h-100 mt-4">
                <div class="card-header bg-transparent border-secondary fw-bold text-uppercase small text-warning">Equity</div>
                <div class="card-body">
                    <table class="table table-dark table-borderless align-middle mb-0">
                        <tbody>
                            @foreach (var l in Model.EquityExcludingRetainedEarnings)
                            {
                                <tr><td><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">@l.Amount.ToString("N2")</td></tr>
                            }
                            <tr><td>Retained Earnings (post-closing)</td><td class="text-end">@Model.RetainedEarningsEnding.ToString("N2")</td></tr>
                            <tr class="border-top border-secondary fw-semibold">
                                <td>Total Equity</td>
                                <td class="text-end">@Model.TotalEquity.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card bg-dark border-secondary text-white shadow-sm mt-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-5">Total Liabilities &amp; Equity</span>
                    <span class="fw-bold fs-5">@Model.TotalLiabilitiesAndEquity.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="alert @(Model.IsBalanced ? "alert-success" : "alert-danger") bg-opacity-10 mt-4 mb-0 py-2 small">
        @if (Model.IsBalanced)
        {
            <i class="bi bi-check-circle-fill me-1"></i> @:Total Assets = Total Liabilities + Equity. Post-closing trial balance is in balance; books are ready for the next period.
        }
        else
        {
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @:Post-closing trial balance is out of balance. Please check your closing journal entries.
        }
    </div>
    }
</div>
