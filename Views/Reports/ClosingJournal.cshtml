@model AumoFinance.Models.ClosingJournalViewModel
@{
    ViewData["Title"] = "Closing Journal";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-lock-fill me-2 text-warning"></i> Closing Journal</h2>
            <p class="text-muted mb-0">Jurnal penutup dihitung otomatis dari saldo akun nominal saat ini — belum diposting ke General Journal.</p>
        </div>
        <div>
            <a asp-controller="Reports" asp-action="PostClosingTrialBalance" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right-circle me-1"></i> Post-Closing Trial Balance
            </a>
        </div>
    </div>

    @if (!Model.Groups.Any())
    {
        <div class="alert alert-secondary bg-dark text-muted border-secondary">Tidak ada akun nominal dengan saldo untuk ditutup.</div>
    }

    @foreach (var group in Model.Groups)
    {
        <div class="card bg-dark border-secondary text-white shadow-sm mb-4">
            <div class="card-header bg-transparent border-secondary fw-semibold">@group.Description</div>
            <div class="card-body p-0">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-active border-bottom border-secondary">
                        <tr>
                            <th class="text-center">Ref.</th>
                            <th>Account</th>
                            <th class="text-end">Debit</th>
                            <th class="text-end">Credit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in group.Lines)
                        {
                            <tr>
                                <td class="text-center"><code>@(line.ReferenceNumber > 0 ? line.ReferenceNumber.ToString() : "-")</code></td>
                                <td class="@(line.Credit > 0 ? "ps-4" : "fw-semibold")">@line.AccountName</td>
                                <td class="text-end text-success">@(line.Debit > 0 ? line.Debit.ToString("N2") : "-")</td>
                                <td class="text-end text-danger">@(line.Credit > 0 ? line.Credit.ToString("N2") : "-")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="border-top border-secondary fw-bold">
                            <td colspan="2" class="text-end">Total</td>
                            <td class="text-end text-success">@group.TotalDebit.ToString("N2")</td>
                            <td class="text-end text-danger">@group.TotalCredit.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    @if (Model.Groups.Any())
    {
        <div class="alert alert-info bg-opacity-10 mb-0 py-2 small">
            <i class="bi bi-info-circle-fill me-1"></i>
            Setelah jurnal penutup diposting, seluruh akun nominal bersaldo nol dan Laba/Rugi Bersih sebesar <strong>@Model.NetIncome.ToString("N2")</strong> berpindah ke <strong>@Model.RetainedEarningsAccountName</strong>.
        </div>
    }
</div>
