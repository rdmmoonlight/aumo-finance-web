@model AumoFinance.Models.IncomeStatementViewModel
@{
    ViewData["Title"] = "Income Statement";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-graph-up-arrow me-2 text-success"></i> Income Statement</h2>
            <p class="text-muted mb-0">Statement of Profit or Loss (IAS 1) untuk periode berjalan, per @Model.AsOfDate.ToString("dd MMMM yyyy").</p>
        </div>
        <div>
            <a asp-controller="Reports" asp-action="RetainedEarnings" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right-circle me-1"></i> Retained Earnings
            </a>
        </div>
    </div>

    <div class="card bg-dark border-secondary text-white shadow-sm">
        <div class="card-body">
            <table class="table table-dark table-borderless align-middle mb-0">
                <tbody>
                    <tr><td colspan="2" class="fw-bold text-warning text-uppercase small">Revenue</td></tr>
                    @foreach (var l in Model.Revenues)
                    {
                        <tr><td class="ps-4"><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">@l.Amount.ToString("N2")</td></tr>
                    }
                    <tr class="border-top border-secondary fw-semibold"><td class="ps-4">Total Revenue</td><td class="text-end">@Model.TotalRevenue.ToString("N2")</td></tr>

                    <tr><td colspan="2" class="pt-3 fw-bold text-warning text-uppercase small">Operating Expenses</td></tr>
                    @foreach (var l in Model.OperatingExpenses)
                    {
                        <tr><td class="ps-4"><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">(@l.Amount.ToString("N2"))</td></tr>
                    }
                    <tr class="border-top border-secondary fw-semibold"><td class="ps-4">Total Operating Expenses</td><td class="text-end">(@Model.TotalOperatingExpenses.ToString("N2"))</td></tr>

                    <tr class="border-top border-bottom border-secondary fw-bold fs-5">
                        <td class="pt-2 pb-2">Operating Income</td>
                        <td class="text-end pt-2 pb-2 @(Model.OperatingIncome >= 0 ? "text-success" : "text-danger")">@Model.OperatingIncome.ToString("N2")</td>
                    </tr>

                    @if (Model.OtherIncome.Any() || Model.OtherExpenses.Any())
                    {
                        <tr><td colspan="2" class="pt-3 fw-bold text-warning text-uppercase small">Other Income &amp; Expenses</td></tr>
                        @foreach (var l in Model.OtherIncome)
                        {
                            <tr><td class="ps-4"><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">@l.Amount.ToString("N2")</td></tr>
                        }
                        @foreach (var l in Model.OtherExpenses)
                        {
                            <tr><td class="ps-4"><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">(@l.Amount.ToString("N2"))</td></tr>
                        }
                    }

                    <tr class="border-top border-secondary" style="border-top-width: 3px !important;">
                        <td class="fw-bold fs-5 pt-2">Net Income</td>
                        <td class="text-end fw-bold fs-5 pt-2 @(Model.NetIncome >= 0 ? "text-success" : "text-danger")">@Model.NetIncome.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
