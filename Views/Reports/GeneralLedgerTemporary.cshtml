@model List<AurumFinance.Models.LedgerAccountViewModel>
@{
    ViewData["Title"] = "General Ledger (Temporary Accounts)";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-calculator me-2 text-success"></i> General Ledger (Temporary Accounts)</h2>
            <p class="text-muted mb-0">Nominal (temporary) accounts — Operating Income, Operating Expenses, Other Income, Other Expenses. Closed to Equity at period end; posted from the same General Journal entries.</p>
        </div>
        <div>
            <a asp-controller="GeneralJournal" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-journal-bookmark me-1"></i> General Journal
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary bg-dark text-muted border-secondary">No temporary accounts found in the Chart of Accounts.</div>
    }

    @{
        var netTotal = Model.Sum(l => l.NormalBalanceIsDebit ? -l.EndingBalance : l.EndingBalance);
    }

    <div class="card bg-dark border-secondary text-white shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-warning">Net Income / (Loss) before closing</span>
            <span class="fw-bold fs-5 @(netTotal >= 0 ? "text-success" : "text-danger")">@netTotal.ToString("N2")</span>
        </div>
    </div>

    @foreach (var ledger in Model)
    {
        <div id="account-@ledger.AccountId" class="card bg-dark border-secondary text-white shadow-sm mb-4">
            <div class="card-header bg-transparent border-secondary d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0"><code class="text-warning me-2">@ledger.ReferenceNumber</code> @ledger.AccountName
                    <span class="badge bg-secondary bg-opacity-25 border border-secondary ms-2">@ledger.Type</span>
                </h5>
                <span class="fw-semibold @(ledger.EndingBalance >= 0 ? "text-success" : "text-danger")">
                    Balance: @ledger.EndingBalance.ToString("N2") (@(ledger.NormalBalanceIsDebit ? "Dr" : "Cr"))
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead class="table-active border-bottom border-secondary">
                            <tr>
                                <th>Date</th>
                                <th class="text-center">Ref.</th>
                                <th>Description</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ledger.Lines.Any())
                            {
                                foreach (var line in ledger.Lines)
                                {
                                    <tr>
                                        <td class="text-nowrap">@line.EntryDate.ToString("dd-MM-yyyy")</td>
                                        <td class="text-center"><code>@line.ReferenceNumber</code></td>
                                        <td class="text-muted small">@line.Description</td>
                                        <td class="text-end text-success">@(line.Debit > 0 ? line.Debit.ToString("N2") : "-")</td>
                                        <td class="text-end text-danger">@(line.Credit > 0 ? line.Credit.ToString("N2") : "-")</td>
                                        <td class="text-end fw-semibold">@line.RunningBalance.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-3 text-muted">No postings yet for this account.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
