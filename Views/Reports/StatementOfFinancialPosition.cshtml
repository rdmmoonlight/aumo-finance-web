@model AumoFinance.Models.StatementOfFinancialPositionViewModel
@{
    ViewData["Title"] = "Statement of Financial Position";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-bank me-2 text-info"></i> Statement of Financial Position</h2>
            <p class="text-muted mb-0">In accordance with IAS 1, as of @Model.AsOfDate.ToString("MMMM dd, yyyy"). Retained earnings reflect the ending balance from the Retained Earnings Statement.</p>
        </div>
        <div>
            <a asp-controller="Reports" asp-action="ClosingJournal" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right-circle me-1"></i> Closing Journal
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card bg-dark border-secondary text-white shadow-sm h-100">
                <div class="card-header bg-transparent border-secondary fw-bold text-uppercase small text-warning">Assets</div>
                <div class="card-body">
                    <table class="table table-dark table-borderless align-middle mb-0">
                        <tbody>
                            @foreach (var l in Model.Assets)
                            {
                                <tr><td><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">@l.Amount.ToString("N2")</td></tr>
                            }
                            <tr class="border-top border-secondary fw-bold fs-5">
                                <td class="pt-2">Total Assets</td>
                                <td class="text-end pt-2">@Model.TotalAssets.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card bg-dark border-secondary text-white shadow-sm h-100">
                <div class="card-header bg-transparent border-secondary fw-bold text-uppercase small text-warning">Liabilities</div>
                <div class="card-body">
                    <table class="table table-dark table-borderless align-middle mb-0">
                        <tbody>
                            @foreach (var l in Model.Liabilities)
                            {
                                <tr><td><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">@l.Amount.ToString("N2")</td></tr>
                            }
                            <tr class="border-top border-secondary fw-semibold">
                                <td>Total Liabilities</td>
                                <td class="text-end">@Model.TotalLiabilities.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card bg-dark border-secondary text-white shadow-sm h-100 mt-4">
                <div class="card-header bg-transparent border-secondary fw-bold text-uppercase small text-warning">Equity</div>
                <div class="card-body">
                    <table class="table table-dark table-borderless align-middle mb-0">
                        <tbody>
                            @foreach (var l in Model.EquityExcludingRetainedEarnings)
                            {
                                <tr><td><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">@l.Amount.ToString("N2")</td></tr>
                            }
                            <tr><td>Retained Earnings (ending)</td><td class="text-end">@Model.RetainedEarningsEnding.ToString("N2")</td></tr>
                            <tr class="border-top border-secondary fw-semibold">
                                <td>Total Equity</td>
                                <td class="text-end">@Model.TotalEquity.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card bg-dark border-secondary text-white shadow-sm mt-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-5">Total Liabilities &amp; Equity</span>
                    <span class="fw-bold fs-5">@Model.TotalLiabilitiesAndEquity.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="alert @(Model.IsBalanced ? "alert-success" : "alert-danger") bg-opacity-10 mt-4 mb-0 py-2 small">
        @if (Model.IsBalanced)
        {
            <i class="bi bi-check-circle-fill me-1"></i> @:Total Assets = Total Liabilities + Equity. The Statement of Financial Position is balanced.
        }
        else
        {
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @:Total Assets does not equal Total Liabilities + Equity. Please check your journal entries.
        }
    </div>
</div>
