@model IEnumerable<AumoFinance.Models.ChartOfAccount>
@{
    ViewData["Title"] = "Chart of Accounts";
}

<div class="container-fluid py-4 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1"><i class="bi bi-diagram-3 me-2 text-warning"></i> Chart of Accounts</h2>
            <p class="text-secondary mb-0">Master list of financial accounts (Automatically sorted by reference).</p>
        </div>
        <div>
            <button class="btn btn-warning fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addAccountModal">
                <i class="bi bi-plus-lg me-1"></i> New Account
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- COA Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="d-flex gap-2">
                <input type="text" class="form-control form-control-sm" placeholder="Search accounts..." style="width: 250px;">
                <select class="form-select form-select-sm" style="width: 180px;">
                    <option value="">All Categories</option>
                    <option value="Assets">Assets</option>
                    <option value="Liabilities">Liabilities</option>
                    <option value="Equity">Equity</option>
                    <option value="OperatingIncome">Operating Income</option>
                    <option value="OperatingExpenses">Operating Expenses</option>
                    <option value="OtherIncome">Other Income</option>
                    <option value="OtherExpenses">Other Expenses</option>
                </select>
            </div>
            <span class="text-secondary small fw-semibold">Total Accounts: @Model.Count()</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 120px;">Ref No.</th>
                            <th>Account Name</th>
                            <th>Category</th>
                            <th>Role</th>
                            <th class="text-end">Current Balance</th>
                            <th class="text-center" style="width: 100px;">Status</th>
                            <th class="text-center pe-4" style="width: 130px;">Action</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if(Model.Any())
                        {
                            foreach (var account in Model)
                            {
                                <tr>
                                    <td class="ps-4"><code>@account.ReferenceNumber</code></td>
                                    <td class="fw-bold text-body">@account.AccountName</td>
                                    <td>
                                        <span class="badge bg-secondary text-light">
                                            @account.Type
                                        </span>
                                    </td>
                                    <td>
                                        @if(account.Role != "Default")
                                        {
                                            <span class="badge bg-info text-dark">@account.Role</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small">Standard</span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold @(account.Balance >= 0 ? "text-success" : "text-danger")">
                                        Rp @account.Balance.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(account.IsActive ? "bg-success" : "bg-danger")">
                                            @(account.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group shadow-sm">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit Account"
                                                    data-bs-toggle="modal" data-bs-target="#editAccountModal"
                                                    data-id="@account.Id"
                                                    data-ref="@account.ReferenceNumber"
                                                    data-name="@account.AccountName"
                                                    data-type="@account.Type"
                                                    data-role="@account.Role"
                                                    data-active="@account.IsActive.ToString().ToLower()"
                                                    onclick="openEditModal(this)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <a href="@Url.Action(AumoFinance.Models.AccountClassification.IsTemporary(account.Type) ? "GeneralLedgerTemporary" : "GeneralLedger", "Reports")#account-@account.Id" class="btn btn-sm btn-outline-info" title="View General Ledger">
                                                <i class="bi bi-journal-text"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Account"
                                                    onclick="confirmDelete(@account.Id, '@account.AccountName.Replace("'", "\\'")')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-secondary">
                                    <i class="bi bi-diagram-3 mb-3 d-block" style="font-size: 2.5rem;"></i>
                                    No accounts found. Add a new account to get started.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add Account -->
<div class="modal fade" id="addAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-body-emphasis"><i class="bi bi-plus-circle me-2 text-warning"></i> Add New Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-controller="ChartOfAccounts" asp-action="Create">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Category</label>
                        <select id="accountType" name="Type" class="form-select" required onchange="enforceNumberingRule()">
                            <option value="">-- Select Category --</option>
                            <option value="Assets">Assets (100 - 199)</option>
                            <option value="Liabilities">Liabilities (200 - 299)</option>
                            <option value="Equity">Equity (300 - 399)</option>
                            <option value="OperatingIncome">Operating Income (400 - 499)</option>
                            <option value="OperatingExpenses">Operating Expenses (500 - 599)</option>
                            <option value="OtherIncome">Other Income (600 - 799)</option>
                            <option value="OtherExpenses">Other Expenses (800 - 999)</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Reference Number (Account Code)</label>
                        <input type="number" id="referenceNumber" name="ReferenceNumber" class="form-control" placeholder="Select category first..." required disabled />
                        <div id="refHelpText" class="form-text text-secondary">Please select an account category to see the valid numbering range.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Name</label>
                        <input type="text" name="AccountName" class="form-control" placeholder="e.g. Rent Expense" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">System Role (Special Calculations)</label>
                        <select name="Role" class="form-select" required>
                            <option value="Default">Standard / Default</option>
                            <option value="CashAndEquivalents">Cash & Equivalents</option>
                            <option value="RetainedEarnings">Retained Earnings</option>
                            <option value="TaxPayable">Tax Payable</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Save Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Account -->
<div class="modal fade" id="editAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-body-emphasis"><i class="bi bi-pencil-square me-2 text-warning"></i> Edit Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-controller="ChartOfAccounts" asp-action="Edit">
                <input type="hidden" id="editId" name="Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Category</label>
                        <select id="editAccountType" name="Type" class="form-select" required onchange="enforceNumberingRule('editAccountType', 'editReferenceNumber', 'editRefHelpText')">
                            <option value="">-- Select Category --</option>
                            <option value="Assets">Assets (100 - 199)</option>
                            <option value="Liabilities">Liabilities (200 - 299)</option>
                            <option value="Equity">Equity (300 - 399)</option>
                            <option value="OperatingIncome">Operating Income (400 - 499)</option>
                            <option value="OperatingExpenses">Operating Expenses (500 - 599)</option>
                            <option value="OtherIncome">Other Income (600 - 799)</option>
                            <option value="OtherExpenses">Other Expenses (800 - 999)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Reference Number (Account Code)</label>
                        <input type="number" id="editReferenceNumber" name="ReferenceNumber" class="form-control" required />
                        <div id="editRefHelpText" class="form-text text-secondary">Valid numbering range depends on the selected category.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Name</label>
                        <input type="text" id="editAccountName" name="AccountName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">System Role (Special Calculations)</label>
                        <select id="editRole" name="Role" class="form-select" required>
                            <option value="Default">Standard / Default</option>
                            <option value="CashAndEquivalents">Cash & Equivalents</option>
                            <option value="RetainedEarnings">Retained Earnings</option>
                            <option value="TaxPayable">Tax Payable</option>
                        </select>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="editIsActive" name="IsActive" value="true" />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label fw-semibold small" for="editIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Update Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Form tersembunyi untuk Delete -->
<form id="deleteAccountForm" method="post" asp-controller="ChartOfAccounts" asp-action="Delete">
    <input type="hidden" id="deleteId" name="id" />
</form>

@section Scripts {
    <script>
        const NUMBERING_RULES = {
            'Assets': { min: 100, max: 199 },
            'Liabilities': { min: 200, max: 299 },
            'Equity': { min: 300, max: 399 },
            'OperatingIncome': { min: 400, max: 499 },
            'OperatingExpenses': { min: 500, max: 599 },
            'OtherIncome': { min: 600, max: 799 },
            'OtherExpenses': { min: 800, max: 999 }
        };

        function enforceNumberingRule(typeSelectId = 'accountType', refInputId = 'referenceNumber', helpTextId = 'refHelpText') {
            const typeSelect = document.getElementById(typeSelectId);
            const refInput = document.getElementById(refInputId);
            const helpText = document.getElementById(helpTextId);

            const selectedValue = typeSelect.value;

            if (selectedValue && NUMBERING_RULES[selectedValue]) {
                const rule = NUMBERING_RULES[selectedValue];

                refInput.disabled = false;
                refInput.min = rule.min;
                refInput.max = rule.max;
                refInput.placeholder = `Enter a number between ${rule.min} and ${rule.max}`;

                helpText.innerHTML = `<i class="bi bi-info-circle"></i> Valid range for this category: <strong>${rule.min} - ${rule.max}</strong>.`;
                helpText.className = "form-text text-primary";

                if (refInput.value && (refInput.value < rule.min || refInput.value > rule.max)) {
                    refInput.value = '';
                }
            } else {
                refInput.disabled = true;
                refInput.value = '';
                refInput.placeholder = "Select category first...";
                helpText.textContent = "Please select an account category to see the valid numbering range.";
                helpText.className = "form-text text-secondary";
            }
        }

        function openEditModal(button) {
            document.getElementById('editId').value = button.dataset.id;
            document.getElementById('editAccountName').value = button.dataset.name;
            document.getElementById('editRole').value = button.dataset.role;
            document.getElementById('editIsActive').checked = (button.dataset.active === 'true');

            const typeSelect = document.getElementById('editAccountType');
            typeSelect.value = button.dataset.type;
            enforceNumberingRule('editAccountType', 'editReferenceNumber', 'editRefHelpText');
            document.getElementById('editReferenceNumber').value = button.dataset.ref;
        }

        function confirmDelete(id, accountName) {
            if (confirm(`Delete account "${accountName}"? This action cannot be undone.`)) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteAccountForm').submit();
            }
        }
    </script>
}
