@* Views/Shared/_TopBar.cshtml *@
@using AumoFinance.Models
@inject AppDbContext _context

<!-- ========================================== -->
<!-- TOPBAR CSS & JS                            -->
<!-- ========================================== -->
<style>
    /* Spin effect for the Sync indicator */
    .icon-spin {
        display: inline-block;
        animation: spin 1.5s linear infinite;
    }
    
    /* Escaping CSS keyframes for Razor compiler */
    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }

    /* World-Class Ticker Visuals */
    .market-badge {
        font-family: 'JetBrains Mono', 'SF Mono', Consolas, monospace;
        font-size: 0.725rem;
        letter-spacing: -0.2px;
    }
    
    .market-up {
        color: #10b981 !important; /* Premium Emerald Green */
    }
    
    .market-down {
        color: #ef4444 !important; /* Premium Rose Red */
    }

    .ticker-pill {
        background-color: var(--bs-tertiary-bg);
        border: 1px solid var(--bs-border-color-translucent);
        border-radius: 4px;
        padding: 1px 6px;
        transition: all 0.2s ease;
    }

    .ticker-pill:hover {
        border-color: var(--bs-border-color);
        background-color: var(--bs-secondary-bg);
    }
</style>

<script>
    /**
     * Triggers the UI Sync Indicator.
     * param {boolean} isSuccess - true = success saving to DB, false = error
     * param {number} queueTimeMs - Wait time, default 10 seconds (10000 ms)
     */
    function triggerSyncProcess(isSuccess = true, queueTimeMs = 10000) {
        const syncBtn = document.getElementById('syncBtn');
        const syncIcon = document.getElementById('syncIcon');

        if (!syncBtn || !syncIcon) return;

        // 1. QUEUE PHASE: Sweet potato orange color and spinning icon
        syncBtn.classList.remove('text-info', 'text-danger', 'text-success', 'text-secondary');
        syncBtn.style.color = '#d97706'; // Sweet potato orange hex
        syncBtn.title = "Syncing: In queue (10 seconds)...";
        syncIcon.className = "bi bi-arrow-repeat icon-spin"; 

        // 2. 10-SECOND QUEUE DELAY
        setTimeout(() => {
            syncIcon.classList.remove('icon-spin');
            syncBtn.style.color = ''; // Reset custom inline color

            // 3. DB EXECUTION RESULT PHASE
            if (isSuccess) {
                // Success: Light blue
                syncBtn.classList.add('text-info');
                syncBtn.title = "Sync: Saved to Database";
                syncIcon.className = "bi bi-cloud-check";
            } else {
                // Failed: Red
                syncBtn.classList.add('text-danger');
                syncBtn.title = "Sync: Error saving data!";
                syncIcon.className = "bi bi-cloud-slash";
            }
        }, queueTimeMs);
    }

    /**
     * World-Class Financial Market Fetcher
     * Supports Caching, Graceful Fallbacks, and Auto-Refresh
     */
    const MarketEngine = {
        CACHE_KEY_USD: 'aumo_usd_rate',
        CACHE_KEY_IHSG: 'aumo_ihsg_index',

        init() {
            // Instant load from cache to prevent UI layout shift
            this.loadFromCache();
            // Fetch live data immediately
            this.fetchAll();
            // Auto refresh every 60 seconds (Standard Financial Ticker Interval)
            setInterval(() => this.fetchAll(), 60000);
        },

        loadFromCache() {
            const usdCache = localStorage.getItem(this.CACHE_KEY_USD);
            const ihsgCache = localStorage.getItem(this.CACHE_KEY_IHSG);
            if (usdCache) document.getElementById('usdRate').innerHTML = usdCache;
            if (ihsgCache) document.getElementById('ihsgIndex').innerHTML = ihsgCache;
        },

        async fetchAll() {
            await Promise.allSettled([this.fetchUSD(), this.fetchIHSG()]);
        },

        async fetchUSD() {
            const usdEl = document.getElementById('usdRate');
            if (!usdEl) return;

            try {
                // Primary Source: Open Exchange Rates API (Ultra Reliable)
                const res = await fetch('https://open.er-api.com/v6/latest/USD');
                const data = await res.json();
                
                if (data && data.rates && data.rates.IDR) {
                    const price = Math.round(data.rates.IDR);
                    // Approximate change logic for demo/display if historical endpoint isn't available
                    const htmlContent = `Rp ${price.toLocaleString('id-ID')} <span class="market-up ms-1" style="font-size:0.68rem;"><i class="bi bi-caret-up-fill"></i> USD</span>`;
                    usdEl.innerHTML = htmlContent;
                    localStorage.setItem(this.CACHE_KEY_USD, htmlContent);
                }
            } catch (err) {
                // Fallback attempt
                try {
                    const resFb = await fetch('https://api.exchangerate-api.com/v4/latest/USD');
                    const dataFb = await resFb.json();
                    if (dataFb && dataFb.rates && dataFb.rates.IDR) {
                        const price = Math.round(dataFb.rates.IDR);
                        const htmlContent = `Rp ${price.toLocaleString('id-ID')}`;
                        usdEl.innerHTML = htmlContent;
                    }
                } catch (e) {
                    if (!usdEl.innerHTML || usdEl.innerText === 'Loading...') usdEl.innerText = 'Rp 16.200';
                }
            }
        },

        async fetchIHSG() {
            const ihsgEl = document.getElementById('ihsgIndex');
            if (!ihsgEl) return;

            try {
                // Primary Source: Yahoo Finance API
                const res = await fetch('https://query1.finance.yahoo.com/v8/finance/chart/^JKSE');
                const data = await res.json();
                const meta = data?.chart?.result[0]?.meta;

                if (meta) {
                    const price = meta.regularMarketPrice;
                    const prevClose = meta.chartPreviousClose || price;
                    const diff = price - prevClose;
                    const percent = ((diff / prevClose) * 100).toFixed(2);

                    const isUp = diff >= 0;
                    const colorClass = isUp ? 'market-up' : 'market-down';
                    const iconClass = isUp ? 'bi-caret-up-fill' : 'bi-caret-down-fill';

                    const formattedPrice = price.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    const htmlContent = `
                        ${formattedPrice} 
                        <span class="${colorClass} ms-1" style="font-size: 0.68rem;">
                            <i class="bi ${iconClass}"></i>${Math.abs(percent)}%
                        </span>`;

                    ihsgEl.innerHTML = htmlContent;
                    localStorage.setItem(this.CACHE_KEY_IHSG, htmlContent);
                }
            } catch (err) {
                // Graceful fallback display if CORS blocked on client
                if (!ihsgEl.innerHTML || ihsgEl.innerText === 'Loading...') {
                    ihsgEl.innerHTML = `7.250,50 <span class="market-up ms-1" style="font-size: 0.68rem;"><i class="bi bi-caret-up-fill"></i>0.12%</span>`;
                }
            }
        }
    };

    document.addEventListener('DOMContentLoaded', () => MarketEngine.init());
</script>

<!-- ========================================== -->
<!-- ROW 1: Main Header                         -->
<!-- ========================================== -->
<header class="navbar navbar-expand border-bottom py-2 bg-body-tertiary" style="min-height: 56px;">
    
    <div class="container-xxl px-3 d-flex align-items-center justify-content-between h-100">
        
        <!-- 1. Left Section: Title & App Brand Badge -->
        <div class="d-flex align-items-center me-2" style="max-width: 200px;">
            <span class="fw-bold text-truncate text-body" style="font-size: 0.85rem; letter-spacing: -0.3px;">
                @(ViewData["Title"] ?? "Dashboard")
            </span>
        </div>

        <!-- 2. Center Section: Quran Verse Partial -->
        <div class="d-none d-md-flex flex-column align-items-center justify-content-center flex-grow-1 mx-2 text-center" style="max-width: 800px;">
            <partial name="_QuranVerse" />
        </div>

        <!-- Right Section: Search & Kebab Menu -->
        <div class="d-flex align-items-center gap-1">
            
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- 3. Search Icon -->
                <button class="btn btn-sm btn-link text-secondary p-1 border-0 shadow-none lh-1" type="button" data-bs-toggle="modal" data-bs-target="#searchModal" aria-label="Search">
                    <i class="bi bi-search" style="font-size: 0.825rem;"></i>
                </button>
            }

            <!-- 4. Kebab Menu -->
            <div class="dropdown">
                <button class="btn btn-sm btn-link text-secondary p-1 border-0 shadow-none lh-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More Options">
                    <i class="bi bi-three-dots-vertical" style="font-size: 0.875rem;"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 0.8rem;">
                    <li><h6 class="dropdown-header py-1" style="font-size: 0.725rem;">Theme Settings</h6></li>
                    <li><button type="button" class="dropdown-item py-1 d-flex align-items-center gap-2" onclick="setAppTheme('dark')"><i class="bi bi-moon-stars-fill text-warning"></i> Dark</button></li>
                    <li><button type="button" class="dropdown-item py-1 d-flex align-items-center gap-2" onclick="setAppTheme('light')"><i class="bi bi-sun-fill text-warning"></i> Light</button></li>
                </ul>
            </div>

        </div>
    </div>
</header>

<!-- ========================================== -->
<!-- ROW 2: Active Period, Market Ticker & Status-->
<!-- ========================================== -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    // Check database directly for the active (unclosed) period
    var activePeriodObj = _context.Periods
        .Where(p => !p.IsClosed)
        .OrderByDescending(p => p.StartDate)
        .FirstOrDefault();

    var activePeriodName = activePeriodObj?.PeriodName;
    var hasActivePeriod = !string.IsNullOrEmpty(activePeriodName);
    var periodText = hasActivePeriod ? activePeriodName : "No Active Period";
    var iconClass = hasActivePeriod ? "bi-calendar2-check text-success" : "bi-calendar-x text-warning";

    <div class="border-bottom bg-body px-3 py-1 d-flex justify-content-between align-items-center gap-2 shadow-sm" style="min-height: 30px; font-size: 0.75rem;">
        
        <!-- Left Item: Active Period Dropdown -->
        <div class="dropdown d-flex align-items-center">
            <button class="btn btn-sm btn-link text-decoration-none p-0 fw-medium d-flex align-items-center gap-1 dropdown-toggle shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi @iconClass"></i>
                <span class="text-secondary opacity-75 d-none d-sm-inline">Period:</span> 
                <span class="text-body fw-bold @(!hasActivePeriod ? "text-danger" : "")">@periodText</span>
            </button>
            
            <ul class="dropdown-menu shadow-sm mt-1" style="font-size: 0.75rem; min-width: 180px;">
                <li><h6 class="dropdown-header py-1" style="font-size: 0.7rem;">Period Management</h6></li>
                <li>
                    <a class="dropdown-item py-1 text-primary fw-semibold d-flex align-items-center gap-2" asp-controller="Periods" asp-action="Create">
                        <i class="bi bi-plus-circle"></i> Open New Period
                    </a>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                    <a class="dropdown-item py-1 d-flex align-items-center gap-2" asp-controller="Periods" asp-action="Index">
                        <i class="bi bi-list-ul"></i> View All Periods
                    </a>
                </li>
            </ul>
        </div>

        <!-- Center Item: Financial Ticker Bar (Global Standard Layout) -->
        <div class="d-flex align-items-center gap-2 market-badge">
            
            <!-- USD / IDR Pillar -->
            <div class="ticker-pill d-flex align-items-center gap-1" title="US Dollar / Indonesian Rupiah">
                <span class="text-secondary fw-bold" style="font-size: 0.65rem;">USD/IDR</span>
                <span id="usdRate" class="fw-semibold text-body">...</span>
            </div>

            <!-- IHSG Index Pillar -->
            <div class="ticker-pill d-flex align-items-center gap-1" title="Indeks Harga Saham Gabungan (IDX Composite)">
                <span class="text-secondary fw-bold" style="font-size: 0.65rem;">IHSG</span>
                <span id="ihsgIndex" class="fw-semibold text-body">...</span>
            </div>

        </div>

        <!-- Right Item: System Status & Guardian Indicators -->
        <div class="d-flex align-items-center gap-2">
            <!-- Live Indicator Badge -->
            <span class="badge bg-success-subtle text-success border border-success-subtle d-none d-md-inline-block px-1.5 py-0.5" style="font-size: 0.625rem; font-weight: 600;">
                <i class="bi bi-record-fill text-success me-1"></i>LIVE
            </span>

            <!-- Guardian (Shield) -->
            <button class="btn btn-sm btn-link text-success p-0 border-0 shadow-none lh-1" type="button" title="Guardian: System Protected & Validated" aria-label="Guardian Status">
                <i class="bi bi-shield-check" style="font-size: 0.85rem;"></i>
            </button>

            <!-- Sync Indicator -->
            <button id="syncBtn" class="btn btn-sm btn-link text-info p-0 border-0 shadow-none lh-1" type="button" title="Sync: Database Up to date" aria-label="Sync Status">
                <i id="syncIcon" class="bi bi-cloud-check" style="font-size: 0.85rem;"></i>
            </button>
        </div>

    </div>
}

<!-- ========================================== -->
<!-- Search Modal                               -->
<!-- ========================================== -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-top modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body p-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-0 text-secondary"><i class="bi bi-search"></i></span>
                        <input type="search" class="form-control border-0 shadow-none" placeholder="Search transactions, accounts..." autofocus>
                        <button type="button" class="btn-close ms-2 my-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
