@* Views/Shared/_TopBar.cshtml *@
@using AumoFinance.Models
@inject AppDbContext _context

<!-- ========================================== -->
<!-- TOPBAR CSS & JS                            -->
<!-- ========================================== -->
<style>
    /* Spin effect for the Sync indicator */
    .icon-spin {
        display: inline-block;
        animation: spin 1.5s linear infinite;
    }
    
    /* Escaping CSS keyframes for Razor compiler */
    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }
</style>

<script>
    /**
     * Triggers the UI Sync Indicator.
     * param {boolean} isSuccess - true = success saving to DB, false = error
     * param {number} queueTimeMs - Wait time, default 10 seconds (10000 ms)
     */
    function triggerSyncProcess(isSuccess = true, queueTimeMs = 10000) {
        const syncBtn = document.getElementById('syncBtn');
        const syncIcon = document.getElementById('syncIcon');

        if (!syncBtn || !syncIcon) return;

        // 1. QUEUE PHASE: Sweet potato orange color and spinning icon
        syncBtn.classList.remove('text-info', 'text-danger', 'text-success', 'text-secondary');
        syncBtn.style.color = '#d97706'; // Sweet potato orange hex
        syncBtn.title = "Syncing: In queue (10 seconds)...";
        syncIcon.className = "bi bi-arrow-repeat icon-spin"; 

        // 2. 10-SECOND QUEUE DELAY
        setTimeout(() => {
            syncIcon.classList.remove('icon-spin');
            syncBtn.style.color = ''; // Reset custom inline color

            // 3. DB EXECUTION RESULT PHASE
            if (isSuccess) {
                // Success: Light blue
                syncBtn.classList.add('text-info');
                syncBtn.title = "Sync: Saved to Database";
                syncIcon.className = "bi bi-cloud-check";
            } else {
                // Failed: Red
                syncBtn.classList.add('text-danger');
                syncBtn.title = "Sync: Error saving data!";
                syncIcon.className = "bi bi-cloud-slash";
            }
        }, queueTimeMs);
    }

    /**
     * Internal Server Fetcher (CORS Free & Always Working)
     */
    async function fetchMarketData() {
        const usdEl = document.getElementById('usdRate');
        const ihsgEl = document.getElementById('ihsgIndex');
        const biRateEl = document.getElementById('biRate');

        try {
            const res = await fetch('/Market/GetMarketData');
            const data = await res.json();

            if (data.success) {
                // Render USD
                if (usdEl && data.usd) {
                    const price = Math.round(data.usd.price);
                    const colorClass = data.usd.isUp ? 'text-success' : 'text-danger';
                    const iconClass = data.usd.isUp ? 'bi-caret-up-fill' : 'bi-caret-down-fill';
                    const percent = Math.abs(data.usd.percent).toFixed(2);

                    usdEl.innerHTML = `
                        Rp ${price.toLocaleString('id-ID')} 
                        <span class="${colorClass} ms-1" style="font-size: 0.65rem;">
                            <i class="bi ${iconClass}"></i>${percent}%
                        </span>`;
                }

                // Render IHSG
                if (ihsgEl && data.ihsg) {
                    const price = data.ihsg.price;
                    const colorClass = data.ihsg.isUp ? 'text-success' : 'text-danger';
                    const iconClass = data.ihsg.isUp ? 'bi-caret-up-fill' : 'bi-caret-down-fill';
                    const percent = Math.abs(data.ihsg.percent).toFixed(2);
                    const formattedPrice = price.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                    ihsgEl.innerHTML = `
                        ${formattedPrice} 
                        <span class="${colorClass} ms-1" style="font-size: 0.65rem;">
                            <i class="bi ${iconClass}"></i>${percent}%
                        </span>`;
                }

                // Render BI-Rate
                if (biRateEl && data.biRate) {
                    biRateEl.innerText = data.biRate;
                }
            } else {
                if (usdEl) usdEl.innerText = '-';
                if (ihsgEl) ihsgEl.innerText = '-';
                if (biRateEl) biRateEl.innerText = '-';
            }
        } catch (err) {
            if (usdEl) usdEl.innerText = '-';
            if (ihsgEl) ihsgEl.innerText = '-';
            if (biRateEl) biRateEl.innerText = '-';
        }
    }

    document.addEventListener('DOMContentLoaded', fetchMarketData);
</script>

<!-- ========================================== -->
<!-- ROW 1: Main Header                         -->
<!-- ========================================== -->
<header class="navbar navbar-expand border-bottom py-2 bg-body-tertiary" style="min-height: 56px;">
    
    <div class="container-xxl px-3 d-flex align-items-center justify-content-between h-100">
        
        <!-- 1. Left Section: Title -->
        <div class="d-flex align-items-center me-2" style="max-width: 160px;">
            <span class="fw-semibold text-truncate text-body" style="font-size: 0.8rem;">
                @(ViewData["Title"] ?? "Dashboard")
            </span>
        </div>

        <!-- 2. Center Section: Quran Verse Partial -->
        <div class="d-none d-md-flex flex-column align-items-center justify-content-center flex-grow-1 mx-2 text-center" style="max-width: 800px;">
            <partial name="_QuranVerse" />
        </div>

        <!-- Right Section: Search & Kebab Menu -->
        <div class="d-flex align-items-center gap-1">
            
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- 3. Search Icon -->
                <button class="btn btn-sm btn-link text-secondary p-1 border-0 shadow-none lh-1" type="button" data-bs-toggle="modal" data-bs-target="#searchModal" aria-label="Search">
                    <i class="bi bi-search" style="font-size: 0.825rem;"></i>
                </button>
            }

            <!-- 4. Kebab Menu -->
            <div class="dropdown">
                <button class="btn btn-sm btn-link text-secondary p-1 border-0 shadow-none lh-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More Options">
                    <i class="bi bi-three-dots-vertical" style="font-size: 0.875rem;"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 0.8rem;">
                    <li><h6 class="dropdown-header py-1" style="font-size: 0.725rem;">Theme Settings</h6></li>
                    <li><button type="button" class="dropdown-item py-1 d-flex align-items-center gap-2" onclick="setAppTheme('dark')"><i class="bi bi-moon-stars-fill text-warning"></i> Dark</button></li>
                    <li><button type="button" class="dropdown-item py-1 d-flex align-items-center gap-2" onclick="setAppTheme('light')"><i class="bi bi-sun-fill text-warning"></i> Light</button></li>
                </ul>
            </div>

        </div>
    </div>
</header>

<!-- ========================================== -->
<!-- ROW 2: Active Period, Market & Indicators  -->
<!-- ========================================== -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    // Tampilkan periode yang sedang di-VIEW (IsSelected = true di database),
    // bukan sekadar periode terbuka terakhir. Ini global — sama untuk semua
    // orang yang mengakses aplikasi. Selama belum ada yang dipilih, seluruh
    // halaman yang bergantung padanya (Dashboard, General/Adjusting Journal,
    // laporan) dianggap kosong.
    var activePeriodObj = _context.Periods.FirstOrDefault(p => p.IsSelected);

    var activePeriodName = activePeriodObj?.PeriodName;
    var hasActivePeriod = !string.IsNullOrEmpty(activePeriodName);
    var isViewingClosed = activePeriodObj?.IsClosed ?? false;
    var periodText = hasActivePeriod ? activePeriodName : "No Period Selected";
    var iconClass = !hasActivePeriod ? "bi-calendar-x text-warning" : (isViewingClosed ? "bi-lock-fill text-secondary" : "bi-calendar2-check text-success");

    <div class="border-bottom bg-body px-3 py-1 d-flex justify-content-center align-items-center gap-2 shadow-sm text-nowrap" style="min-height: 28px; font-size: 0.75rem;">
        
        <!-- Active Period Dropdown -->
        <div class="dropdown">
            <button class="btn btn-sm btn-link text-decoration-none p-0 fw-medium d-flex align-items-center gap-1 dropdown-toggle shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi @iconClass"></i>
                <span class="text-body fw-bold @(!hasActivePeriod ? "text-danger" : "")">@periodText</span>
                @if (isViewingClosed)
                {
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Closed</span>
                }
            </button>
            
            <ul class="dropdown-menu shadow-sm mt-1" style="font-size: 0.75rem; min-width: 180px;">
                <li><h6 class="dropdown-header py-1" style="font-size: 0.7rem;">Period Management</h6></li>
                <li>
                    <a class="dropdown-item py-1 text-primary fw-semibold d-flex align-items-center gap-2" asp-controller="Periods" asp-action="Create">
                        <i class="bi bi-plus-circle"></i> Open New Period
                    </a>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                    <a class="dropdown-item py-1 d-flex align-items-center gap-2" asp-controller="Periods" asp-action="Index">
                        <i class="bi bi-list-ul"></i> View All Periods
                    </a>
                </li>
                @if (hasActivePeriod)
                {
                    <li>
                        <a class="dropdown-item py-1 text-danger d-flex align-items-center gap-2" asp-controller="Periods" asp-action="ClearSelection">
                            <i class="bi bi-eye-slash"></i> Stop Viewing
                        </a>
                    </li>
                }
            </ul>
        </div>

        <!-- Vertical Divider -->
        <span class="text-secondary opacity-50">|</span>

        <!-- USD Rate Indicator -->
        <div class="d-flex align-items-center gap-1" title="USD to IDR Rate">
            <span class="text-secondary fw-bold" style="font-size: 0.7rem;">USD:</span>
            <span id="usdRate" class="fw-semibold text-body">Loading...</span>
        </div>

        <!-- Vertical Divider -->
        <span class="text-secondary opacity-50">|</span>

        <!-- IHSG Index Indicator -->
        <div class="d-flex align-items-center gap-1" title="IHSG Index">
            <span class="text-secondary fw-bold" style="font-size: 0.7rem;">IHSG:</span>
            <span id="ihsgIndex" class="fw-semibold text-body">Loading...</span>
        </div>

        <!-- Vertical Divider -->
        <span class="text-secondary opacity-50">|</span>

        <!-- BI-Rate Indicator -->
        <div class="d-flex align-items-center gap-1" title="Bank Indonesia Policy Rate">
            <span class="text-secondary fw-bold" style="font-size: 0.7rem;">BI-RATE:</span>
            <span id="biRate" class="fw-semibold text-body">Loading...</span>
        </div>

        <!-- Vertical Divider -->
        <span class="text-secondary opacity-50">|</span>

        <!-- Row 2 Indicators: Guardian & Sync -->
        <div class="d-flex align-items-center gap-1">
            <!-- Indicator: Guardian (Shield) -->
            <button class="btn btn-sm btn-link text-success p-0 border-0 shadow-none lh-1" type="button" title="Guardian: Protected" aria-label="Guardian Status">
                <i class="bi bi-shield-check" style="font-size: 0.825rem;"></i>
            </button>

            <!-- Indicator: Sync -->
            <button id="syncBtn" class="btn btn-sm btn-link text-info p-0 border-0 shadow-none lh-1" type="button" title="Sync: Up to date" aria-label="Sync Status">
                <i id="syncIcon" class="bi bi-cloud-check" style="font-size: 0.825rem;"></i>
            </button>
        </div>

    </div>
}

<!-- ========================================== -->
<!-- Search Modal                               -->
<!-- ========================================== -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-top modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body p-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-0 text-secondary"><i class="bi bi-search"></i></span>
                        <input type="search" class="form-control border-0 shadow-none" placeholder="Search transactions, accounts..." autofocus>
                        <button type="button" class="btn-close ms-2 my-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
