@* Views/Shared/_TopBar.cshtml *@
@using AumoFinance.Models
@inject AppDbContext _context

<!-- ========================================== -->
<!-- GOTHIC STYLING & JS ENGINE                 -->
<!-- ========================================== -->
<style>
    /* Google Fonts Import for Gothic Aesthetic */
    @@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=EB+Garamond:ital,wght@0,500;0,700;1,400&display=swap');

    /* Gothic Bar Backdrops */
    .topbar-gothic {
        background: #090a0f !important; /* Deep Obsidian Black */
        border-bottom: 1px solid rgba(180, 142, 60, 0.25) !important; /* Muted Gold Border */
    }

    .row2-gothic {
        background: #0d0e14 !important;
        border-bottom: 1px solid rgba(180, 142, 60, 0.15);
    }

    /* Gothic Font Classes */
    .gothic-header-font {
        font-family: 'Cinzel', serif;
        letter-spacing: 1px;
    }

    .gothic-font {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.85rem;
        letter-spacing: 0.2px;
    }

    /* Gothic Palette & Glows */
    .gothic-gold {
        color: #d4af37 !important; /* Classic Gold */
        text-shadow: 0 0 4px rgba(212, 175, 55, 0.2);
    }

    .gothic-silver {
        color: #c0c0c0 !important;
    }

    .gothic-crimson {
        color: #e63946 !important; /* Crimson Red for Down Market */
        text-shadow: 0 0 4px rgba(230, 57, 70, 0.2);
    }

    .gothic-emerald {
        color: #2a9d8f !important; /* Dark Emerald Green for Up Market */
        text-shadow: 0 0 4px rgba(42, 157, 143, 0.2);
    }

    .gothic-divider {
        color: #7b6f52;
        opacity: 0.6;
        font-size: 0.65rem;
        margin: 0 4px;
    }

    /* Spin effect for Sync */
    .icon-spin {
        display: inline-block;
        animation: spin 1.5s linear infinite;
    }

    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }
</style>

<script>
    function triggerSyncProcess(isSuccess = true, queueTimeMs = 10000) {
        const syncBtn = document.getElementById('syncBtn');
        const syncIcon = document.getElementById('syncIcon');

        if (!syncBtn || !syncIcon) return;

        syncBtn.classList.remove('text-info', 'text-danger', 'text-success', 'text-secondary');
        syncBtn.style.color = '#d4af37';
        syncBtn.title = "Syncing in progress...";
        syncIcon.className = "bi bi-arrow-repeat icon-spin"; 

        setTimeout(() => {
            syncIcon.classList.remove('icon-spin');
            syncBtn.style.color = '';

            if (isSuccess) {
                syncBtn.classList.add('gothic-gold');
                syncBtn.title = "Sync: Database Synchronized";
                syncIcon.className = "bi bi-cloud-check";
            } else {
                syncBtn.classList.add('gothic-crimson');
                syncBtn.title = "Sync: Offline Error";
                syncIcon.className = "bi bi-cloud-slash";
            }
        }, queueTimeMs);
    }

    async function fetchMarketData() {
        const usdEl = document.getElementById('usdRate');
        const ihsgEl = document.getElementById('ihsgIndex');
        const biRateEl = document.getElementById('biRate');

        try {
            const res = await fetch('/Market/GetMarketData');
            const data = await res.json();

            if (data.success) {
                // USD Render
                if (usdEl && data.usd) {
                    const price = Math.round(data.usd.price);
                    const colorClass = data.usd.isUp ? 'gothic-emerald' : 'gothic-crimson';
                    const iconClass = data.usd.isUp ? 'bi-caret-up-fill' : 'bi-caret-down-fill';
                    const percent = Math.abs(data.usd.percent).toFixed(2);

                    usdEl.innerHTML = `
                        Rp ${price.toLocaleString('id-ID')} 
                        <span class="${colorClass} ms-1" style="font-size: 0.7rem;">
                            <i class="bi ${iconClass}"></i>${percent}%
                        </span>`;
                }

                // IHSG Render
                if (ihsgEl && data.ihsg) {
                    const price = data.ihsg.price;
                    const colorClass = data.ihsg.isUp ? 'gothic-emerald' : 'gothic-crimson';
                    const iconClass = data.ihsg.isUp ? 'bi-caret-up-fill' : 'bi-caret-down-fill';
                    const percent = Math.abs(data.ihsg.percent).toFixed(2);
                    const formattedPrice = price.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                    ihsgEl.innerHTML = `
                        ${formattedPrice} 
                        <span class="${colorClass} ms-1" style="font-size: 0.7rem;">
                            <i class="bi ${iconClass}"></i>${percent}%
                        </span>`;
                }

                // BI Rate Render
                if (biRateEl && data.biRate) {
                    biRateEl.innerHTML = `<span class="gothic-gold">${data.biRate}</span>`;
                }
            } else {
                if (usdEl) usdEl.innerText = '-';
                if (ihsgEl) ihsgEl.innerText = '-';
                if (biRateEl) biRateEl.innerText = '-';
            }
        } catch (err) {
            if (usdEl) usdEl.innerText = '-';
            if (ihsgEl) ihsgEl.innerText = '-';
            if (biRateEl) biRateEl.innerText = '-';
        }
    }

    document.addEventListener('DOMContentLoaded', fetchMarketData);
</script>

<!-- ========================================== -->
<!-- ROW 1: Gothic Main Header                  -->
<!-- ========================================== -->
<header class="navbar navbar-expand border-bottom py-2 topbar-gothic" style="min-height: 56px;">
    <div class="container-xxl px-3 d-flex align-items-center justify-content-between h-100">
        
        <!-- Left Title -->
        <div class="d-flex align-items-center me-2" style="max-width: 180px;">
            <span class="fw-bold text-truncate gothic-gold gothic-header-font" style="font-size: 0.85rem;">
                @(ViewData["Title"] ?? "DASHBOARD")
            </span>
        </div>

        <!-- Center Verse -->
        <div class="d-none d-md-flex flex-column align-items-center justify-content-center flex-grow-1 mx-2 text-center" style="max-width: 800px;">
            <partial name="_QuranVerse" />
        </div>

        <!-- Right Controls -->
        <div class="d-flex align-items-center gap-1">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <button class="btn btn-sm btn-link gothic-gold p-1 border-0 shadow-none lh-1" type="button" data-bs-toggle="modal" data-bs-target="#searchModal" aria-label="Search">
                    <i class="bi bi-search" style="font-size: 0.825rem;"></i>
                </button>
            }

            <div class="dropdown">
                <button class="btn btn-sm btn-link gothic-gold p-1 border-0 shadow-none lh-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More Options">
                    <i class="bi bi-three-dots-vertical" style="font-size: 0.875rem;"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm gothic-font" style="font-size: 0.8rem; background: #0d0e14; border: 1px solid rgba(180, 142, 60, 0.3);">
                    <li><h6 class="dropdown-header py-1 gothic-gold" style="font-size: 0.725rem;">Theme Settings</h6></li>
                    <li><button type="button" class="dropdown-item py-1 gothic-silver d-flex align-items-center gap-2" onclick="setAppTheme('dark')"><i class="bi bi-moon-stars-fill gothic-gold"></i> Dark</button></li>
                    <li><button type="button" class="dropdown-item py-1 gothic-silver d-flex align-items-center gap-2" onclick="setAppTheme('light')"><i class="bi bi-sun-fill gothic-gold"></i> Light</button></li>
                </ul>
            </div>
        </div>
    </div>
</header>

<!-- ========================================== -->
<!-- ROW 2: Gothic Financial Console            -->
<!-- ========================================== -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    var activePeriodObj = _context.Periods
        .Where(p => !p.IsClosed)
        .OrderByDescending(p => p.StartDate)
        .FirstOrDefault();

    var activePeriodName = activePeriodObj?.PeriodName;
    var hasActivePeriod = !string.IsNullOrEmpty(activePeriodName);
    var periodText = hasActivePeriod ? activePeriodName : "No Active Period";
    var iconClass = hasActivePeriod ? "bi-calendar2-check gothic-gold" : "bi-calendar-x gothic-crimson";

    <div class="border-bottom row2-gothic px-3 py-1 d-flex justify-content-center align-items-center gap-2 shadow-sm gothic-font text-nowrap" style="min-height: 28px;">
        
        <!-- Active Period Dropdown -->
        <div class="dropdown">
            <button class="btn btn-sm btn-link text-decoration-none p-0 fw-medium d-flex align-items-center gap-1 dropdown-toggle shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi @iconClass"></i>
                <span class="gothic-silver opacity-75">Period:</span> 
                <span class="gothic-gold fw-bold @(!hasActivePeriod ? "gothic-crimson" : "")">@periodText</span>
            </button>
            
            <ul class="dropdown-menu shadow-sm mt-1" style="font-size: 0.8rem; min-width: 180px; background: #0d0e14; border: 1px solid rgba(180, 142, 60, 0.3);">
                <li><h6 class="dropdown-header py-1 gothic-gold" style="font-size: 0.7rem;">Period Management</h6></li>
                <li>
                    <a class="dropdown-item py-1 gothic-gold fw-semibold d-flex align-items-center gap-2" asp-controller="Periods" asp-action="Create">
                        <i class="bi bi-plus-circle"></i> Open New Period
                    </a>
                </li>
                <li><hr class="dropdown-divider my-1" style="border-color: rgba(180, 142, 60, 0.2);"></li>
                <li>
                    <a class="dropdown-item py-1 gothic-silver d-flex align-items-center gap-2" asp-controller="Periods" asp-action="Index">
                        <i class="bi bi-list-ul"></i> View All Periods
                    </a>
                </li>
            </ul>
        </div>

        <!-- Gothic Fleur-de-lis Ornaments Divider -->
        <span class="gothic-divider">⚜</span>

        <!-- USD Rate -->
        <div class="d-flex align-items-center gap-1" title="US Dollar / Indonesian Rupiah">
            <span class="gothic-silver opacity-75 fw-bold" style="font-size: 0.75rem;">USD:</span>
            <span id="usdRate" class="fw-semibold gothic-gold">Loading...</span>
        </div>

        <!-- Gothic Divider -->
        <span class="gothic-divider">⚜</span>

        <!-- IHSG Index -->
        <div class="d-flex align-items-center gap-1" title="IDX Composite Index">
            <span class="gothic-silver opacity-75 fw-bold" style="font-size: 0.75rem;">IHSG:</span>
            <span id="ihsgIndex" class="fw-semibold gothic-gold">Loading...</span>
        </div>

        <!-- Gothic Divider -->
        <span class="gothic-divider">⚜</span>

        <!-- BI-Rate -->
        <div class="d-flex align-items-center gap-1" title="Bank Indonesia Policy Rate">
            <span class="gothic-silver opacity-75 fw-bold" style="font-size: 0.75rem;">BI-RATE:</span>
            <span id="biRate" class="fw-semibold gothic-gold">Loading...</span>
        </div>

        <!-- Gothic Divider -->
        <span class="gothic-divider">⚜</span>

        <!-- Indicators: Guardian & Sync -->
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-link gothic-gold p-0 border-0 shadow-none lh-1" type="button" title="Guardian: Protected" aria-label="Guardian Status">
                <i class="bi bi-shield-check" style="font-size: 0.85rem;"></i>
            </button>

            <button id="syncBtn" class="btn btn-sm btn-link gothic-gold p-0 border-0 shadow-none lh-1" type="button" title="Sync: Up to date" aria-label="Sync Status">
                <i id="syncIcon" class="bi bi-cloud-check" style="font-size: 0.85rem;"></i>
            </button>
        </div>

    </div>
}

<!-- Modal Search -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-top modal-sm">
            <div class="modal-content border-0 shadow-lg topbar-gothic">
                <div class="modal-body p-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-0 gothic-gold"><i class="bi bi-search"></i></span>
                        <input type="search" class="form-control border-0 shadow-none gothic-silver gothic-font" placeholder="Search transactions, accounts..." autofocus style="background: transparent;">
                        <button type="button" class="btn-close btn-close-white ms-2 my-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
