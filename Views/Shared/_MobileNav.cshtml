@* Views/Shared/_MobileNav.cshtml *@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<style>
    .mobile-nav {
        display: none;
    }

    @@media (max-width: 767.98px) {
        .mobile-nav {
            display: flex;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 1030;
            background-color: var(--aumo-surface, #161B22);
            border-top: 1px solid var(--bs-border-color, #2A313C);
            padding-bottom: env(safe-area-inset-bottom, 0);
        }

        .mobile-nav .mnav-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2px;
            padding: 0.45rem 0.1rem;
            color: var(--aumo-text-muted, #CBD5E1) !important;
            text-decoration: none;
            font-size: 0.65rem;
            border: 0;
            background: transparent;
        }

        .mobile-nav .mnav-item i {
            font-size: 1.1rem;
        }

        .mobile-nav .mnav-item.active {
            color: var(--aumo-primary, #3B82F6) !important;
        }

        /* Beri ruang di bawah konten agar tidak tertutup bottom nav */
        #mainContent {
            padding-bottom: 4.5rem !important;
        }
    }
</style>

<nav class="mobile-nav">
    <a asp-controller="Dashboard" asp-action="Index"
       class="mnav-item @(controller == "Dashboard" ? "active" : "")">
        <i class="bi bi-columns-gap"></i>
        <span>Dashboard</span>
    </a>

    <a asp-controller="JournalEntry" asp-action="Create"
       class="mnav-item @(controller == "JournalEntry" ? "active" : "")">
        <i class="bi bi-journal-plus"></i>
        <span>Jurnal</span>
    </a>

    <a asp-controller="AiAssistant" asp-action="Index"
       class="mnav-item @(controller == "AiAssistant" ? "active" : "")">
        <i class="bi bi-robot"></i>
        <span>AI</span>
    </a>

    <button type="button" class="mnav-item" data-bs-toggle="offcanvas" data-bs-target="#mobileReportsPanel">
        <i class="bi bi-folder"></i>
        <span>Laporan</span>
    </button>

    <button type="button" class="mnav-item" data-bs-toggle="offcanvas" data-bs-target="#mobileMorePanel">
        <i class="bi bi-grid-3x3-gap"></i>
        <span>Lainnya</span>
    </button>
</nav>

<!-- Offcanvas: Reports (dipakai khusus HP) -->
<div class="offcanvas offcanvas-bottom" tabindex="-1" id="mobileReportsPanel" style="height: 70vh;">
    <div class="offcanvas-header border-bottom">
        <h6 class="offcanvas-title text-uppercase fw-bold">Laporan</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-2">
        <div class="list-group list-group-flush">
            <a asp-controller="GeneralJournal" asp-action="Index" class="list-group-item list-group-item-action bg-transparent">General Journal</a>
            <a asp-controller="Reports" asp-action="GeneralLedger" class="list-group-item list-group-item-action bg-transparent">GL (Permanent Accounts)</a>
            <a asp-controller="Reports" asp-action="GeneralLedgerTemporary" class="list-group-item list-group-item-action bg-transparent">GL (Temporary Accounts)</a>
            <a asp-controller="Reports" asp-action="TrialBalance" class="list-group-item list-group-item-action bg-transparent">Trial Balance</a>
            <a asp-controller="AdjustingJournal" asp-action="Index" class="list-group-item list-group-item-action bg-transparent">Adjusting Journal</a>
            <a asp-controller="Reports" asp-action="AdjustedTrialBalance" class="list-group-item list-group-item-action bg-transparent">Adjusted Trial Balance</a>
            <a asp-controller="Reports" asp-action="Worksheet" class="list-group-item list-group-item-action bg-transparent">Worksheet</a>
            <a asp-controller="Reports" asp-action="IncomeStatement" class="list-group-item list-group-item-action bg-transparent">Income Statement</a>
            <a asp-controller="Reports" asp-action="RetainedEarnings" class="list-group-item list-group-item-action bg-transparent">Retained Earnings</a>
            <a asp-controller="Reports" asp-action="StatementOfFinancialPosition" class="list-group-item list-group-item-action bg-transparent">Financial Position</a>
            <a asp-controller="Reports" asp-action="ClosingJournal" class="list-group-item list-group-item-action bg-transparent">Closing Journal</a>
            <a asp-controller="Reports" asp-action="PostClosingTrialBalance" class="list-group-item list-group-item-action bg-transparent">Post-Closing TB</a>
            <a asp-controller="Reports" asp-action="CashFlowStatement" class="list-group-item list-group-item-action bg-transparent">Cash Flow Statement</a>
        </div>
    </div>
</div>

<!-- Offcanvas: Menu Lainnya (dipakai khusus HP) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="mobileMorePanel">
    <div class="offcanvas-header border-bottom">
        <h6 class="offcanvas-title text-uppercase fw-bold">Menu</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-2">
        <div class="list-group list-group-flush mb-3">
            <a asp-controller="ChartOfAccounts" asp-action="Index" class="list-group-item list-group-item-action bg-transparent d-flex align-items-center gap-2">
                <i class="bi bi-diagram-3"></i> Chart of Accounts
            </a>
            <a asp-controller="Periods" asp-action="Index" class="list-group-item list-group-item-action bg-transparent d-flex align-items-center gap-2">
                <i class="bi bi-calendar3"></i> Financial Periods
            </a>
            <a asp-controller="Document" asp-action="Index" class="list-group-item list-group-item-action bg-transparent d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-text"></i> Economic Documents
            </a>
            <a asp-controller="Guardian" asp-action="Index" class="list-group-item list-group-item-action bg-transparent d-flex align-items-center gap-2">
                <i class="bi bi-shield-check"></i> Guardian Security
            </a>
            <a asp-controller="MobileClassification" asp-action="Index" class="list-group-item list-group-item-action bg-transparent d-flex align-items-center gap-2">
                <i class="bi bi-phone"></i> Mobile Classification
            </a>
            <a asp-controller="Tools" asp-action="Index" class="list-group-item list-group-item-action bg-transparent d-flex align-items-center gap-2">
                <i class="bi bi-tools"></i> Tools
            </a>
        </div>

        <div class="list-group list-group-flush">
            <a asp-controller="Settings" asp-action="Index" class="list-group-item list-group-item-action bg-transparent d-flex align-items-center gap-2">
                <i class="bi bi-gear"></i> Settings
            </a>
            <a asp-controller="Auth" asp-action="Logout" class="list-group-item list-group-item-action bg-transparent text-danger d-flex align-items-center gap-2">
                <i class="bi bi-box-arrow-right"></i> Sign Out
            </a>
        </div>
    </div>
</div>
