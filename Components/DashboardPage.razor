@using System.Globalization
@using AumoFinance.Models
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject IJSRuntime JS
@inject NavigationManager Nav

<style>
    /* Styling High-Tech & Glassmorphism Elegan (upgrade-fut2) */
    .tracking-wider { letter-spacing: 0.05em; }
    .fs-8 { font-size: 0.75rem; }

    .glass-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    [data-bs-theme="light"] .glass-card {
        background: rgba(255, 255, 255, 0.85);
        border-color: rgba(0, 0, 0, 0.06) !important;
    }

    .glow-hover-success:hover { border-color: rgba(25, 135, 84, 0.4) !important; box-shadow: 0 8px 25px -6px rgba(25, 135, 84, 0.25) !important; transform: translateY(-3px); }
    .glow-hover-primary:hover { border-color: rgba(13, 110, 253, 0.4) !important; box-shadow: 0 8px 25px -6px rgba(13, 110, 253, 0.25) !important; transform: translateY(-3px); }
    .glow-hover-danger:hover { border-color: rgba(220, 53, 69, 0.4) !important; box-shadow: 0 8px 25px -6px rgba(220, 53, 69, 0.25) !important; transform: translateY(-3px); }

    .gradient-neon-blue {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        box-shadow: 0 8px 20px -5px rgba(13, 110, 253, 0.4);
    }

    .icon-square {
        width: 36px; height: 36px;
        display: flex; align-items: center; justify-content: center;
    }

    .pulse-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background-color: #198754;
        box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7);
        animation: pulse-animation 1.8s infinite;
    }
    @@keyframes pulse-animation {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(25, 135, 84, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); }
    }

    .health-circle {
        width: 60px; height: 60px;
        border-radius: 50%;
        background: conic-gradient(var(--bs-primary) var(--score-deg), rgba(255,255,255,0.1) 0deg);
        display: flex; align-items: center; justify-content: center;
        position: relative;
    }
    .health-circle::before {
        content: ""; position: absolute;
        width: 48px; height: 48px;
        border-radius: 50%;
        background: var(--bs-body-bg);
    }
    .health-circle span { position: relative; z-index: 1; }

    .cmd-badge {
        font-size: 0.7rem; padding: 2px 6px; border-radius: 4px;
        background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.2);
    }
    .chart-container { position: relative; height: 280px; }
    .account-item { transition: background-color 0.15s ease; }
    .account-item:hover { background-color: rgba(255,255,255,0.04); }
</style>

<div class="container-fluid px-0">
    @if (!model.HasSelectedPeriod)
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-eye-slash text-secondary mb-3 d-block" style="font-size: 3rem;"></i>
            <h4 class="fw-bold text-body-emphasis mb-2">No Period Selected</h4>
            <p class="text-secondary mb-4">
                The Dashboard follows whichever period you're viewing.<br />
                Go to <strong>Periods</strong> and click <i class="bi bi-eye"></i> on a period to see its data here.
            </p>
            <a href="/Periods" class="btn btn-primary fw-semibold shadow-sm px-4">
                <i class="bi bi-calendar3 me-1"></i> Go to Periods
            </a>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="pulse-dot"></span>
                    <h4 class="fw-bold mb-0">Financial Overview</h4>
                </div>
                <p class="text-secondary small mb-0">
                    Active Period: <span class="fw-semibold text-body">@model.ActivePeriodName</span>
                    @if (model.ActivePeriodStart.HasValue && model.ActivePeriodEnd.HasValue)
                    {
                        <span class="ms-1 opacity-75">
                            (@model.ActivePeriodStart.Value.ToString("dd MMM yyyy") &ndash; @model.ActivePeriodEnd.Value.ToString("dd MMM yyyy"))
                        </span>
                    }
                    &middot; <i class="bi bi-clock-history me-1"></i> Live updated
                </p>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Monthly vs Annual Switch Toggle -->
                <div class="btn-group btn-group-sm p-1 bg-body-tertiary border border-opacity-10 rounded-pill shadow-sm" role="group" aria-label="Period Switch">
                    <button type="button" @onclick='() => SwitchPeriod("monthly")'
                            class="btn btn-sm rounded-pill px-3 fw-semibold transition-all @(periodType == "monthly" ? "btn-primary shadow-sm" : "btn-link text-body text-decoration-none opacity-75")">
                        Monthly
                    </button>
                    <button type="button" @onclick='() => SwitchPeriod("annual")'
                            class="btn btn-sm rounded-pill px-3 fw-semibold transition-all @(periodType == "annual" ? "btn-primary shadow-sm" : "btn-link text-body text-decoration-none opacity-75")">
                        Annual
                    </button>
                </div>

                <a href="/JournalEntry/Create" class="btn btn-warning btn-sm fw-semibold shadow-sm d-flex align-items-center gap-2 px-3 rounded-3">
                    <i class="bi bi-plus-lg"></i> New Entry
                </a>
                <a href="/Reports/IncomeStatement" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 px-3 rounded-3">
                    <i class="bi bi-file-earmark-bar-graph"></i> Report
                </a>
            </div>
        </div>

        <!-- Row 1: Predictive & Financial Health Widgets -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Financial Health Index</span>
                        <i class="bi bi-activity text-primary fs-5"></i>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="position-relative d-inline-flex align-items-center justify-content-center">
                            <div class="health-circle" style="--score-deg: @(model.FinancialHealthScore * 3.6)deg;">
                                <span class="fw-bold fs-4 text-body">@model.FinancialHealthScore</span>
                            </div>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">
                                @if (model.FinancialHealthScore >= 80)
                                {
                                    <span class="text-success">Excellent Condition</span>
                                }
                                else if (model.FinancialHealthScore >= 60)
                                {
                                    <span class="text-info">Stable Operations</span>
                                }
                                else
                                {
                                    <span class="text-warning">Attention Required</span>
                                }
                            </h6>
                            <p class="text-secondary fs-8 mb-0">Analyzed from liquidity, debt coverage, and net profit margin.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Cash Runway &amp; Burn Rate</span>
                        <i class="bi bi-speedometer2 text-warning fs-5"></i>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <h4 class="fw-bold mb-0">
                            @(double.IsNaN(model.CashRunwayMonths) || double.IsInfinity(model.CashRunwayMonths) || model.CashRunwayMonths >= 99
                                ? "∞"
                                : model.CashRunwayMonths.ToString("0.0"))
                            <span class="fs-6 text-secondary fw-normal">Months Runway</span>
                        </h4>
                        <span class="fs-8 text-secondary">Burn: <strong class="text-body">@model.MonthlyBurnRate.ToString("C0", Idr)</strong>/mo</span>
                    </div>
                    <div class="progress rounded-pill bg-body-tertiary" style="height: 8px;">
                        <div class="progress-bar @(model.CashRunwayMonths > 6 ? "bg-success" : (model.CashRunwayMonths > 3 ? "bg-warning" : "bg-danger")) rounded-pill"
                             role="progressbar"
                             style="width: @(Math.Min(model.CashRunwayMonths * 8.3, 100))%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: Standard KPI Cards -->
        <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3 glow-hover-success">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Cash &amp; Equivalents</span>
                        <div class="icon-square bg-success-subtle text-success rounded-3"><i class="bi bi-wallet2"></i></div>
                    </div>
                    <h4 class="fw-bold mb-1">@model.TotalCashAndEquivalents.ToString("C0", Idr)</h4>
                    <div class="small text-secondary fs-8">Liquid Reserves</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3 glow-hover-primary">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Revenue</span>
                        <div class="icon-square bg-primary-subtle text-primary rounded-3"><i class="bi bi-graph-up-arrow"></i></div>
                    </div>
                    <h4 class="fw-bold text-primary mb-1">@model.RevenueThisPeriod.ToString("C0", Idr)</h4>
                    <div class="small @(model.RevenueTrendPercent.HasValue ? (model.RevenueTrendPercent >= 0 ? "text-success" : "text-danger") : "text-secondary") fs-8 fw-semibold">
                        @if (model.RevenueTrendPercent.HasValue)
                        {
                            <i class="bi @(model.RevenueTrendPercent >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                            <span>@(Math.Abs(model.RevenueTrendPercent.Value).ToString("0.0"))% vs prior</span>
                        }
                        else
                        {
                            <span>&mdash;</span>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3 glow-hover-danger">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Expenses</span>
                        <div class="icon-square bg-danger-subtle text-danger rounded-3"><i class="bi bi-arrow-down-left-circle"></i></div>
                    </div>
                    <h4 class="fw-bold text-danger mb-1">@model.OperatingExpenses.ToString("C0", Idr)</h4>
                    <div class="small @(model.ExpenseTrendPercent.HasValue ? (model.ExpenseTrendPercent <= 0 ? "text-success" : "text-danger") : "text-secondary") fs-8 fw-semibold">
                        @if (model.ExpenseTrendPercent.HasValue)
                        {
                            <i class="bi @(model.ExpenseTrendPercent >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                            <span>@(Math.Abs(model.ExpenseTrendPercent.Value).ToString("0.0"))% vs prior</span>
                        }
                        else
                        {
                            <span>&mdash;</span>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 p-3 text-white gradient-neon-blue">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-semibold text-white-50 text-uppercase tracking-wider">Net Income</span>
                        <i class="bi bi-shield-check text-warning fs-5"></i>
                    </div>
                    <h4 class="fw-bold mb-1">@model.NetIncome.ToString("C0", Idr)</h4>
                    <div class="small text-white-50 fs-8 fw-semibold">
                        @if (model.NetIncomeTrendPercent.HasValue)
                        {
                            <i class="bi @(model.NetIncomeTrendPercent >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                            <span>@(Math.Abs(model.NetIncomeTrendPercent.Value).ToString("0.0"))% vs prior</span>
                        }
                        else
                        {
                            <span>&mdash;</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 3: Assets & Liabilities -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6">
                <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-secondary small fw-semibold text-uppercase tracking-wider d-block">Total Assets</span>
                            <h5 class="fw-bold mb-0 mt-1">@model.TotalAssets.ToString("C0", Idr)</h5>
                        </div>
                        <div class="icon-square bg-info-subtle text-info rounded-3 fs-5"><i class="bi bi-building"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-secondary small fw-semibold text-uppercase tracking-wider d-block">Total Liabilities</span>
                            <h5 class="fw-bold mb-0 mt-1">@model.TotalLiabilities.ToString("C0", Idr)</h5>
                        </div>
                        <div class="icon-square bg-warning-subtle text-warning rounded-3 fs-5"><i class="bi bi-credit-card"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-xl-8">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-bold mb-0">Financial Trend</h6>
                            <span class="text-secondary fs-8">Revenue vs Operating Expenses</span>
                        </div>
                        <div class="icon-square bg-primary-subtle text-primary rounded-3">
                            <i class="bi bi-graph-up"></i>
                        </div>
                    </div>
                    <div class="chart-container" style="position: relative; height: 280px;">
                        <canvas id="trendChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-bold mb-0">Expense Composition</h6>
                            <span class="text-secondary fs-8">Breakdown by Account</span>
                        </div>
                        <div class="icon-square bg-danger-subtle text-danger rounded-3">
                            <i class="bi bi-pie-chart"></i>
                        </div>
                    </div>

                    @if (model.HasExpenseData)
                    {
                        <div class="chart-container" style="position: relative; height: 280px;">
                            <canvas id="expenseDoughnut"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-secondary py-4 d-flex flex-column align-items-center justify-content-center h-100">
                            <i class="bi bi-pie-chart fs-1 d-block mb-2 opacity-50"></i>
                            <span>No expense data for this period.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Tables -->
        <div class="row g-3">
            <div class="col-12 col-xl-6">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0">Key Accounts Overview</h6>
                        <a href="/ChartOfAccounts" class="btn btn-link btn-sm text-decoration-none p-0 fs-8 fw-semibold">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-borderless align-middle mb-0">
                            <thead class="text-secondary fs-8 border-bottom">
                                <tr>
                                    <th>CODE</th>
                                    <th>ACCOUNT NAME</th>
                                    <th class="text-end">BALANCE</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @if (model.MainCoaBalances.Any())
                                {
                                    @foreach (var item in model.MainCoaBalances)
                                    {
                                        <tr class="account-item">
                                            <td class="fw-bold text-secondary">@item.AccountCode</td>
                                            <td class="fw-semibold">@item.AccountName</td>
                                            <td class="text-end fw-bold">@item.Balance.ToString("C0", Idr)</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-secondary py-3">No account balances found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0">Recent Activity</h6>
                        <a href="/JournalEntry" class="btn btn-link btn-sm text-decoration-none p-0 fs-8 fw-semibold">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-borderless align-middle mb-0">
                            <thead class="text-secondary fs-8 border-bottom">
                                <tr>
                                    <th>DATE</th>
                                    <th class="text-end">DEBIT</th>
                                    <th class="text-end">CREDIT</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @if (model.RecentJournals.Any())
                                {
                                    @foreach (var journal in model.RecentJournals)
                                    {
                                        <tr class="account-item">
                                            <td class="text-secondary">@journal.Date.ToString("dd MMM yyyy")</td>
                                            <td class="text-end fw-semibold text-success">@journal.TotalDebit.ToString("C0", Idr)</td>
                                            <td class="text-end fw-semibold text-danger">@journal.TotalCredit.ToString("C0", Idr)</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-secondary py-3">No recent journals recorded.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Command Palette Modal (Ctrl + K) -->
<div class="modal fade" id="commandPaletteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="p-3 border-bottom border-secondary border-opacity-10 d-flex align-items-center gap-2">
                <i class="bi bi-search text-secondary"></i>
                <input type="text" id="cmdInput" class="form-control border-0 bg-transparent shadow-none" placeholder="Type a command or page name..." autofocus>
                <span class="cmd-badge text-secondary">ESC</span>
            </div>
            <div class="list-group list-group-flush small py-2">
                <a href="/JournalEntry/Create" class="list-group-item list-group-item-action bg-transparent border-0 px-3 py-2 text-body d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-plus-circle me-2 text-primary"></i> Create New Journal Entry</span>
                    <span class="cmd-badge text-secondary">Action</span>
                </a>
                <a href="/ai" class="list-group-item list-group-item-action bg-transparent border-0 px-3 py-2 text-body d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-robot me-2 text-warning"></i> Open AI Financial Controller</span>
                    <span class="cmd-badge text-secondary">AI</span>
                </a>
                <a href="/Reports/IncomeStatement" class="list-group-item list-group-item-action bg-transparent border-0 px-3 py-2 text-body d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-file-earmark-bar-graph me-2 text-info"></i> View Income Statement</span>
                    <span class="cmd-badge text-secondary">Report</span>
                </a>
                <a href="/ChartOfAccounts" class="list-group-item list-group-item-action bg-transparent border-0 px-3 py-2 text-body d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-diagram-3 me-2 text-success"></i> Manage Chart of Accounts</span>
                    <span class="cmd-badge text-secondary">Setup</span>
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid UserId { get; set; }

    private static readonly CultureInfo Idr = new("id-ID");

    private DashboardViewModel model = new();
    private string periodType = "monthly";
    private bool chartsNeedRender;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("period", out var p) && p.ToString().Equals("annual", StringComparison.OrdinalIgnoreCase))
        {
            periodType = "annual";
        }

        await LoadDashboardAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initCommandPalette");
        }

        if (chartsNeedRender)
        {
            chartsNeedRender = false;
            await RenderChartsAsync();
        }
    }

    private async Task SwitchPeriod(string type)
    {
        if (periodType == type) return;
        periodType = type;
        await LoadDashboardAsync();
    }

    private async Task RenderChartsAsync()
    {
        await JS.InvokeVoidAsync("renderDashboardCharts", new
        {
            trendData = new
            {
                labels = model.ChartLabels,
                revenue = model.ChartRevenue,
                expenses = model.ChartExpenses
            },
            expenseData = new
            {
                labels = model.ExpenseCategoryLabels,
                values = model.ExpenseCategoryValues
            }
        });
    }

    private async Task LoadDashboardAsync()
    {
        var newModel = new DashboardViewModel();
        var isAnnual = periodType == "annual";

        var selectedPeriod = await SelectedPeriodHelper.GetSelectedPeriodAsync(DbContext, UserId);
        if (selectedPeriod == null)
        {
            newModel.HasSelectedPeriod = false;
            model = newModel;
            return;
        }

        newModel.HasSelectedPeriod = true;
        newModel.IsSelectedPeriodClosed = selectedPeriod.IsClosed;

        DateTime periodStart;
        DateTime periodEnd;

        if (isAnnual)
        {
            var year = selectedPeriod.StartDate.Year;
            periodStart = DateTime.SpecifyKind(new DateTime(year, 1, 1, 0, 0, 0), DateTimeKind.Utc);
            periodEnd = DateTime.SpecifyKind(new DateTime(year, 12, 31, 23, 59, 59), DateTimeKind.Utc);
            newModel.ActivePeriodName = $"Year {year}";
        }
        else
        {
            periodStart = DateTime.SpecifyKind(selectedPeriod.StartDate, DateTimeKind.Utc);
            periodEnd = DateTime.SpecifyKind(selectedPeriod.EndDate, DateTimeKind.Utc);
            newModel.ActivePeriodName = selectedPeriod.PeriodName;
        }

        newModel.ActivePeriodStart = periodStart;
        newModel.ActivePeriodEnd = periodEnd;

        var accounts = await DbContext.ChartOfAccounts
            .Where(a => a.IsActive && a.UserId == UserId)
            .OrderBy(a => a.ReferenceNumber)
            .ToListAsync();

        var lines = await DbContext.JournalEntryLines
            .Include(l => l.JournalEntry)
            .Include(l => l.Account)
            .Where(l => l.JournalEntry != null && l.JournalEntry.UserId == UserId && l.JournalEntry.EntryDate <= periodEnd)
            .ToListAsync();

        var accountBalances = new Dictionary<int, decimal>();
        foreach (var account in accounts)
        {
            var normalDebit = IsNormalBalanceDebitSafe(account.Type);
            var accountLines = lines.Where(l => l.AccountId == account.Id);
            var net = normalDebit
                ? accountLines.Sum(l => l.Debit - l.Credit)
                : accountLines.Sum(l => l.Credit - l.Debit);
            accountBalances[account.Id] = net;
        }

        newModel.TotalCashAndEquivalents = accounts
            .Where(a => a.Role == "CashAndEquivalents")
            .Sum(a => accountBalances.GetValueOrDefault(a.Id));

        newModel.TotalAssets = accounts
            .Where(a => a.Type == "Assets")
            .Sum(a => accountBalances.GetValueOrDefault(a.Id));

        newModel.TotalLiabilities = accounts
            .Where(a => a.Type == "Liabilities")
            .Sum(a => accountBalances.GetValueOrDefault(a.Id));

        var filteredLines = lines.Where(l =>
            l.JournalEntry!.EntryDate >= periodStart &&
            l.JournalEntry!.EntryDate <= periodEnd).ToList();

        decimal SumByType(string type)
        {
            var ids = accounts.Where(a => a.Type == type).Select(a => a.Id).ToHashSet();
            var normalDebit = IsNormalBalanceDebitSafe(type);
            var relevant = filteredLines.Where(l => ids.Contains(l.AccountId));
            return normalDebit
                ? relevant.Sum(l => l.Debit - l.Credit)
                : relevant.Sum(l => l.Credit - l.Debit);
        }

        newModel.RevenueThisPeriod = SumByType("OperatingIncome") + SumByType("OtherIncome");
        newModel.OperatingExpenses = SumByType("OperatingExpenses") + SumByType("OtherExpenses");
        newModel.NetIncome = newModel.RevenueThisPeriod - newModel.OperatingExpenses;

        DateTime priorStart = isAnnual ? periodStart.AddYears(-1) : periodStart.AddMonths(-1);
        DateTime priorEnd = isAnnual ? periodEnd.AddYears(-1) : periodStart.AddDays(-1);

        var priorLines = lines.Where(l =>
            l.JournalEntry!.EntryDate >= priorStart &&
            l.JournalEntry!.EntryDate <= priorEnd).ToList();

        decimal PriorSumByType(string type)
        {
            var ids = accounts.Where(a => a.Type == type).Select(a => a.Id).ToHashSet();
            var normalDebit = IsNormalBalanceDebitSafe(type);
            var relevant = priorLines.Where(l => ids.Contains(l.AccountId));
            return normalDebit
                ? relevant.Sum(l => l.Debit - l.Credit)
                : relevant.Sum(l => l.Credit - l.Debit);
        }

        var priorRevenue = PriorSumByType("OperatingIncome") + PriorSumByType("OtherIncome");
        var priorExpenses = PriorSumByType("OperatingExpenses") + PriorSumByType("OtherExpenses");
        var priorNet = priorRevenue - priorExpenses;

        newModel.RevenueTrendPercent = CalcTrend(newModel.RevenueThisPeriod, priorRevenue);
        newModel.ExpenseTrendPercent = CalcTrend(newModel.OperatingExpenses, priorExpenses);
        newModel.NetIncomeTrendPercent = CalcTrend(newModel.NetIncome, priorNet);
        newModel.CashTrendPercent = null;

        var monthly = lines
            .GroupBy(l => new { l.JournalEntry!.EntryDate.Year, l.JournalEntry!.EntryDate.Month })
            .OrderBy(g => g.Key.Year).ThenBy(g => g.Key.Month)
            .TakeLast(isAnnual ? 12 : 7)
            .ToList();

        foreach (var g in monthly)
        {
            var label = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMM yy");
            newModel.ChartLabels.Add(label);

            var revIds = accounts.Where(a => a.Type is "OperatingIncome" or "OtherIncome").Select(a => a.Id).ToHashSet();
            var expIds = accounts.Where(a => a.Type is "OperatingExpenses" or "OtherExpenses").Select(a => a.Id).ToHashSet();

            var revenue = g.Where(l => revIds.Contains(l.AccountId)).Sum(l => l.Credit - l.Debit);
            var expense = g.Where(l => expIds.Contains(l.AccountId)).Sum(l => l.Debit - l.Credit);

            newModel.ChartRevenue.Add(revenue);
            newModel.ChartExpenses.Add(expense);
        }

        var expenseAccounts = accounts.Where(a => a.Type is "OperatingExpenses" or "OtherExpenses").ToList();
        foreach (var acc in expenseAccounts)
        {
            var amount = filteredLines
                .Where(l => l.AccountId == acc.Id)
                .Sum(l => l.Debit - l.Credit);

            if (amount != 0)
            {
                newModel.ExpenseCategoryLabels.Add(acc.AccountName);
                newModel.ExpenseCategoryValues.Add(amount);
            }
        }

        var keyRoles = new[] { "CashAndEquivalents", "AccountsReceivable", "AccountsPayable" };
        var keyAccounts = accounts
            .Where(a => (a.Role != null && keyRoles.Contains(a.Role)) || a.Type == "Equity")
            .OrderBy(a => a.ReferenceNumber)
            .Take(6)
            .ToList();

        foreach (var acc in keyAccounts)
        {
            newModel.MainCoaBalances.Add(new CoaBalanceDto
            {
                AccountCode = acc.ReferenceNumber.ToString(),
                AccountName = acc.AccountName,
                Category = acc.Type ?? "Other",
                Balance = accountBalances.GetValueOrDefault(acc.Id)
            });
        }

        newModel.RecentJournals = await DbContext.JournalEntries
            .Where(j => j.UserId == UserId && j.EntryDate >= periodStart && j.EntryDate <= periodEnd)
            .OrderByDescending(j => j.EntryDate)
            .ThenByDescending(j => j.Id)
            .Take(8)
            .Select(j => new JournalEntryDto
            {
                Date = j.EntryDate,
                TotalDebit = j.Lines.Sum(l => l.Debit),
                TotalCredit = j.Lines.Sum(l => l.Credit)
            })
            .ToListAsync();

        newModel.MonthlyBurnRate = isAnnual ? (newModel.OperatingExpenses / 12m) : newModel.OperatingExpenses;

        if (newModel.MonthlyBurnRate > 0)
        {
            newModel.CashRunwayMonths = (double)Math.Round(newModel.TotalCashAndEquivalents / newModel.MonthlyBurnRate, 1);
        }
        else
        {
            newModel.CashRunwayMonths = 99;
        }

        int healthScore = 50;
        if (newModel.TotalLiabilities > 0)
        {
            var quickRatio = newModel.TotalCashAndEquivalents / newModel.TotalLiabilities;
            if (quickRatio >= 1.5m) healthScore += 25;
            else if (quickRatio >= 1.0m) healthScore += 15;
            else if (quickRatio >= 0.5m) healthScore += 5;
        }
        else
        {
            healthScore += 25;
        }

        if (newModel.NetIncome > 0) healthScore += 25;
        else if (newModel.NetIncome < 0) healthScore -= 15;

        newModel.FinancialHealthScore = Math.Clamp(healthScore, 10, 100);

        model = newModel;
        chartsNeedRender = true;
    }

    private static bool IsNormalBalanceDebitSafe(string? type)
    {
        if (string.IsNullOrWhiteSpace(type)) return true;

        try
        {
            return AccountClassification.NormalBalanceIsDebit(type);
        }
        catch
        {
            return type is "Assets" or "OperatingExpenses" or "OtherExpenses";
        }
    }

    private static decimal? CalcTrend(decimal current, decimal prior)
    {
        if (prior == 0) return current == 0 ? 0 : null;
        return Math.Round((current - prior) / Math.Abs(prior) * 100m, 1);
    }
}
