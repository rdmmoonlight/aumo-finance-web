@using AumoFinance.Models

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="pulse-dot"></span>
            <h4 class="fw-bold mb-0 text-white">Financial Overview</h4>
        </div>
        <p class="text-white-50 small mb-0">
            Active Period: <span class="fw-semibold text-white">@Model.ActivePeriodName</span>
            @if (Model.ActivePeriodStart.HasValue && Model.ActivePeriodEnd.HasValue)
            {
                <span class="ms-1 text-white-50">
                    (@Model.ActivePeriodStart.Value.ToString("dd MMM yyyy") &ndash; @Model.ActivePeriodEnd.Value.ToString("dd MMM yyyy"))
                </span>
            }
            &middot; <i class="bi bi-clock-history me-1"></i> <span class="fw-bold live-neon-text">Live updated</span>
        </p>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group btn-group-sm p-1 bg-body-tertiary border border-opacity-10 rounded-pill shadow-sm" role="group">
            <button type="button" @onclick='() => OnPeriodSwitch.InvokeAsync("monthly")'
                    class="btn btn-sm rounded-pill px-3 fw-semibold transition-all @(PeriodType == "monthly" ? "btn-primary shadow-sm" : "btn-link text-white text-decoration-none opacity-75")">
                Monthly
            </button>
            <button type="button" @onclick='() => OnPeriodSwitch.InvokeAsync("annual")'
                    class="btn btn-sm rounded-pill px-3 fw-semibold transition-all @(PeriodType == "annual" ? "btn-primary shadow-sm" : "btn-link text-white text-decoration-none opacity-75")">
                Annual
            </button>
        </div>

        <a href="/JournalEntry/Create" class="btn btn-warning btn-sm fw-semibold shadow-sm d-flex align-items-center gap-2 px-3 rounded-3">
            <i class="bi bi-plus-lg"></i> New Entry
        </a>
        <a href="/Reports/IncomeStatement" class="btn btn-outline-light btn-sm d-flex align-items-center gap-2 px-3 rounded-3">
            <i class="bi bi-file-earmark-bar-graph"></i> Report
        </a>
    </div>
</div>

<style>
    .pulse-dot {
        width: 8px; height: 8px; border-radius: 50%; background-color: #00ff66;
        box-shadow: 0 0 10px #00ff66, 0 0 20px #00ff66; animation: pulse-animation 1.5s infinite;
    }
    @@keyframes pulse-animation {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.9); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 255, 102, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0); }
    }
    .live-neon-text {
        color: #00ff66 !important; text-shadow: 0 0 8px rgba(0, 255, 102, 0.8), 0 0 20px rgba(0, 255, 102, 0.5);
        animation: neon-blink 1.2s ease-in-out infinite alternate;
    }
    @@keyframes neon-blink {
        0% { opacity: 0.4; text-shadow: 0 0 2px rgba(0, 255, 102, 0.4); }
        100% { opacity: 1; text-shadow: 0 0 12px rgba(0, 255, 102, 1), 0 0 25px rgba(0, 255, 102, 0.8); }
    }
</style>

@code {
    [Parameter] public DashboardViewModel Model { get; set; } = new();
    [Parameter] public string PeriodType { get; set; } = "monthly";
    [Parameter] public EventCallback<string> OnPeriodSwitch { get; set; }
}
