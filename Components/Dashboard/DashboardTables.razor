@using System.Globalization
@using AumoFinance.Models

<!-- Recent Tables -->
<div class="row g-3">
    <div class="col-12 col-xl-6">
        <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0 text-white">Key Accounts Overview</h6>
                <a href="/ChartOfAccounts" class="btn btn-link btn-sm text-decoration-none p-0 fs-8 fw-semibold text-info">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle mb-0 text-white">
                    <thead class="text-white-50 fs-8 border-bottom border-secondary">
                        <tr>
                            <th>CODE</th>
                            <th>ACCOUNT NAME</th>
                            <th class="text-end">BALANCE</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.MainCoaBalances.Any())
                        {
                            @foreach (var item in Model.MainCoaBalances)
                            {
                                <tr class="account-item">
                                    <td class="fw-bold text-white-50">@item.AccountCode</td>
                                    <td class="fw-semibold text-white">@item.AccountName</td>
                                    <td class="text-end fw-bold text-white">@item.Balance.ToString("C0", Idr)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-white-50 py-3">No account balances found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0 text-white">Recent Activity</h6>
                <a href="/JournalEntry" class="btn btn-link btn-sm text-decoration-none p-0 fs-8 fw-semibold text-info">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle mb-0 text-white">
                    <thead class="text-white-50 fs-8 border-bottom border-secondary">
                        <tr>
                            <th>DATE</th>
                            <th class="text-end">DEBIT</th>
                            <th class="text-end">CREDIT</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.RecentJournals.Any())
                        {
                            @foreach (var journal in Model.RecentJournals)
                            {
                                <tr class="account-item">
                                    <td class="text-white-50">@journal.Date.ToString("dd MMM yyyy")</td>
                                    <td class="text-end fw-semibold text-success">@journal.TotalDebit.ToString("C0", Idr)</td>
                                    <td class="text-end fw-semibold text-danger">@journal.TotalCredit.ToString("C0", Idr)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-white-50 py-3">No recent journals recorded.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public DashboardViewModel Model { get; set; } = new();
    [Parameter] public CultureInfo Idr { get; set; } = new("id-ID");
}
