<!DOCTYPE html>
<html lang="en-US" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Grid / Reset CSS Dasar (Wajib agar Layout Home & Sidebar sejajar/Flexbox berjalan) -->
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />

    <!-- Custom App Theme Styles -->
    <link rel="stylesheet" href="css/guardian.css" />
    <link rel="stylesheet" href="css/theme.css" />

    <!-- BLAZOR CSS ISOLATION (Memuat Sidebar.razor.css & komponen terisolasi lainnya) -->
    <link rel="stylesheet" href="AumoFinance.styles.css" />

    <!-- Instant Theme Loader -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('aumo_theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <!-- UI Penanganan Error Blazor -->
    <div id="blazor-error-ui" class="alert alert-danger fixed-bottom m-3 d-none" role="alert">
        An unhandled error has occurred.
        <a href="" class="reload link-primary">Reload</a>
        <a class="dismiss link-secondary">🗙</a>
    </div>

    <!-- Custom UI Script -->
    <script src="js/aumo-ui.js"></script>
    <script src="js/site.js"></script>

    <script>
        window.setAppTheme = function(themeName) {
            document.documentElement.setAttribute('data-bs-theme', themeName);
            localStorage.setItem('aumo_theme', themeName);
        };
    </script>

    <script src="_framework/blazor.web.js"></script>
    <script src="js/quran-banner.js"></script>
    <script src="js/guardian.js"></script>
</body>

</html>
