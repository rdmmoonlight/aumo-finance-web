<!-- ==========================================
     Aumo Finance Theme Controller
     ========================================== -->

<script>
    window.setAppTheme = function (themeName) {
        const theme =
            themeName === 'light'
                ? 'light'
                : 'dark';

        document.documentElement.setAttribute(
            'data-bs-theme',
            theme
        );

        localStorage.setItem(
            'aumo_theme',
            theme
        );
    };
</script>


