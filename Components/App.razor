<!DOCTYPE html>
<html lang="en-US" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />

    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Aumo Theme Styles -->
    <link rel="stylesheet" href="/css/guardian.css" />
    <link rel="stylesheet" href="/css/theme/theme.css" />
    <link rel="stylesheet" href="/css/theme/topbar.css" />
    <link rel="stylesheet" href="/css/theme/sidebar.css" />

    <!-- Instant Theme Loader (Mencegah Layar Kedip Saat Load) -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('aumo_theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <!-- Aktifkan Interaktivitas untuk Meta Head -->
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes />

    <!-- UI Penanganan Error Blazor -->
    <div id="blazor-error-ui" class="alert alert-danger fixed-bottom m-3 d-none" role="alert">
        An unhandled error has occurred.
        <a href="" class="reload link-primary">Reload</a>
        <a class="dismiss link-secondary">🗙</a>
    </div>

    <!-- JS Dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Global Site Script (Menyediakan window.aumoModal & window.aumoTheme) -->
    <script src="js/site.js"></script>

    <!-- Global Theme Controller Function (Fallback) -->
    <script>
        window.setAppTheme = function(themeName) {
            document.documentElement.setAttribute('data-bs-theme', themeName);
            localStorage.setItem('aumo_theme', themeName);
        };
    </script>

    <!-- Framework Blazor Core -->
    <script src="_framework/blazor.web.js"></script>

    <!-- Custom Scripts Tambahan -->
    <script src="js/quran-banner.js"></script>
    <script src="js/guardian.js"></script>
</body>

</html>
