<!DOCTYPE html>
<html lang="en-US" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />
    
    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Aumo Theme -->
    <link rel="stylesheet" href="css/theme.css" />
    <link rel="stylesheet" href="css/guardian.css" />
    <link rel="stylesheet" href="AumoFinance.styles.css" /> <!-- CSS Isolation Blazor -->
    
    <!-- Instant Theme Loader -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('aumo_theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <HeadOutlet />
</head>

<body>
    <Routes />

    <!-- JS Dependencies -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            window.setAppTheme = function(themeName) {
                document.documentElement.setAttribute('data-bs-theme', themeName);
                localStorage.setItem('aumo_theme', themeName);
            };
        });
    </script>

    <script src="js/quran-banner.js"></script>
    <script src="js/guardian.js"></script>

    <!-- Script Blazor Web App (Gantikan _framework/blazor.server.js) -->
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
