<!DOCTYPE html>
<html lang="en-US" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Aumo Custom CSS Framework (tanpa dependensi Bootstrap) -->
    <link rel="stylesheet" href="/css/framework/01-reset.css" />
    <link rel="stylesheet" href="/css/framework/02-grid.css" />
    <link rel="stylesheet" href="/css/framework/03-utilities.css" />
    <link rel="stylesheet" href="/css/framework/04-buttons.css" />
    <link rel="stylesheet" href="/css/framework/05-forms.css" />
    <link rel="stylesheet" href="/css/framework/06-cards.css" />
    <link rel="stylesheet" href="/css/framework/07-tables.css" />
    <link rel="stylesheet" href="/css/framework/08-navigation.css" />
    <link rel="stylesheet" href="/css/framework/09-overlays.css" />
    <link rel="stylesheet" href="/css/framework/10-icons.css" />

    <!-- Aumo Theme Styles -->
    <link rel="stylesheet" href="/css/guardian.css" />
    <link rel="stylesheet" href="/css/theme/theme.css" />
    <link rel="stylesheet" href="/css/theme/topbar.css" />

    <!-- BLAZOR CSS ISOLATION (STANDAR MODERN .NET 10 / NET 9) -->
    <link rel="stylesheet" href="AumoFinance.styles.css" />

    <!-- Instant Theme Loader (Mencegah Layar Kedip Saat Load) -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('aumo_theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <!-- HeadOutlet untuk Interaktivitas SSR/InteractiveServer di .NET 10 -->
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <!-- UI Penanganan Error Blazor -->
    <div id="blazor-error-ui" class="alert alert-danger fixed-bottom m-3 d-none" role="alert">
        An unhandled error has occurred.
        <a href="" class="reload link-primary">Reload</a>
        <a class="dismiss link-secondary">🗙</a>
    </div>

    <!-- Aumo Custom UI Interactions (menggantikan bootstrap.bundle.min.js) -->
    <script src="js/aumo-ui.js"></script>

    <!-- Global Site Script -->
    <script src="js/site.js"></script>

    <!-- Global Theme Controller Function -->
    <script>
        window.setAppTheme = function(themeName) {
            document.documentElement.setAttribute('data-bs-theme', themeName);
            localStorage.setItem('aumo_theme', themeName);
        };
    </script>

    <!-- Framework Blazor Core Engine .NET 10 -->
    <script src="_framework/blazor.web.js"></script>

    <!-- Custom Scripts Tambahan -->
    <script src="js/quran-banner.js"></script>
    <script src="js/guardian.js"></script>
</body>

</html>
