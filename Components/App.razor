<!-- ==========================================
     Aumo Finance - Document Head
     Cosmic / Nebula Theme
     ========================================== -->

<!-- ==========================================
     Instant Theme Loader
     MUST execute before any theme-dependent CSS
     ========================================== -->

<script>
    (function () {
        const savedTheme = localStorage.getItem('aumo_theme');

        const theme =
            savedTheme === 'light' || savedTheme === 'dark'
                ? savedTheme
                : 'dark';

        document.documentElement.setAttribute(
            'data-bs-theme',
            theme
        );
    })();
</script>


