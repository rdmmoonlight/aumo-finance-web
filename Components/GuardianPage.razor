@using AumoFinance.Models
@using AumoFinance.Models.Security
@using AumoFinance.Services.Security
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject IGuardianService GuardianService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="container-fluid">

    <!-- Header & Overall Health Badge -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-shield-check text-warning me-2"></i>Guardian
            </h4>
            <small class="text-secondary">Security health monitoring, active sessions, and protection controls</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success fs-6">
                <i class="bi bi-heart-pulse-fill me-1"></i> Account Healthy
            </span>
        </div>
    </div>

    @if (successMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@successMessage
            <button type="button" class="btn-close btn-close-white" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- SUB-TABS NAVIGATION (Nav Pills) -->
    <ul class="nav nav-pills mb-4 border-bottom border-secondary pb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "health" ? "active" : "") fw-bold text-white" type="button" @onclick='() => activeTab = "health"'>
                <i class="bi bi-activity text-danger me-2"></i>Security Health
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "sessions" ? "active" : "") text-white fw-bold" type="button" @onclick='() => activeTab = "sessions"'>
                <i class="bi bi-laptop text-info me-2"></i>Active Sessions
                <span class="badge bg-secondary ms-1">@sessions.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "protection" ? "active" : "") text-white fw-bold" type="button" @onclick='() => activeTab = "protection"'>
                <i class="bi bi-sliders text-warning me-2"></i>Protection &amp; Logs
            </button>
        </li>
    </ul>

    <!-- TAB CONTENTS -->
    <div class="tab-content">

        <!-- ==================== TAB 1: SECURITY HEALTH ==================== -->
        <div class="tab-pane fade @(activeTab == "health" ? "show active" : "")">
            <div class="card bg-dark border-secondary">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-heart-pulse me-2"></i>Security &amp; Account Health Checkup</strong>
                    <small class="text-secondary">Automated Analysis</small>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush bg-transparent">

                        <div class="list-group-item bg-transparent text-white border-secondary p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold"><i class="bi bi-laptop text-info me-2"></i>Active Device Sessions</div>
                                <small class="text-secondary">Monitors how many devices are currently signed in.</small>
                            </div>
                            <div>
                                <span class="badge bg-success">@sessions.Count Active Session(s)</span>
                            </div>
                        </div>

                        <div class="list-group-item bg-transparent text-white border-secondary p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold"><i class="bi bi-key text-warning me-2"></i>Transaction PIN</div>
                                <small class="text-secondary">Secondary protection for sensitive financial actions.</small>
                            </div>
                            <div>
                                <span class="badge bg-warning text-dark me-2">Not Set</span>
                                <a href="#" class="btn btn-sm btn-outline-warning py-0">Set Up PIN</a>
                            </div>
                        </div>

                        <div class="list-group-item bg-transparent text-white border-secondary p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold"><i class="bi bi-shield-lock text-primary me-2"></i>Password Age</div>
                                <small class="text-secondary">Tracks when your password was last changed (Recommended: &lt; 90 days).</small>
                            </div>
                            <div>
                                <span class="badge bg-success me-2">Updated Recently</span>
                                <a href="#" class="btn btn-sm btn-outline-light py-0">Change</a>
                            </div>
                        </div>

                        <div class="list-group-item bg-transparent text-white border-secondary p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold"><i class="bi bi-shield-exclamation text-danger me-2"></i>Failed Login Attempts</div>
                                <small class="text-secondary">Unrecognized access attempts detected in the last 30 days.</small>
                            </div>
                            <div>
                                <span class="badge bg-success">0 Threat(s) Found</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== TAB 2: ACTIVE SESSIONS ==================== -->
        <div class="tab-pane fade @(activeTab == "sessions" ? "show active" : "")">
            <div class="card bg-dark border-secondary">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-laptop me-2"></i>Active Sessions (Max 5)</strong>

                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="HandleRevokeAllSessions">
                        <i class="bi bi-exclamation-octagon me-1"></i> Revoke All Sessions
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (sessions.Count == 0)
                    {
                        <div class="p-3 text-secondary">No active sessions found.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Device</th>
                                        <th>Browser</th>
                                        <th>IP Address</th>
                                        <th>Last Activity</th>
                                        <th class="text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in sessions.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                @session.DeviceName
                                                @if (session.IsCurrent)
                                                {
                                                    <span class="badge bg-success ms-2">Current</span>
                                                }
                                            </td>
                                            <td>@session.Browser</td>
                                            <td class="font-monospace">@session.IpAddress</td>
                                            <td>@session.LastActivityAt</td>
                                            <td class="text-end">
                                                @if (!session.IsCurrent)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => HandleRevokeSession(session.Id)">
                                                        <i class="bi bi-box-arrow-right"></i> Sign Out
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Active now</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ==================== TAB 3: PROTECTION & LOGS ==================== -->
        <div class="tab-pane fade @(activeTab == "protection" ? "show active" : "")">

            <!-- Quick Settings Card -->
            <div class="card bg-dark border-secondary mb-4">
                <div class="card-header border-secondary">
                    <strong><i class="bi bi-sliders me-2"></i>Protection Settings</strong>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">Privacy Mode (Mask Balances)</div>
                                    <small class="text-secondary">Conceal monetary values across the app ($ &bull;&bull;&bull;&bull;&bull;)</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch">
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">Auto-Lock Timeout</div>
                                    <small class="text-secondary">Automatically lock screen when idle</small>
                                </div>
                                <select class="form-select form-select-sm bg-dark text-white border-secondary w-auto">
                                    <option value="0">Disabled</option>
                                    <option value="5" selected>5 Minutes</option>
                                    <option value="15">15 Minutes</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Login Activity Log (Max 5) -->
            <div class="card bg-dark border-secondary">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-clock-history me-2"></i>Recent Login History (Max 5)</strong>
                    <a href="/Guardian/ExportAuditLog" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-download me-1"></i> Export Log (CSV)
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (activities.Count == 0)
                    {
                        <div class="p-3 text-secondary">No login activity found.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Activity</th>
                                        <th>Device</th>
                                        <th>IP Address</th>
                                        <th>Date</th>
                                        <th class="text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var activity in activities.Take(5))
                                    {
                                        <tr>
                                            <td>@activity.ActivityType</td>
                                            <td>@activity.Device</td>
                                            <td class="font-monospace">@activity.IpAddress</td>
                                            <td>@activity.CreatedAt</td>
                                            <td class="text-end">
                                                @if (activity.IsSuccess)
                                                {
                                                    <span class="badge bg-success">Success</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Failed</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>

</div>

@code {
    [Parameter] public Guid UserId { get; set; }

    private string activeTab = "health";
    private List<UserSession> sessions = new();
    private List<LoginActivity> activities = new();
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        sessions = await GuardianService.GetActiveSessionsAsync(UserId);
        activities = await GuardianService.GetLoginActivitiesAsync(UserId);
    }

    private async Task HandleRevokeSession(Guid sessionId)
    {
        errorMessage = null;
        await GuardianService.RevokeSessionAsync(sessionId, UserId);
        successMessage = "Session has been signed out.";
        sessions = await GuardianService.GetActiveSessionsAsync(UserId);
    }

    private async Task HandleRevokeAllSessions()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Emergency Lockout: Are you sure you want to sign out of ALL devices? You will be required to log in again.");
        if (!confirmed) return;

        var user = await UserManager.FindByIdAsync(UserId.ToString());
        if (user == null)
        {
            errorMessage = "User not found.";
            return;
        }

        var userSessions = await DbContext.UserSessions
            .Where(s => s.UserId == UserId && s.IsActive)
            .ToListAsync();

        foreach (var session in userSessions)
        {
            session.IsActive = false;
            session.RevokedAt = DateTime.UtcNow;
        }

        await DbContext.SaveChangesAsync();

        // Kunci utama: perbarui Security Stamp agar cookie ASP.NET di semua
        // browser (termasuk browser saat ini) hangus pada request berikutnya.
        await UserManager.UpdateSecurityStampAsync(user);

        // Navigasi paksa (forceLoad) supaya browser benar-benar mengirim
        // request baru ke /Auth/Login — cookie lama sudah tidak valid lagi
        // karena security stamp berubah, jadi middleware auth akan menolaknya.
        Nav.NavigateTo("/Auth/Login", forceLoad: true);
    }
}
