@using System.Text
@using System.Net
@using AumoFinance.Models
@using AumoFinance.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject IAiService AiService

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-robot text-primary me-2"></i>AI Financial Assistant
            </h3>
            <p class="text-muted small mb-0">Business analysis, expense detection, and instant financial advice.</p>
        </div>
    </div>

    <!-- 1. AI LIVE INSIGHT (Auto Summary Box) -->
    <div class="card border-0 shadow-sm bg-primary bg-gradient text-white mb-4 rounded-4 overflow-hidden">
        <div class="card-body p-4 position-relative">
            <div class="d-flex align-items-center mb-2">
                <span class="badge bg-white text-primary fw-bold px-2 py-1 rounded-pill me-2" style="font-size: 0.75rem;">
                    <i class="bi bi-lightning-charge-fill me-1"></i>LIVE SUMMARY
                </span>
                @if (summaryLoaded)
                {
                    <small class="text-white-50">Updated just now</small>
                }
            </div>

            <p class="card-text fs-6 fw-normal mb-0 opacity-90 leading-relaxed">
                @if (!summaryLoaded)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    @:Analyzing your current cash flow &amp; transactions...
                }
                else
                {
                    @summaryText
                }
            </p>
        </div>
    </div>

    <!-- 2. PRESET PROMPT CARDS (Quick Question Boxes) -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h6 class="fw-bold text-secondary mb-0">Recommended Quick Questions:</h6>
        <span class="text-muted style-tiny" style="font-size: 0.8rem;">Click a card to ask instantly</span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm p-3 preset-card rounded-4 text-start bg-body" disabled="@isLoading"
                    @onclick='() => SendQuickPrompt("How is my cash position and liquidity looking right now?")'>
                <div class="badge bg-primary-subtle text-primary p-2 rounded-3 mb-2 fit-content">
                    <i class="bi bi-cash-stack fs-5"></i>
                </div>
                <div class="fw-bold text-dark small mb-1">Cash Health</div>
                <div class="text-muted text-truncate w-100" style="font-size: 0.75rem;">Check current liquid cash safety</div>
            </button>
        </div>

        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm p-3 preset-card rounded-4 text-start bg-body" disabled="@isLoading"
                    @onclick='() => SendQuickPrompt("Are there any overspending areas or expenses that need review?")'>
                <div class="badge bg-danger-subtle text-danger p-2 rounded-3 mb-2 fit-content">
                    <i class="bi bi-graph-up-arrow fs-5"></i>
                </div>
                <div class="fw-bold text-dark small mb-1">Overspending Alert</div>
                <div class="text-muted text-truncate w-100" style="font-size: 0.75rem;">Detect highest expense categories</div>
            </button>
        </div>

        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm p-3 preset-card rounded-4 text-start bg-body" disabled="@isLoading"
                    @onclick='() => SendQuickPrompt("What is the estimated net income and revenue trend for this period?")'>
                <div class="badge bg-success-subtle text-success p-2 rounded-3 mb-2 fit-content">
                    <i class="bi bi-pie-chart-fill fs-5"></i>
                </div>
                <div class="fw-bold text-dark small mb-1">Profit Forecast</div>
                <div class="text-muted text-truncate w-100" style="font-size: 0.75rem;">Project net profit for active period</div>
            </button>
        </div>

        <div class="col-md-3 col-6">
            <button class="card h-100 w-100 border-0 shadow-sm p-3 preset-card rounded-4 text-start bg-body" disabled="@isLoading"
                    @onclick='() => SendQuickPrompt("Give me 3 actionable tips to optimize financial performance.")'>
                <div class="badge bg-warning-subtle text-warning p-2 rounded-3 mb-2 fit-content">
                    <i class="bi bi-lightbulb-fill fs-5"></i>
                </div>
                <div class="fw-bold text-dark small mb-1">Efficiency Tips</div>
                <div class="text-muted text-truncate w-100" style="font-size: 0.75rem;">Pragmatic cost-saving insights</div>
            </button>
        </div>
    </div>

    <!-- 3. INTERACTIVE CHAT BOX -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-chat-dots me-2 text-primary"></i>Conversation</h6>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="ClearChat">
                <i class="bi bi-trash me-1"></i>Clear
            </button>
        </div>
        <div class="card-body p-4">
            <!-- Chat Container -->
            <div class="mb-3 pe-2 overflow-y-auto style-scrollbar" style="height: 380px;">
                @if (!messages.Any())
                {
                    <div class="text-center text-muted my-5 py-4">
                        <i class="bi bi-robot fs-1 text-secondary opacity-50 d-block mb-2"></i>
                        <p class="small mb-0">Click any card above or type a question below to start the discussion.</p>
                    </div>
                }
                @foreach (var msg in messages)
                {
                    @if (msg.IsUser)
                    {
                        <div class="d-flex justify-content-end mb-3">
                            <div class="bg-primary text-white p-3 rounded-4 shadow-sm" style="max-width: 80%; border-bottom-right-radius: 4px !important;">
                                <p class="mb-0 small">@msg.Text</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-start mb-3">
                            <div class="bg-light border text-dark p-3 rounded-4 shadow-sm" style="max-width: 85%; border-bottom-left-radius: 4px !important;">
                                <div class="small leading-relaxed">@FormatMarkdown(msg.Text)</div>
                            </div>
                        </div>
                    }
                }
                @if (isLoading)
                {
                    <div class="d-flex justify-content-start mb-3">
                        <div class="bg-light border text-dark p-3 rounded-4 shadow-sm" style="border-bottom-left-radius: 4px !important;">
                            <div class="d-flex align-items-center small text-muted">
                                <span class="spinner-border spinner-border-sm me-2"></span> AI is analyzing data...
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Input Box -->
            <div class="input-group bg-light p-2 rounded-4 border">
                <input type="text" class="form-control border-0 bg-transparent shadow-none"
                       placeholder="Ask anything or request custom analysis..." disabled="@isLoading"
                       value="@userInput" @oninput="@(e => userInput = (string?)e.Value ?? string.Empty)"
                       @onkeydown="HandleInputKeyDown" />
                <button class="btn btn-primary rounded-3 px-4 fw-semibold" type="button" disabled="@isLoading" @onclick="SendMessage">
                    <i class="bi bi-send-fill me-1"></i> Send
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .preset-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
    }
    .preset-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.08) !important;
    }
    .fit-content {
        width: fit-content;
    }
    .style-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .style-scrollbar::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 10px;
    }
</style>

@code {
    [Parameter] public Guid UserId { get; set; }

    private List<ChatMessage> messages = new();
    private string userInput = string.Empty;
    private bool isLoading;
    private string summaryText = string.Empty;
    private bool summaryLoaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var context = await BuildFinancialContextAsync();
            summaryText = await AiService.AnalyzeFinancialQueryAsync(
                "Give a one-paragraph, max 3-sentence live summary of the current cash flow and financial condition based on the data provided.",
                context);
        }
        catch (Exception)
        {
            summaryText = "Failed to load automated summary. Make sure connection and journal data exist.";
        }
        finally
        {
            summaryLoaded = true;
        }
    }

    private Task SendQuickPrompt(string prompt)
    {
        userInput = prompt;
        return SendMessage();
    }

    private Task HandleInputKeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? SendMessage() : Task.CompletedTask;

    private async Task SendMessage()
    {
        var message = userInput.Trim();
        if (string.IsNullOrEmpty(message) || isLoading) return;

        messages.Add(new ChatMessage(true, message));
        userInput = string.Empty;
        isLoading = true;
        StateHasChanged();

        try
        {
            var context = await BuildFinancialContextAsync();
            var reply = await AiService.AnalyzeFinancialQueryAsync(message, context);
            messages.Add(new ChatMessage(false, string.IsNullOrWhiteSpace(reply)
                ? "Sorry, an error occurred while processing the response."
                : reply));
        }
        catch (Exception)
        {
            messages.Add(new ChatMessage(false, "Failed to connect to AI. Please try again later."));
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearChat() => messages.Clear();

    private static MarkupString FormatMarkdown(string text)
    {
        var escaped = WebUtility.HtmlEncode(text);
        escaped = escaped.Replace("\n", "<br>");
        escaped = System.Text.RegularExpressions.Regex.Replace(escaped, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        return new MarkupString(escaped);
    }

    private async Task<string> BuildFinancialContextAsync()
    {
        var activePeriod = await SelectedPeriodHelper.GetSelectedPeriodAsync(DbContext, UserId);

        if (activePeriod == null)
        {
            return "No period is currently selected. Ask the user to pick a period on the Periods page first.";
        }

        var accounts = await DbContext.ChartOfAccounts
            .Where(a => a.IsActive && a.UserId == UserId)
            .ToListAsync();

        var lines = await DbContext.JournalEntryLines
            .Include(l => l.JournalEntry)
            .Include(l => l.Account)
            .Where(l => l.JournalEntry != null && l.JournalEntry.UserId == UserId && l.JournalEntry.EntryDate <= activePeriod.EndDate)
            .ToListAsync();

        if (accounts.Count == 0 || lines.Count == 0)
        {
            return "No journal or account data is available yet.";
        }

        decimal BalanceFor(string type)
        {
            var ids = accounts.Where(a => a.Type == type).Select(a => a.Id).ToHashSet();
            var normalDebit = AccountClassification.NormalBalanceIsDebit(type);
            var relevant = lines.Where(l => ids.Contains(l.AccountId));
            return normalDebit
                ? relevant.Sum(l => l.Debit - l.Credit)
                : relevant.Sum(l => l.Credit - l.Debit);
        }

        var cash = accounts.Where(a => a.Role == "CashAndEquivalents")
            .Sum(a => lines.Where(l => l.AccountId == a.Id).Sum(l => l.Debit - l.Credit));

        var revenue = BalanceFor("OperatingIncome") + BalanceFor("OtherIncome");
        var expenses = BalanceFor("OperatingExpenses") + BalanceFor("OtherExpenses");
        var netIncome = revenue - expenses;

        var topExpenses = accounts
            .Where(a => a.Type is "OperatingExpenses" or "OtherExpenses")
            .Select(a => new
            {
                a.AccountName,
                Amount = lines.Where(l => l.AccountId == a.Id).Sum(l => l.Debit - l.Credit)
            })
            .Where(x => x.Amount != 0)
            .OrderByDescending(x => x.Amount)
            .Take(5)
            .ToList();

        var sb = new StringBuilder();
        sb.AppendLine($"Active period: {activePeriod?.PeriodName ?? "None"}");
        sb.AppendLine($"Cash and equivalents: {cash:N0}");
        sb.AppendLine($"Revenue: {revenue:N0}");
        sb.AppendLine($"Operating expenses: {expenses:N0}");
        sb.AppendLine($"Net income: {netIncome:N0}");
        sb.AppendLine("Top expense accounts:");
        foreach (var exp in topExpenses)
        {
            sb.AppendLine($"- {exp.AccountName}: {exp.Amount:N0}");
        }

        return sb.ToString();
    }

    private record ChatMessage(bool IsUser, string Text);
}
