@page "/reports/statement-of-financial-position"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Security.Claims
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using AumoFinance.Models
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider

<div class="container-fluid py-2">
    @if (noPeriodSelected)
    {
        <div class="text-center py-5 my-4">
            <i class="bi bi-eye-slash text-secondary mb-3 d-block" style="font-size: 2.5rem;"></i>
            <h5 class="fw-bold text-body-emphasis mb-2">No Period Selected</h5>
            <p class="text-secondary mb-3">This report follows whichever period you're viewing.</p>
            <a href="/periods" class="btn btn-primary btn-sm fw-semibold shadow-sm px-4">
                <i class="bi bi-calendar3 me-1"></i> Go to Periods
            </a>
        </div>
    }
    else
    {
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">
                    <i class="bi bi-bank me-2 text-info"></i>Statement of Financial Position
                </h2>
                <p class="text-muted mb-0">
                    In accordance with IAS 1, as of <strong>@vm.AsOfDate.ToString("MMMM dd, yyyy")</strong>. Retained earnings reflect the ending balance from the Retained Earnings Statement.
                </p>
            </div>
            <div>
                <a href="/reports/closing-journal" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-right-circle me-1"></i> Closing Journal
                </a>
            </div>
        </div>

        <!-- Main Balance Sheet Content -->
        <div class="row g-4 align-items-stretch">
            <!-- Left Column: Assets -->
            <div class="col-lg-6 d-flex flex-column">
                <div class="card bg-dark border-secondary text-white shadow-sm flex-grow-1">
                    <div class="card-header bg-transparent border-secondary fw-bold text-uppercase small text-warning py-3">
                        Assets
                    </div>
                    <div class="card-body d-flex flex-column justify-content-between">
                        <table class="table table-dark table-borderless align-middle mb-0">
                            <tbody>
                                @foreach (var l in vm.Assets)
                                {
                                    <tr>
                                        <td>
                                            <code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName
                                        </td>
                                        <td class="text-end">@l.Amount.ToString("N0", Idr)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="border-top border-secondary pt-3 mt-3">
                            <div class="d-flex justify-content-between align-items-center fw-bold fs-5">
                                <span>Total Assets</span>
                                <span class="text-info">@vm.TotalAssets.ToString("N0", Idr)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Liabilities & Equity -->
            <div class="col-lg-6 d-flex flex-column gap-4">
                <!-- Liabilities Card -->
                <div class="card bg-dark border-secondary text-white shadow-sm">
                    <div class="card-header bg-transparent border-secondary fw-bold text-uppercase small text-warning py-3">
                        Liabilities
                    </div>
                    <div class="card-body">
                        <table class="table table-dark table-borderless align-middle mb-0">
                            <tbody>
                                @foreach (var l in vm.Liabilities)
                                {
                                    <tr>
                                        <td>
                                            <code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName
                                        </td>
                                        <td class="text-end">@l.Amount.ToString("N0", Idr)</td>
                                    </tr>
                                }
                                <tr class="border-top border-secondary fw-semibold">
                                    <td class="pt-2">Total Liabilities</td>
                                    <td class="text-end pt-2">@vm.TotalLiabilities.ToString("N0", Idr)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Equity Card -->
                <div class="card bg-dark border-secondary text-white shadow-sm">
                    <div class="card-header bg-transparent border-secondary fw-bold text-uppercase small text-warning py-3">
                        Equity
                    </div>
                    <div class="card-body">
                        <table class="table table-dark table-borderless align-middle mb-0">
                            <tbody>
                                @foreach (var l in vm.EquityExcludingRetainedEarnings)
                                {
                                    <tr>
                                        <td>
                                            <code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName
                                        </td>
                                        <td class="text-end">@l.Amount.ToString("N0", Idr)</td>
                                    </tr>
                                }
                                <tr>
                                    <td>Retained earnings, @vm.AsOfDate.ToString("MMMM d")</td>
                                    <td class="text-end">@vm.RetainedEarningsEnding.ToString("N0", Idr)</td>
                                </tr>
                                <tr class="border-top border-secondary fw-semibold">
                                    <td class="pt-2">Total Equity</td>
                                    <td class="text-end pt-2">@vm.TotalEquity.ToString("N0", Idr)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Total Liabilities & Equity Summary Card -->
                <div class="card bg-dark border-secondary text-white shadow-sm mt-auto">
                    <div class="card-body d-flex justify-content-between align-items-center py-3">
                        <span class="fw-bold fs-5">Total Liabilities &amp; Equity</span>
                        <span class="fw-bold fs-5 text-info">@vm.TotalLiabilitiesAndEquity.ToString("N0", Idr)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Balance Indicator Alert -->
        <div class="alert @(vm.IsBalanced ? "alert-success" : "alert-danger") bg-opacity-10 text-white border-@(vm.IsBalanced ? "success" : "danger") mt-4 mb-0 py-2 small d-flex align-items-center shadow-sm">
            @if (vm.IsBalanced)
            {
                <i class="bi bi-check-circle-fill text-success me-2 fs-6"></i>
                <span>Total Assets = Total Liabilities + Equity. The Statement of Financial Position is balanced.</span>
            }
            else
            {
                <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-6"></i>
                <span>Total Assets does not equal Total Liabilities + Equity. Please check your journal entries.</span>
            }
        </div>
    }
</div>
