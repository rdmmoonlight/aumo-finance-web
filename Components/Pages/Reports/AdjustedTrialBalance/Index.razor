@page "/reports/trial-balance/true"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Security.Claims
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using AumoFinance.Models
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider

<div class="container-fluid">
    @if (noPeriodSelected)
    {
        <div class="text-center py-5 my-4">
            <i class="bi bi-eye-slash text-secondary mb-3 d-block" style="font-size: 2.5rem;"></i>
            <h5 class="fw-bold text-body-emphasis mb-2">No Period Selected</h5>
            <p class="text-secondary mb-3">This report follows whichever period you're viewing.</p>
            <a href="/periods" class="btn btn-primary btn-sm fw-semibold shadow-sm px-4">
                <i class="bi bi-calendar3 me-1"></i> Go to Periods
            </a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1"><i class="bi bi-list-columns me-2 text-info"></i> Adjusted Trial Balance</h2>
                <p class="text-muted mb-0">Account balances after reflecting adjusting entries — the foundation for preparing the Income Statement and Balance Sheet.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/reports/trial-balance" class="btn btn-outline-secondary">
                    <i class="bi bi-list-columns me-1"></i> Trial Balance
                </a>
                <a href="/reports/adjusting-journal" class="btn btn-outline-secondary">
                    <i class="bi bi-journal-medical me-1"></i> Adjusting Journal
                </a>
            </div>
        </div>

        <div class="card bg-dark border-secondary text-white shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead class="table-active border-bottom border-secondary">
                            <tr>
                                <th class="text-center">Ref.</th>
                                <th>Account Name</th>
                                <th>Type</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (rows.Any())
                            {
                                @foreach (var row in rows)
                                {
                                    <tr>
                                        <td class="text-center"><code>@row.ReferenceNumber</code></td>
                                        <td>@row.AccountName</td>
                                        <td><span class="badge bg-secondary bg-opacity-25 border border-secondary">@row.Type</span></td>
                                        <td class="text-end text-success">@(row.Debit > 0 ? row.Debit.ToString("N0", Idr) : "-")</td>
                                        <td class="text-end text-danger">@(row.Credit > 0 ? row.Credit.ToString("N0", Idr) : "-")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted">No accounts with transaction history found.</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="border-top border-secondary fw-bold">
                                <td colspan="3" class="text-end">Total</td>
                                <td class="text-end text-success">@TotalDebit.ToString("N0", Idr)</td>
                                <td class="text-end text-danger">@TotalCredit.ToString("N0", Idr)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        @if (rows.Any())
        {
            <div class="alert @(IsBalanced ? "alert-success" : "alert-danger") bg-opacity-10 mt-3 mb-0 py-2 small">
                @if (IsBalanced)
                {
                    <i class="bi bi-check-circle-fill me-1"></i> Total Debit = Total Credit. The adjusted trial balance is balanced.
                }
                else
                {
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> The adjusted trial balance is unbalanced. Please review your adjusting journal entries.
                }
            </div>
        }
    }
</div>
