@page "/reports/general-journal"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Security.Claims
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using AumoFinance.Models
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider

<div class="container-fluid py-4 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-journal-bookmark me-2 text-warning"></i> General Journal
            </h2>
            <p class="text-secondary mb-0">Chronological record of financial transactions for Aumo Finance.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/JournalEntry/Create" class="btn btn-primary fw-semibold shadow-sm d-flex align-items-center">
                <i class="bi bi-plus-lg me-2"></i> Add Entry
            </a>
            <button type="button" class="btn btn-outline-secondary fw-semibold shadow-sm d-flex align-items-center @(editMode ? "active" : "")"
                    @onclick="ToggleEditMode" disabled="@(!entries.Any())">
                <i class="bi bi-pencil me-2"></i> Edit
            </button>
        </div>
    </div>

    @if (selectedPeriod != null)
    {
        <div class="alert alert-secondary shadow-sm py-2 px-3 small d-flex align-items-center gap-2 rounded-3">
            <i class="bi bi-eye-fill fs-5"></i>
            <span>Showing <strong>@selectedPeriod.PeriodName</strong></span>
            @if (selectedPeriod.IsClosed)
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-auto">
                    <i class="bi bi-lock-fill me-1"></i>Closed
                </span>
            }
        </div>
    }

    <!-- General Journal Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <!-- Tambahkan table-sm untuk membuat baris lebih compact -->
                <table class="table table-sm table-hover align-middle mb-0">
                    <!-- table-dark untuk header hitam -->
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3 text-center py-2" style="width: 8%;">Tgl</th>
                            <th class="py-2" style="width: 25%;">Account</th>
                            <th class="py-2 text-white" style="width: 27%;">Description</th>
                            <th class="text-center py-2 text-white" style="width: 8%;">Ref.</th>
                            <th class="text-end py-2" style="width: 16%;">Debit</th>
                            <th class="text-end pe-3 py-2" style="width: 16%;">Credit</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (entries.Any())
                        {
                            string lastDate = "";
                            int dateGroupIndex = 0;

                            for (int e = 0; e < entries.Count; e++)
                            {
                                var entry = entries[e];
                                var allLines = entry.Lines.OrderBy(l => l.LineOrder).ToList();

                                var currentDateStr = entry.EntryDate.ToString("dd-MM-yyyy");
                                var showDate = (currentDateStr != lastDate);
                                if (showDate) { lastDate = currentDateStr; dateGroupIndex++; }

                                var entryShade = (dateGroupIndex % 2 == 0) ? "" : "bg-body-secondary bg-opacity-25";

                                for (int i = 0; i < allLines.Count; i++)
                                {
                                    var line = allLines[i];
                                    var isFirstRow = (i == 0);
                                    var isDebit = line.Debit > 0;

                                    <tr class="@entryShade">
                                        <td class="ps-3 text-center align-top py-1">
                                            @if (isFirstRow && showDate)
                                            {
                                                <div>
                                                    <span class="badge rounded-pill bg-primary text-white fw-bold px-2 py-1 shadow-sm">
                                                        @entry.EntryDate.Day
                                                    </span>
                                                </div>
                                            }
                                            @if (isFirstRow)
                                            {
                                                <div class="d-flex flex-column align-items-center mt-1">
                                                    @if (entry.CreatedAt != default)
                                                    {
                                                        <!-- Hapus ikon jam, sisa teks jam saja -->
                                                        <span class="text-muted fw-medium" style="font-size: 0.70rem;" title="Waktu Input">
                                                            @entry.CreatedAt.ToString("HH:mm:ss")
                                                        </span>
                                                    }

                                                    <a href="/JournalEntry/Edit/@entry.Id"
                                                       class="btn btn-sm btn-light text-primary border-0 shadow-sm mt-1 py-0 px-1 @(editMode ? "" : "d-none")" 
                                                       title="Edit entri ini">
                                                        <i class="bi bi-pencil-fill" style="font-size: 0.8rem;"></i>
                                                    </a>
                                                </div>
                                            }
                                        </td>
                                        <td class="align-top py-1 @(isDebit ? "fw-semibold text-body" : "ps-4 text-body")">
                                            @line.Account?.AccountName
                                        </td>
                                        <!-- Warna deskripsi tetap putih -->
                                        <td class="small align-top py-1 text-white">
                                            @line.LineDescription
                                        </td>
                                        <!-- Ref tanpa kotak, langsung text-white -->
                                        <td class="text-center align-top py-1">
                                            <span class="text-white fw-medium">
                                                @line.Account?.ReferenceNumber
                                            </span>
                                        </td>
                                        <td class="text-end align-top py-1 @(isDebit ? "text-success fw-bold" : "text-secondary")">
                                            @(line.Debit > 0 ? line.Debit.ToString("N0", Idr) : null)
                                        </td>
                                        <td class="text-end pe-3 align-top py-1 @(!isDebit ? "text-danger fw-bold" : "text-secondary")">
                                            @(line.Credit > 0 ? line.Credit.ToString("N0", Idr) : null)
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-secondary">
                                    @if (selectedPeriod == null)
                                    {
                                        <div class="py-3">
                                            <i class="bi bi-eye-slash mb-2 d-block text-muted" style="font-size: 2.5rem;"></i>
                                            <h6 class="fw-semibold">No Period Selected</h6>
                                            <p class="mb-0 small">Go to <a href="/periods" class="text-decoration-none fw-bold">Periods</a> and click <i class="bi bi-eye"></i> to view one.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="py-3">
                                            <i class="bi bi-journal-x mb-2 d-block text-muted" style="font-size: 2.5rem;"></i>
                                            <h6 class="fw-semibold">No Entries Found</h6>
                                            <p class="mb-0 small">No journal entries recorded in <strong>@selectedPeriod.PeriodName</strong>.</p>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo Idr = new("id-ID");

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid UserId { get; set; }
    private List<JournalEntry> entries = new();
    private Period? selectedPeriod;
    private bool editMode;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (Guid.TryParse(userIdClaim, out var parsedGuid))
                {
                    UserId = parsedGuid;
                }
            }
        }

        if (UserId == Guid.Empty) return;

        selectedPeriod = await SelectedPeriodHelper.GetSelectedPeriodAsync(DbContext, UserId);

        if (selectedPeriod == null)
        {
            entries = new List<JournalEntry>();
            return;
        }

        entries = await DbContext.JournalEntries
            .Include(j => j.Lines)
                .ThenInclude(l => l.Account)
            .Where(j => j.UserId == UserId
                     && j.EntryDate >= selectedPeriod.StartDate 
                     && j.EntryDate <= selectedPeriod.EndDate)
            .OrderBy(j => j.EntryDate)    
            .ThenBy(j => j.CreatedAt)     
            .ThenBy(j => j.Id)             
            .ToListAsync();
    }

    private void ToggleEditMode() => editMode = !editMode;
}
