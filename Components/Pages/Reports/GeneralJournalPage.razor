@page "/reports/general-journal"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Security.Claims
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using AumoFinance.Models
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider

<div class="container-fluid py-4 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-journal-bookmark me-2 text-warning"></i> General Journal
            </h2>
            <p class="text-secondary mb-0">Chronological record of financial transactions for Aumo Finance.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/JournalEntry/Create" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Entry
            </a>
            <button type="button" class="btn btn-outline-secondary fw-semibold shadow-sm @(editMode ? "active" : "")"
                    @onclick="ToggleEditMode" disabled="@(!entries.Any())">
                <i class="bi bi-pencil me-1"></i> Edit
            </button>
        </div>
    </div>

    @if (selectedPeriod != null)
    {
        <div class="alert alert-secondary shadow-sm py-2 small d-flex align-items-center gap-2">
            <i class="bi bi-eye-fill"></i>
            Showing <strong>@selectedPeriod.PeriodName</strong>
            @if (selectedPeriod.IsClosed)
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-lock-fill me-1"></i>Closed</span>
            }
        </div>
    }

    <!-- General Journal Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 text-center" style="width: 8%;">Tgl</th>
                            <th style="width: 25%;">Account</th>
                            <th style="width: 27%;">Description</th>
                            <th class="text-center" style="width: 8%;">Ref.</th>
                            <th class="text-end" style="width: 16%;">Debit</th>
                            <th class="text-end pe-4" style="width: 16%;">Credit</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (entries.Any())
                        {
                            string lastDate = "";
                            int dateGroupIndex = 0;

                            for (int e = 0; e < entries.Count; e++)
                            {
                                var entry = entries[e];
                                var allLines = entry.Lines.OrderBy(l => l.LineOrder).ToList();

                                // Hanya mengambil string tanggal (DD-MM-YYYY) untuk pengelompokan grup baris
                                var currentDateStr = entry.EntryDate.ToString("dd-MM-yyyy");
                                var showDate = (currentDateStr != lastDate);
                                if (showDate) { lastDate = currentDateStr; dateGroupIndex++; }

                                var entryShade = (dateGroupIndex % 2 == 0) ? "" : "bg-body-secondary bg-opacity-25";

                                for (int i = 0; i < allLines.Count; i++)
                                {
                                    var line = allLines[i];
                                    var isFirstRow = (i == 0);
                                    var isDebit = line.Debit > 0;

                                    <tr class="@entryShade">
                                        <td class="ps-4 text-center align-top">
                                            @if (isFirstRow && showDate)
                                            {
                                                <span class="badge rounded-pill bg-body-secondary text-body-emphasis fw-bold small px-2 py-1">
                                                    @entry.EntryDate.Day
                                                </span>
                                            }
                                            @if (isFirstRow)
                                            {
                                                <!-- Opsi: Menampilkan jam & menit input (jika ada properti CreatedAt) -->
                                                @if (entry.CreatedAt != default)
                                                {
                                                    <div class="text-muted small" style="font-size: 0.75rem;" title="Waktu Input">
                                                        @entry.CreatedAt.ToString("HH:mm:ss")
                                                    </div>
                                                }

                                                <a href="/JournalEntry/Edit/@entry.Id"
                                                   class="text-primary ms-1 @(editMode ? "" : "d-none")" title="Edit entri ini">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </a>
                                            }
                                        </td>
                                        <td class="align-top @(isDebit ? "fw-semibold text-body" : "ps-4 text-body")">
                                            @line.Account?.AccountName
                                        </td>
                                        <td class="text-secondary small align-top">
                                            @line.LineDescription
                                        </td>
                                        <td class="text-center align-top">
                                            <code>@line.Account?.ReferenceNumber</code>
                                        </td>
                                        <td class="text-end align-top @(isDebit ? "text-success fw-semibold" : "text-secondary")">
                                            @(line.Debit > 0 ? line.Debit.ToString("N0", Idr) : null)
                                        </td>
                                        <td class="text-end pe-4 align-top @(!isDebit ? "text-danger fw-semibold" : "text-secondary")">
                                            @(line.Credit > 0 ? line.Credit.ToString("N0", Idr) : null)
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-secondary">
                                    @if (selectedPeriod == null)
                                    {
                                        <i class="bi bi-eye-slash mb-3 d-block" style="font-size: 2.5rem;"></i>
                                        <span>No period selected. Go to <a href="/periods">Periods</a> and click <i class="bi bi-eye"></i> to view one.</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-journal-x mb-3 d-block" style="font-size: 2.5rem;"></i>
                                        <span>No journal entries recorded in @selectedPeriod.PeriodName.</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo Idr = new("id-ID");

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid UserId { get; set; }
    private List<JournalEntry> entries = new();
    private Period? selectedPeriod;
    private bool editMode;

    protected override async Task OnInitializedAsync()
    {
        // 1. Ambil UserId langsung dari AuthenticationState
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (Guid.TryParse(userIdClaim, out var parsedGuid))
                {
                    UserId = parsedGuid;
                }
            }
        }

        if (UserId == Guid.Empty) return;

        // 2. Load data berdasarkan UserId
        selectedPeriod = await SelectedPeriodHelper.GetSelectedPeriodAsync(DbContext, UserId);

        if (selectedPeriod == null)
        {
            entries = new List<JournalEntry>();
            return;
        }

        // 3. Query dengan pengurutan: EntryDate -> CreatedAt (Jam/Menit/Detik Input) -> Id
        entries = await DbContext.JournalEntries
            .Include(j => j.Lines)
                .ThenInclude(l => l.Account)
            .Where(j => j.UserId == UserId
                     && j.EntryDate >= selectedPeriod.StartDate 
                     && j.EntryDate <= selectedPeriod.EndDate)
            .OrderBy(j => j.EntryDate)    // Urutkan tanggal transaksi
            .ThenBy(j => j.CreatedAt)     // Urutkan berdasarkan jam, menit, dan detik waktu input
            .ThenBy(j => j.Id)             // Fallback pengaman jika waktu input persis sama
            .ToListAsync();
    }

    private void ToggleEditMode() => editMode = !editMode;
}
