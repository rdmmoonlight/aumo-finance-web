@page "/reports/general-journal"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Security.Claims
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using AumoFinance.Models
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-journal-bookmark me-2 text-warning"></i> General Journal
            </h2>
            <p class="text-muted mb-0">Chronological record of financial transactions for Aumo Finance.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/JournalEntry/Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Add Entry
            </a>
            <button type="button" class="btn btn-outline-secondary @(editMode ? "active" : "")"
                    @onclick="ToggleEditMode" disabled="@(!entries.Any())">
                <i class="bi bi-pencil me-1"></i> Edit
            </button>
        </div>
    </div>

    @if (selectedPeriod != null)
    {
        <div class="alert alert-secondary bg-dark text-muted border-secondary shadow-sm py-2 px-3 small d-flex align-items-center gap-2 rounded-3 mb-4">
            <i class="bi bi-eye-fill fs-5 text-warning"></i>
            <span>Showing Period: <strong>@selectedPeriod.PeriodName</strong></span>
            @if (selectedPeriod.IsClosed)
            {
                <span class="badge bg-secondary bg-opacity-25 border border-secondary ms-auto text-muted">
                    <i class="bi bi-lock-fill me-1"></i>Closed
                </span>
            }
        </div>
    }

    <!-- General Journal Table Card -->
    <div class="card bg-dark border-secondary text-white shadow-sm mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-active border-bottom border-secondary">
                        <tr>
                            <th class="ps-3" style="width: 10%;">Date</th>
                            <th style="width: 28%;">Account</th>
                            <th style="width: 30%;">Description</th>
                            <th class="text-center" style="width: 8%;">Ref.</th>
                            <th class="text-end" style="width: 12%;">Debit</th>
                            <th class="text-end pe-3" style="width: 12%;">Credit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (entries.Any())
                        {
                            string lastDate = "";
                            int dateGroupIndex = 0;

                            for (int e = 0; e < entries.Count; e++)
                            {
                                var entry = entries[e];
                                var allLines = entry.Lines.OrderBy(l => l.LineOrder).ToList();

                                var currentDateStr = entry.EntryDate.ToString("dd-MM-yyyy");
                                var showDate = (currentDateStr != lastDate);
                                if (showDate) { lastDate = currentDateStr; dateGroupIndex++; }

                                var entryShade = (dateGroupIndex % 2 == 0) ? "" : "bg-black bg-opacity-25";

                                for (int i = 0; i < allLines.Count; i++)
                                {
                                    var line = allLines[i];
                                    var isFirstRow = (i == 0);
                                    var isDebit = line.Debit > 0;

                                    <tr class="@entryShade">
                                        <td class="ps-3 text-nowrap align-top py-2">
                                            @if (isFirstRow && showDate)
                                            {
                                                <div>
                                                    <span class="badge bg-secondary bg-opacity-25 border border-secondary text-white fw-bold px-2 py-1">
                                                        @entry.EntryDate.ToString("dd-MM-yyyy")
                                                    </span>
                                                </div>
                                            }
                                            @if (isFirstRow)
                                            {
                                                <div class="d-flex flex-column align-items-start mt-1">
                                                    @if (entry.CreatedAt != default)
                                                    {
                                                        <span class="text-muted" style="font-size: 0.70rem;" title="Tanggal &amp; Waktu Input">
                                                            @entry.CreatedAt.ToString("dd-MM-yyyy HH:mm:ss")
                                                        </span>
                                                    }
                                                    @if (entry.UpdatedAt.HasValue)
                                                    {
                                                        <span class="text-info" style="font-size: 0.70rem;" title="Tanggal &amp; Waktu Terakhir Diedit">
                                                            <i class="bi bi-pencil-square"></i> @entry.UpdatedAt.Value.ToString("dd-MM-yyyy HH:mm:ss")
                                                        </span>
                                                    }

                                                    <div class="d-flex gap-1 mt-1 @(editMode ? "" : "d-none")">
                                                        <a href="/JournalEntry/Edit/@entry.Id"
                                                           class="btn btn-sm btn-dark text-warning border border-secondary shadow-sm py-0 px-1"
                                                           title="Edit entri ini">
                                                            <i class="bi bi-pencil-fill" style="font-size: 0.75rem;"></i>
                                                        </a>
                                                        <button type="button"
                                                                class="btn btn-sm btn-dark text-danger border border-secondary shadow-sm py-0 px-1"
                                                                title="Hapus entri ini"
                                                                @onclick="() => DeleteEntry(entry)">
                                                            <i class="bi bi-trash-fill" style="font-size: 0.75rem;"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                        <td class="align-top py-2 @(isDebit ? "fw-semibold text-white" : "ps-4 text-muted")">
                                            @line.Account?.AccountName
                                        </td>
                                        <td class="small align-top py-2 text-muted">
                                            @line.LineDescription
                                        </td>
                                        <td class="text-center align-top py-2">
                                            <code class="text-warning">
                                                @line.Account?.ReferenceNumber
                                            </code>
                                        </td>
                                        <td class="text-end align-top py-2 text-success">
                                            @(line.Debit > 0 ? line.Debit.ToString("N0", Idr) : "-")
                                        </td>
                                        <td class="text-end pe-3 align-top py-2 text-danger">
                                            @(line.Credit > 0 ? line.Credit.ToString("N0", Idr) : "-")
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    @if (selectedPeriod == null)
                                    {
                                        <div class="py-3">
                                            <i class="bi bi-eye-slash mb-2 d-block text-secondary" style="font-size: 2.5rem;"></i>
                                            <h6 class="fw-semibold text-white">No Period Selected</h6>
                                            <p class="mb-0 small">Go to <a href="/periods" class="text-decoration-none fw-bold">Periods</a> to select one.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="py-3">
                                            <i class="bi bi-journal-x mb-2 d-block text-secondary" style="font-size: 2.5rem;"></i>
                                            <h6 class="fw-semibold text-white">No Entries Found</h6>
                                            <p class="mb-0 small">No journal entries recorded in <strong>@selectedPeriod.PeriodName</strong>.</p>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo Idr = new("id-ID");

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid UserId { get; set; }
    private List<JournalEntry> entries = new();
    private Period? selectedPeriod;
    private bool editMode;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (Guid.TryParse(userIdClaim, out var parsedGuid))
                {
                    UserId = parsedGuid;
                }
            }
        }

        if (UserId == Guid.Empty) return;

        selectedPeriod = await SelectedPeriodHelper.GetSelectedPeriodAsync(DbContext, UserId);

        if (selectedPeriod == null)
        {
            entries = new List<JournalEntry>();
            return;
        }

        entries = await DbContext.JournalEntries
            .Include(j => j.Lines)
                .ThenInclude(l => l.Account)
            .Where(j => j.UserId == UserId
                     && j.EntryDate >= selectedPeriod.StartDate 
                     && j.EntryDate <= selectedPeriod.EndDate)
            .OrderBy(j => j.EntryDate)    
            .ThenBy(j => j.CreatedAt)     
            .ThenBy(j => j.Id)             
            .ToListAsync();
    }

    private void ToggleEditMode() => editMode = !editMode;

    private async Task DeleteEntry(JournalEntry entry)
    {
        var closedPeriods = await DbContext.Periods
            .Where(p => p.UserId == UserId && p.IsClosed)
            .ToListAsync();

        if (PeriodLock.IsDateLocked(entry.EntryDate, closedPeriods))
        {
            await JS.InvokeVoidAsync("alert", $"Jurnal {entry.TransactionNumber} berada pada periode yang sudah ditutup dan tidak dapat dihapus.");
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Hapus jurnal {entry.TransactionNumber}? Tindakan ini tidak dapat dibatalkan.");
        if (!confirmed) return;

        var tracked = await DbContext.JournalEntries
            .FirstOrDefaultAsync(j => j.Id == entry.Id && j.UserId == UserId);

        if (tracked == null) return;

        DbContext.JournalEntries.Remove(tracked);
        await DbContext.SaveChangesAsync();

        entries.Remove(entry);
        StateHasChanged();
    }
}
