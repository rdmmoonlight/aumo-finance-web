@page "/reports/income-statement"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Security.Claims
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using AumoFinance.Models
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider

<div class="container-fluid">
    @if (noPeriodSelected)
    {
        <div class="text-center py-5 my-4">
            <i class="bi bi-eye-slash text-secondary mb-3 d-block" style="font-size: 2.5rem;"></i>
            <h5 class="fw-bold text-body-emphasis mb-2">No Period Selected</h5>
            <p class="text-secondary mb-3">This report follows whichever period you're viewing.</p>
            <a href="/periods" class="btn btn-primary btn-sm fw-semibold shadow-sm px-4">
                <i class="bi bi-calendar3 me-1"></i> Go to Periods
            </a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1"><i class="bi bi-graph-up-arrow me-2 text-success"></i> Income Statement</h2>
                <p class="text-muted mb-0">Statement of Profit or Loss (IAS 1) untuk periode berjalan, per @vm.AsOfDate.ToString("dd MMMM yyyy").</p>
            </div>
            <div>
                <a href="/reports/retained-earnings" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-right-circle me-1"></i> Retained Earnings
                </a>
            </div>
        </div>

        <div class="card bg-dark border-secondary text-white shadow-sm">
            <div class="card-body">
                <table class="table table-dark table-borderless align-middle mb-0">
                    <tbody>
                        <tr><td colspan="2" class="fw-bold text-warning text-uppercase small">Revenue</td></tr>
                        @foreach (var l in vm.Revenues)
                        {
                            <tr><td class="ps-4"><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">@l.Amount.ToString("N0", Idr)</td></tr>
                        }
                        <tr class="border-top border-secondary fw-semibold"><td class="ps-4">Total Revenue</td><td class="text-end">@vm.TotalRevenue.ToString("N0", Idr)</td></tr>

                        <tr><td colspan="2" class="pt-3 fw-bold text-warning text-uppercase small">Operating Expenses</td></tr>
                        @foreach (var l in vm.OperatingExpenses)
                        {
                            <tr><td class="ps-4"><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">(@l.Amount.ToString("N0", Idr))</td></tr>
                        }
                        <tr class="border-top border-secondary fw-semibold"><td class="ps-4">Total Operating Expenses</td><td class="text-end">(@vm.TotalOperatingExpenses.ToString("N0", Idr))</td></tr>

                        <tr class="border-top border-bottom border-secondary fw-bold fs-5">
                            <td class="pt-2 pb-2">Operating Income</td>
                            <td class="text-end pt-2 pb-2 @(vm.OperatingIncome >= 0 ? "text-success" : "text-danger")">@vm.OperatingIncome.ToString("N0", Idr)</td>
                        </tr>

                        @if (vm.OtherIncome.Any() || vm.OtherExpenses.Any())
                        {
                            <tr><td colspan="2" class="pt-3 fw-bold text-warning text-uppercase small">Other Income &amp; Expenses</td></tr>
                            @foreach (var l in vm.OtherIncome)
                            {
                                <tr><td class="ps-4"><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">@l.Amount.ToString("N0", Idr)</td></tr>
                            }
                            @foreach (var l in vm.OtherExpenses)
                            {
                                <tr><td class="ps-4"><code class="text-muted me-2">@l.ReferenceNumber</code>@l.AccountName</td><td class="text-end">(@l.Amount.ToString("N0", Idr))</td></tr>
                            }
                        }

                        <tr class="border-top border-secondary" style="border-top-width: 3px !important;">
                            <td class="fw-bold fs-5 pt-2">Net Income</td>
                            <td class="text-end fw-bold fs-5 pt-2 @(vm.NetIncome >= 0 ? "text-success" : "text-danger")">@vm.NetIncome.ToString("N0", Idr)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
