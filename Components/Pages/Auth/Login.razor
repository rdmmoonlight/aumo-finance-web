@page "/auth/login"
@using System.ComponentModel.DataAnnotations
@using AumoFinance.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Sign In - Aumo Finance</PageTitle>

@* Gunakan wrapper kustom untuk kontrol penuh background halaman *@
<div class="auth-page-wrapper d-flex flex-column justify-content-center align-items-center w-100">
    <div class="w-100 p-2" style="max-width: 340px;">
        
        <!-- Logo & Header (Dikecilkan) -->
        <div class="auth-header text-center mb-3">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-2 p-2" style="width: 45px; height: 45px;">
                <i class="bi bi-wallet2 fs-5"></i>
            </div>
            <h5 class="fw-bold tracking-tight mb-0" style="font-family: 'Space Grotesk', sans-serif;">Aumo Finance</h5>
            <p class="text-secondary font-micro">Sign in to continue</p>
        </div>

        <!-- Login Form Card (Warna background kustom dari CSS) -->
        <div class="card auth-card shadow-lg overflow-hidden">
            <div class="card-body p-3 p-sm-4">

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-micro d-flex align-items-center mb-2" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <div>@successMessage</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-micro d-flex align-items-center mb-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div>@errorMessage</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(infoMessage))
                {
                    <div class="alert alert-info alert-micro d-flex align-items-center mb-2" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <div>@infoMessage</div>
                    </div>
                }

                <EditForm Model="Input" OnValidSubmit="HandleLoginAsync" FormName="LoginForm">
                    <DataAnnotationsValidator />
                    @* Sembunyikan ValidationSummary jika terlalu ramai, atau biarkan mikro *@
                    <ValidationSummary class="text-danger font-micro mb-2 p-0" style="list-style: none;" />

                    <!-- Email Input (Mikro) -->
                    <div class="mb-2">
                        <label class="form-label-tiny">Email Address</label>
                        <div class="input-group input-group-micro">
                            <span class="input-group-text border-end-0 text-secondary">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <InputText class="form-control border-start-0 ps-0" @bind-Value="Input.Email" placeholder="name@example.com" />
                        </div>
                        <ValidationMessage For="() => Input.Email" class="text-danger font-micro mt-1" />
                    </div>

                    <!-- Password Input (Mikro) -->
                    <div class="mb-2">
                        <label class="form-label-tiny mb-0">Password</label>
                        <div class="input-group input-group-micro">
                            <span class="input-group-text border-end-0 text-secondary">
                                <i class="bi bi-lock"></i>
                            </span>
                            <InputText type="password" class="form-control border-start-0 ps-0" @bind-Value="Input.Password" placeholder="••••••••" />
                        </div>
                        <ValidationMessage For="() => Input.Password" class="text-danger font-micro mt-1" />
                    </div>

                    <!-- Remember Me & Forgot (Compact) -->
                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <div class="form-check mb-0">
                            <InputCheckbox id="rememberMe" class="form-check-input" @bind-Value="Input.RememberMe" style="width: 0.8rem; height: 0.8rem; margin-top: 0.2rem;"/>
                            <label class="form-check-label font-micro text-secondary" for="rememberMe">
                                Remember me
                            </label>
                        </div>
                    </div>

                    <!-- Submit Button (Dikecilkan) -->
                    <button type="submit" class="btn btn-primary btn-micro w-100 d-flex align-items-center justify-content-center gap-1">
                        <span>Sign In</span>
                        <i class="bi bi-arrow-right-short fs-6"></i>
                    </button>
                </EditForm>

                <!-- Resend Link -->
                <div class="mt-3 pt-2 text-center border-top border-secondary border-opacity-10">
                    <a href="/auth/resend-verification" class="text-decoration-none font-micro text-secondary hover-underline">
                        Didn't receive verification email?
                    </a>
                </div>

            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-3">
            <p class="text-secondary font-micro mb-0">&copy; @DateTime.Now.Year Aumo Finance.</p>
        </div>

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "message")]
    private string? QueryMessage { get; set; }

    [SupplyParameterFromQuery(Name = "successMessage")]
    private string? QuerySuccessMessage { get; set; }

    [SupplyParameterFromQuery(Name = "errorMessage")]
    private string? QueryErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "infoMessage")]
    private string? QueryInfoMessage { get; set; }

    [SupplyParameterFromForm]
    private LoginInputModel Input { get; set; } = default!;

    private string? successMessage;
    private string? errorMessage;
    private string? infoMessage;

    protected override void OnInitialized()
    {
        Input ??= new();

        successMessage = QuerySuccessMessage ?? QueryMessage;
        errorMessage = QueryErrorMessage;
        infoMessage = QueryInfoMessage;
    }

    private async Task HandleLoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input.Email, 
            Input.Password, 
            Input.RememberMe, 
            lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else if (result.RequiresTwoFactor)
        {
            Navigation.NavigateTo("/auth/login-2fa");
        }
        else if (result.IsLockedOut)
        {
            errorMessage = "Locked out. Try again later.";
        }
        else
        {
            errorMessage = "Invalid email or password.";
        }
    }

    public class LoginInputModel
    {
        [Required(ErrorMessage = "Required.")]
        [EmailAddress(ErrorMessage = "Invalid email.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Required.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
