@page "/auth/login"
@using System.ComponentModel.DataAnnotations
@using AumoFinance.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Sign In - Aumo Finance</PageTitle>

<div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 w-100 py-4 my-auto">
    <div class="w-100" style="max-width: 420px; padding: 0 15px;">
        
        <!-- Logo / Brand Header -->
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3 p-3" style="width: 60px; height: 60px;">
                <i class="bi bi-wallet2 fs-3"></i>
            </div>
            <h3 class="fw-bold tracking-tight mb-1" style="font-family: 'Space Grotesk', sans-serif;">Aumo Finance</h3>
            <p class="text-secondary small">Sign in to your account to continue</p>
        </div>

        <!-- Login Form Card -->
        <div class="card border border-secondary border-opacity-25 shadow-lg rounded-4 overflow-hidden">
            <div class="card-body p-4 p-sm-5">

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success d-flex align-items-center py-2 px-3 small rounded-3 mb-3" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <div>@successMessage</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center py-2 px-3 small rounded-3 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div>@errorMessage</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(infoMessage))
                {
                    <div class="alert alert-info d-flex align-items-center py-2 px-3 small rounded-3 mb-3" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <div>@infoMessage</div>
                    </div>
                }

                <EditForm Model="Input" OnValidSubmit="HandleLoginAsync" FormName="LoginForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small mb-3" />

                    <!-- Email Input -->
                    <div class="mb-3">
                        <label class="form-label small fw-medium text-secondary">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary border-end-0 text-secondary">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <InputText class="form-control border-start-0 ps-0" @bind-Value="Input.Email" placeholder="name@example.com" />
                        </div>
                        <ValidationMessage For="() => Input.Email" class="text-danger small mt-1" />
                    </div>

                    <!-- Password Input -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-medium text-secondary mb-0">Password</label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary border-end-0 text-secondary">
                                <i class="bi bi-lock"></i>
                            </span>
                            <InputText type="password" class="form-control border-start-0 ps-0" @bind-Value="Input.Password" placeholder="••••••••" />
                        </div>
                        <ValidationMessage For="() => Input.Password" class="text-danger small mt-1" />
                    </div>

                    <!-- Remember Me -->
                    <div class="mb-4 d-flex justify-content-between align-items-center">
                        <div class="form-check mb-0">
                            <InputCheckbox id="rememberMe" class="form-check-input" @bind-Value="Input.RememberMe" />
                            <label class="form-check-label small text-secondary" for="rememberMe">
                                Remember me
                            </label>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <span>Sign In</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </button>
                </EditForm>

                <!-- Resend Verification Link -->
                <div class="mt-4 pt-2 text-center border-top border-secondary border-opacity-10">
                    <a href="/auth/resend-verification" class="text-decoration-none small text-secondary hover-underline">
                        Didn't receive verification email?
                    </a>
                </div>

            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-4">
            <p class="text-secondary small mb-0">&copy; @DateTime.Now.Year Aumo Finance. All rights reserved.</p>
        </div>

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "message")]
    private string? QueryMessage { get; set; }

    [SupplyParameterFromQuery(Name = "successMessage")]
    private string? QuerySuccessMessage { get; set; }

    [SupplyParameterFromQuery(Name = "errorMessage")]
    private string? QueryErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "infoMessage")]
    private string? QueryInfoMessage { get; set; }

    [SupplyParameterFromForm]
    private LoginInputModel Input { get; set; } = default!;

    private string? successMessage;
    private string? errorMessage;
    private string? infoMessage;

    protected override void OnInitialized()
    {
        Input ??= new();

        successMessage = QuerySuccessMessage ?? QueryMessage;
        errorMessage = QueryErrorMessage;
        infoMessage = QueryInfoMessage;
    }

    private async Task HandleLoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input.Email, 
            Input.Password, 
            Input.RememberMe, 
            lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else if (result.RequiresTwoFactor)
        {
            Navigation.NavigateTo("/auth/login-2fa");
        }
        else if (result.IsLockedOut)
        {
            errorMessage = "This account has been locked out. Please try again later.";
        }
        else
        {
            errorMessage = "Invalid email or password.";
        }
    }

    public class LoginInputModel
    {
        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
