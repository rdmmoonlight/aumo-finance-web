@page "/tools"
@namespace AumoFinance.Components.Pages.Tools
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Tools &amp; Utilities</PageTitle>

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-tools me-2 text-warning"></i> Tools &amp; Utilities
            </h2>
            <p class="text-secondary mb-0">System operations and batch data processing.</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (successMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <div class="row g-4">
        <!-- ========================================== -->
        <!-- 1. IMPORT JOURNAL ENTRIES (.XLSX)          -->
        <!-- ========================================== -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-body-tertiary">
                <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0 px-4">
                    <h5 class="fw-bold"><i class="bi bi-file-earmark-spreadsheet text-success me-2"></i> Import Journal Entries</h5>
                </div>
                <div class="card-body px-4">
                    <p class="text-secondary small mb-4">
                        Upload batch journal entries using the standard <code>.xlsx</code> format. Strict validation will be applied to verify debit/credit balance before committing records to the ledger.
                    </p>

                    <!-- Template Format Info -->
                    <div class="bg-body rounded-3 p-3 mb-4 border">
                        <span class="d-block fw-semibold small mb-2">Required Columns (Row 1 Header):</span>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-secondary">Date</span>
                            <span class="badge bg-secondary">Account Name</span>
                            <span class="badge bg-secondary">Description</span>
                            <span class="badge bg-secondary">Ref</span>
                            <span class="badge bg-secondary">Debit</span>
                            <span class="badge bg-secondary">Credit</span>
                        </div>
                        <ul class="text-secondary small mb-3 ps-3">
                            <li>2 Worksheets: <strong>GJ</strong> (General Journal) and <strong>AJ</strong> (Adjusting Journal).</li>
                            <li>Rows sharing the same <strong>Date</strong> will be grouped as a single entry.</li>
                            <li><strong>Ref</strong> corresponds to Chart of Accounts (COA) numbers. Missing accounts will be created automatically.</li>
                        </ul>
                        <a href="/api/Tools/DownloadJournalTemplate" class="btn btn-sm btn-outline-success rounded-3">
                            <i class="bi bi-download me-1"></i> Download Template (.xlsx)
                        </a>
                    </div>

                    <!-- Upload & Preview Form -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Select Excel File</label>
                        <InputFile class="form-control" OnChange="OnFileSelected" accept=".xlsx" />
                    </div>
                    <button type="button" class="btn btn-primary px-4 fw-semibold shadow-sm w-100 rounded-3"
                            disabled="@(selectedFile == null || isBusy)" @onclick="HandlePreview">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-eye me-2"></i>
                        }
                        Preview Entries
                    </button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 2. SYSTEM MAINTENANCE & UTILITIES          -->
        <!-- ========================================== -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-body-tertiary">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-3">
                        <i class="bi bi-database-gear text-info" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold">System Maintenance</h5>
                    <p class="text-secondary small mb-4">
                        Utilities to verify structural integrity and safeguard financial records across all ledgers.
                    </p>

                    <div class="d-grid gap-2 mt-auto">
                        <button type="button" class="btn btn-outline-info btn-sm text-start rounded-3" @onclick="HandleRecalculateLedger" disabled="@isBusy">
                            <i class="bi bi-arrow-repeat me-2"></i> Recalculate Ledger Balances
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm text-start rounded-3" @onclick="HandleBackupDatabase" disabled="@isBusy">
                            <i class="bi bi-file-earmark-excel me-2"></i> Export All Data (.xlsx)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- INSTANT PREVIEW MODAL -->
<div class="modal fade" id="indexPreviewModal" tabindex="-1" aria-labelledby="indexPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="indexPreviewModalLabel">
                        <i class="bi bi-file-earmark-check me-2 text-success"></i> Journal Entries Preview
                    </h5>
                    <small class="text-secondary">
                        @if (parseResult != null)
                        {
                            @($"Found {parseResult.TotalTransactionsRead} transactions with {parseResult.TotalLinesRead} line entries.")
                        }
                        else
                        {
                            @:Review entries below before importing.
                        }
                    </small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                @if (parseResult != null)
                {
                    @if (parseResult.Warnings.Any())
                    {
                        <div class="alert alert-warning rounded-3 mb-4">
                            <ul class="small mb-0 ps-3">
                                @foreach (var w in parseResult.Warnings)
                                {
                                    <li>@w</li>
                                }
                            </ul>
                        </div>
                    }

                    @foreach (var tx in parseResult.Transactions)
                    {
                        <div class="card border mb-3 rounded-3 shadow-sm">
                            <div class="card-header bg-body d-flex justify-content-between align-items-center py-2 px-3">
                                <span class="badge bg-primary">@tx.JournalType Journal</span>
                                <strong><i class="bi bi-calendar-event me-1"></i> @tx.Date.ToString("MMMM d, yyyy")</strong>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover table-striped mb-0 align-middle small">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 50px;" class="text-center">#</th>
                                            <th style="width: 100px;" class="text-center">Ref</th>
                                            <th>Account Name</th>
                                            <th>Description</th>
                                            <th style="width: 150px;" class="text-end">Debit ($)</th>
                                            <th style="width: 150px;" class="text-end">Credit ($)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in tx.Lines)
                                        {
                                            <tr>
                                                <td class="text-center text-secondary">@line.RowIndex</td>
                                                <td class="text-center fw-semibold">@line.RefNumber</td>
                                                <td>
                                                    @line.AccountName
                                                    @if (line.IsNewAccount)
                                                    {
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">New COA</span>
                                                    }
                                                </td>
                                                <td class="text-secondary">@line.Description</td>
                                                <td class="text-end fw-semibold text-success">@(line.Debit?.ToString("N2", Idr) ?? "-")</td>
                                                <td class="text-end fw-semibold text-danger">@(line.Credit?.ToString("N2", Idr) ?? "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-group-divider fw-bold">
                                        <tr>
                                            <td colspan="4" class="text-end">Total Amount:</td>
                                            <td class="text-end text-success">@tx.Lines.Sum(l => l.Debit ?? 0).ToString("N2", Idr)</td>
                                            <td class="text-end text-danger">@tx.Lines.Sum(l => l.Credit ?? 0).ToString("N2", Idr)</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success rounded-3 px-4 fw-semibold shadow-sm"
                        disabled="@(parseResult == null || !parseResult.Transactions.Any() || isBusy)" @onclick="HandleConfirmImport">
                    <i class="bi bi-check2-all me-1"></i> Import Data
                </button>
            </div>
        </div>
    </div>
</div>
