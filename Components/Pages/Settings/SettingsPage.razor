@page "/settings"
@namespace AumoFinance.Components.Pages.Settings
@rendermode InteractiveServer
@attribute [Authorize]

@inject IJSRuntime JSRuntime

<PageTitle>Settings</PageTitle>

<div class="container-fluid p-0">
    <h2 class="mb-4 fw-bold">Application Settings</h2>

    <div class="row">
        <!-- Panel 1: Appearance & Theme -->
        <div class="col-md-6 mb-4">
            <div class="card p-4 h-100 shadow-sm border-0 rounded-4">
                <h5 class="card-title mb-4 fw-bold">
                    <i class="bi bi-palette-fill me-2 text-primary"></i>Appearance &amp; Theme
                </h5>

                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="mb-1 fw-semibold">Dark Mode</h6>
                        <small class="text-secondary">Reduce eye strain when working in low-light environments.</small>
                    </div>
                    <div class="form-check form-switch fs-4">
                        <input class="form-check-input" type="checkbox" role="switch" id="themeToggleSwitch"
                               checked="@isDarkMode" @onchange="OnThemeChanged">
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel 2: Notifications & Reminders -->
        <div class="col-md-6 mb-4">
            <div class="card p-4 h-100 shadow-sm border-0 rounded-4">
                <h5 class="card-title mb-4 fw-bold">
                    <i class="bi bi-bell-fill me-2 text-warning"></i>Notifications &amp; Reminders
                </h5>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="mb-1 fw-semibold">System Alerts</h6>
                        <small class="text-secondary">Receive notifications for important system activities.</small>
                    </div>
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" role="switch" id="systemAlertToggle"
                               checked="@enableSystemAlerts" @onchange="OnSystemAlertsChanged">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isDarkMode = true;
    private bool enableSystemAlerts = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Ambil tema aktif dari localStorage browser saat halaman pertama kali dimuat
            try
            {
                var currentTheme = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "aumo_theme");
                isDarkMode = string.IsNullOrEmpty(currentTheme) || currentTheme == "dark";
                StateHasChanged();
            }
            catch
            {
                // Fallback jika localStorage tidak dapat diakses
                isDarkMode = true;
            }
        }
    }

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        isDarkMode = (bool)(e.Value ?? true);
        var themeName = isDarkMode ? "dark" : "light";

        // Memanggil fungsi setAppTheme JS window yang ada di App.razor
        await JSRuntime.InvokeVoidAsync("setAppTheme", themeName);
    }

    private void OnSystemAlertsChanged(ChangeEventArgs e)
    {
        enableSystemAlerts = (bool)(e.Value ?? true);
    }
}
