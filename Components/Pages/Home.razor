@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Dashboard - Aumo Finance</PageTitle>

<div class="container-fluid py-3">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">Financial Dashboard</h2>
            <p class="text-secondary">Selamat datang kembali di Aumo Finance. Aplikasi kamu sekarang sudah berjalan penuh menggunakan Blazor Web App!</p>
        </div>
    </div>

    <!-- Quick Overview Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 bg-body-tertiary shadow-sm h-100">
                <div class="card-body">
                    <span class="text-secondary small fw-semibold text-uppercase">Status Sistem</span>
                    <h4 class="mt-2 text-success fw-bold">
                        <i class="bi bi-check-circle-fill me-2"></i>Full Blazor Engine
                    </h4>
                    <p class="card-text text-muted small mt-1">MVC Controllers telah berhasil dicabut penuh.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 bg-body-tertiary shadow-sm h-100">
                <div class="card-body">
                    <span class="text-secondary small fw-semibold text-uppercase">Otentikasi</span>
                    <h4 class="mt-2 text-primary fw-bold">
                        <i class="bi bi-shield-lock-fill me-2"></i>Identity Active
                    </h4>
                    <p class="card-text text-muted small mt-1">Sistem otentikasi terintegrasi via Cascading State.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 bg-body-tertiary shadow-sm h-100">
                <div class="card-body">
                    <span class="text-secondary small fw-semibold text-uppercase">Navigasi Cepat</span>
                    <div class="d-flex gap-2 mt-2">
                        <NavLink href="/journal-entry/create" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-journal-plus me-1"></i> Input Jurnal
                        </NavLink>
                        <NavLink href="/reports/general-ledger" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-folder me-1"></i> Laporan
                        </NavLink>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
