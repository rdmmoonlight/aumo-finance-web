@using Microsoft.AspNetCore.Components.Authorization

<header class="topbar-header">
    <div class="topbar-container">

        <!-- CENTER SECTION: QURAN VERSE -->
        <div class="quran-center-wrapper">
            <QuranVerse />
        </div>

        <!-- RIGHT SECTION: ACTION CONTROLS -->
        <div class="topbar-actions">
            <AuthorizeView>
                <Authorized>
                    <button class="topbar-btn" type="button" data-bs-toggle="modal" data-bs-target="#searchModal" aria-label="Search">
                        <svg class="topbar-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                            <path d="M21 21l-6 -6" />
                        </svg>
                        <span class="cmd-shortcut">Command + K</span>
                    </button>
                </Authorized>
            </AuthorizeView>

            <div class="dropdown">
                <button class="topbar-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More Options">
                    <svg class="topbar-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                        <path d="M12 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                        <path d="M12 5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                    </svg>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><h6 class="dropdown-header">Theme Interface</h6></li>
                    <li>
                        <button type="button" class="dropdown-item" onclick="setAppTheme('dark')">
                            <svg class="dropdown-icon text-warning" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" />
                            </svg>
                            Dark Nebula
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item" onclick="setAppTheme('light')">
                            <svg class="dropdown-icon text-warning" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                                <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
                            </svg>
                            Light Minimal
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>

<AuthorizeView>
    <Authorized>
        <div class="status-strip">
            <div class="dropdown">
                <button class="status-badge dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <svg class="dropdown-icon @(periodIconState == "none" ? "text-warning" : periodIconState == "locked" ? "text-secondary" : "text-success")" viewBox="0 0 24 24" aria-hidden="true">
                        @if (periodIconState == "none")
                        {
                            <path d="M4 5m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" />
                            <path d="M16 3v4" />
                            <path d="M8 3v4" />
                            <path d="M4 11h16" />
                            <path d="M10 16l4 4m0 -4l-4 4" />
                        }
                        else if (periodIconState == "locked")
                        {
                            <path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2z" />
                            <path d="M11 16m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                            <path d="M8 11v-4a4 4 0 1 1 8 0v4" />
                        }
                        else
                        {
                            <path d="M4 5m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" />
                            <path d="M16 3v4" />
                            <path d="M8 3v4" />
                            <path d="M4 11h16" />
                            <path d="M9 16l2 2l4 -4" />
                        }
                    </svg>
                    <span class="period-text @(!hasActivePeriod ? "text-danger" : "")">@periodText</span>
                    @if (isViewingClosed)
                    {
                        <span class="badge-locked">LOCKED</span>
                    }
                </button>

                <ul class="dropdown-menu">
                    <li><h6 class="dropdown-header">Accounting Period</h6></li>
                    <li>
                        <NavLink class="dropdown-item text-primary" href="/periods/create">
                            <svg class="dropdown-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                                <path d="M9 12h6" />
                                <path d="M12 9v6" />
                            </svg>
                            Open New Period
                        </NavLink>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <NavLink class="dropdown-item" href="/periods">
                            <svg class="dropdown-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M9 6l11 0" />
                                <path d="M9 12l11 0" />
                                <path d="M9 18l11 0" />
                                <path d="M4 6l0 .01" />
                                <path d="M4 12l0 .01" />
                                <path d="M4 18l0 .01" />
                            </svg>
                            Manage All Periods
                        </NavLink>
                    </li>
                    @if (hasActivePeriod)
                    {
                        <li>
                            <NavLink class="dropdown-item text-danger" href="/periods/clear-selection">
                                <svg class="dropdown-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M10.585 10.587a2 2 0 0 0 2.829 2.828" />
                                    <path d="M16.681 16.673a8.717 8.717 0 0 1 -4.681 1.327c-3.6 0 -6.6 -2 -9 -6c1.272 -2.12 2.712 -3.678 4.32 -4.674m2.86 -1.146a9.055 9.055 0 0 1 1.82 -.18c3.6 0 6.6 2 9 6c-.666 1.11 -1.379 2.067 -2.138 2.87" />
                                    <path d="M3 3l18 18" />
                                </svg>
                                Stop Viewing
                            </NavLink>
                        </li>
                    }
                </ul>
            </div>

            <span class="status-divider">|</span>

            <div class="status-group">
                <button class="status-link text-success" type="button" title="Guardian Security: Protected &amp; Active" aria-label="Guardian Status">
                    <span class="pulse-dot-green"></span>
                    <svg class="dropdown-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" />
                        <path d="M9 12l2 2l4 -4" />
                    </svg>
                    <span class="status-text">PROTECTED</span>
                </button>

                <span class="status-divider">/</span>

                <button id="syncBtn" class="status-link text-info" type="button" title="Sync: Up to date" aria-label="Sync Status">
                    <span id="syncIcon" class="dropdown-icon sync-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12l5 5l10 -10" />
                        </svg>
                    </span>
                    <span class="status-text">SYNCED</span>
                </button>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <div class="modal" id="searchModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-body">
                        <div class="search-input-group">
                            <svg class="dropdown-icon text-warning" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                                <path d="M21 21l-6 -6" />
                            </svg>
                            <input type="search" class="search-input" placeholder="Type a command or search accounts, entries..." autofocus>
                            <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M18 6l-12 12" />
                                    <path d="M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>
