@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<div class="sidebar-wrapper d-flex">
    <nav id="sidebar-icons" class="sidebar-icons text-white d-flex flex-column align-items-center py-2">

        <!-- BRAND / HOME ICON -->
        <NavLink href="/" Match="NavLinkMatch.All" class="mt-1 brand-container text-center text-warning text-decoration-none" title="Aumo Finance Home">
            <i class="bi bi-house-door-fill fs-5"></i>
        </NavLink>

        <!-- GARIS PEMBATAS DI BAWAH IKON HOME -->
        <hr class="border-secondary opacity-50 my-2 w-75">

        <ul class="nav flex-column align-items-center w-100 flex-grow-1">

            <li class="nav-item mb-1">
                <NavLink href="/dashboard" class="nav-link text-white icon-btn" title="Dashboard" @onclick="CloseFlyout">
                    <i class="bi bi-columns-gap fs-6"></i>
                </NavLink>
            </li>

            <!-- MENU AI ASSISTANT -->
            <li class="nav-item mb-1">
                <NavLink href="/ai-assistant" class="nav-link text-white icon-btn" title="AI Financial Assistant" @onclick="CloseFlyout">
                    <i class="bi bi-robot fs-6"></i>
                </NavLink>
            </li>

            <li class="nav-item mb-1">
                <NavLink href="/journal-entry/create" class="nav-link text-white icon-btn" title="Journal Entry" @onclick="CloseFlyout">
                    <i class="bi bi-journal-plus fs-6"></i>
                </NavLink>
            </li>

            <!-- MENU REPORTS (TOGGLE FLYOUT) -->
            <li class="nav-item mb-1">
                <button type="button" @onclick="ToggleReportsFlyout" class="nav-link text-white icon-btn border-0 bg-transparent @(showReportsFlyout ? "active text-warning" : "")" title="Reports">
                    <i class="bi bi-folder fs-6"></i>
                </button>
            </li>

            <li class="nav-item mb-1">
                <NavLink href="/chart-of-accounts" class="nav-link text-white icon-btn" title="Chart of Accounts" @onclick="CloseFlyout">
                    <i class="bi bi-diagram-3 fs-6"></i>
                </NavLink>
            </li>

            <li class="nav-item mb-1">
                <NavLink href="/periods" class="nav-link text-white icon-btn" title="Financial Periods" @onclick="CloseFlyout">
                    <i class="bi bi-calendar3 fs-6"></i>
                </NavLink>
            </li>

            <!-- MENU DOCUMENTS -->
            <li class="nav-item mb-1">
                <NavLink href="/documents" class="nav-link text-white icon-btn" title="Economic Documents" @onclick="CloseFlyout">
                    <i class="bi bi-file-earmark-text fs-6"></i>
                </NavLink>
            </li>

            <li class="nav-item mb-1">
                <NavLink href="/guardian" class="nav-link text-white icon-btn" title="Guardian Security" @onclick="CloseFlyout">
                    <i class="bi bi-shield-check fs-6"></i>
                </NavLink>
            </li>

            <li class="nav-item mb-1">
                <NavLink href="/tools" class="nav-link text-white icon-btn" title="Tools" @onclick="CloseFlyout">
                    <i class="bi bi-tools fs-6"></i>
                </NavLink>
            </li>

        </ul>

        <AuthorizeView>
            <Authorized>
                <div class="mt-auto dropup">
                    <a href="#" class="nav-link text-white icon-btn" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="@context.User.Identity?.Name">
                        <i class="bi bi-person-circle fs-5"></i>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-dark shadow ms-2 mb-2 fs-7" aria-labelledby="userDropdown">
                        <li class="dropdown-header">
                            @(context.User.Identity?.Name ?? "User")
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <NavLink class="dropdown-item d-flex align-items-center" href="/settings" @onclick="CloseFlyout">
                                <i class="bi bi-gear me-2"></i>
                                Settings
                            </NavLink>
                        </li>

                        <li>
                            <form action="/auth/logout" method="post" class="d-inline">
                                <AntiforgeryToken />
                                <button type="submit" class="dropdown-item d-flex align-items-center text-danger border-0 bg-transparent w-100">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="mt-auto">
                    <NavLink href="/auth/login" class="nav-link text-white icon-btn" title="Sign In" @onclick="CloseFlyout">
                        <i class="bi bi-box-arrow-in-right fs-5"></i>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>

    <!-- FLYOUT REPORTS -->
    <div id="reports-flyout" class="sidebar-flyout bg-dark border-end border-secondary text-white @(showReportsFlyout ? "show" : "")" style="@(showReportsFlyout ? "display: block;" : "display: none;")">

        <div class="p-2 border-bottom border-secondary d-flex justify-content-between align-items-center">
            <span class="fw-bold small text-uppercase text-warning">
                Reports
            </span>

            <button type="button" @onclick="CloseFlyout" class="btn-close btn-close-white btn-sm" aria-label="Close">
            </button>
        </div>

        <div class="list-group list-group-flush p-1 small" style="min-width:270px;">

            <NavLink href="/reports/general-journal" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                General Journal
            </NavLink>

            <NavLink href="/reports/general-ledger" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                GL (Permanent Accounts)
            </NavLink>

            <NavLink href="/reports/general-ledger/true" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                GL (Temporary Accounts)
            </NavLink>

            <NavLink href="/reports/trial-balance" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                Trial Balance
            </NavLink>

            <NavLink href="/reports/adjusting-journal" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                Adjusting Journal
            </NavLink>

            <NavLink href="/reports/trial-balance/true" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                Adjusted Trial Balance
            </NavLink>

            <NavLink href="/reports/worksheet" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                Worksheet
            </NavLink>

            <NavLink href="/reports/income-statement" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                Income Statement
            </NavLink>

            <NavLink href="/reports/retained-earnings" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                Retained Earnings
            </NavLink>

            <NavLink href="/reports/statement-of-financial-position" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                Financial Position
            </NavLink>

            <NavLink href="/reports/closing-journal" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                Closing Journal
            </NavLink>

            <NavLink href="/reports/post-closing-trial-balance" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                Post-Closing TB
            </NavLink>

            <NavLink href="/reports/cash-flow" class="list-group-item list-group-item-action bg-transparent text-white border-0 rounded my-1 py-1 px-2" @onclick="CloseFlyout">
                Cash Flow
            </NavLink>

        </div>
    </div>
</div>

@code {
    private bool showReportsFlyout = false;

    private void ToggleReportsFlyout()
    {
        showReportsFlyout = !showReportsFlyout;
    }

    private void CloseFlyout()
    {
        showReportsFlyout = false;
    }
}
