@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<AuthorizeView>
    <Authorized>
        <div class="sidebar-wrapper sidebar-sticky-neon">

            <nav id="sidebar-icons"
                 class="sidebar-icons @(isExpanded ? "expanded" : "")">

                <!-- =====================================================
                     EXPAND / COLLAPSE
                     ===================================================== -->

                <button type="button"
                        class="btn-expand-edge"
                        @onclick="ToggleExpand"
                        title="@(isExpanded ? "Collapse Sidebar" : "Expand Sidebar")"
                        aria-label="@(isExpanded ? "Collapse Sidebar" : "Expand Sidebar")">

                    @if (isExpanded)
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M15 6l-6 6l6 6" />
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M9 6l6 6l-6 6" />
                        </svg>
                    }

                </button>


                <!-- =====================================================
                     BRAND
                     ===================================================== -->

                <NavLink href="/"
                         Match="NavLinkMatch.All"
                         class="brand-container"
                         title="Aumo Finance Home"
                         @onclick="CloseFlyout">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M5 12l-2 0l9 -9l9 9l-2 0" />
                        <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" />
                        <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />
                    </svg>

                    <span class="nav-text">
                        Aumo Finance
                    </span>

                </NavLink>


                <!-- =====================================================
                     DIVIDER
                     ===================================================== -->

                <div class="sidebar-divider">
                    <hr class="hr-glow-white">
                </div>


                <!-- =====================================================
                     MAIN NAVIGATION
                     ===================================================== -->

                <ul class="sidebar-nav">

                    <!-- DASHBOARD -->

                    <li class="nav-item">
                        <NavLink href="/dashboard"
                                 class="nav-link icon-btn"
                                 title="Dashboard"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M4 4h6v8h-6z" />
                                <path d="M4 16h6v4h-6z" />
                                <path d="M14 12h6v8h-6z" />
                                <path d="M14 4h6v4h-6z" />
                            </svg>

                            <span class="nav-text">
                                Dashboard
                            </span>

                        </NavLink>
                    </li>


                    <!-- AI ASSISTANT -->

                    <li class="nav-item">
                        <NavLink href="/ai-assistant"
                                 class="nav-link icon-btn"
                                 title="AI Financial Assistant"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M16 18l1 -2l1 2l2 1l-2 1l-1 2l-1 -2l-2 -1z" />
                                <path d="M12 6l1.106 2.447a2 2 0 0 0 1.447 1.447l2.447 1.106l-2.447 1.106a2 2 0 0 0 -1.447 1.447l-1.106 2.447l-1.106 -2.447a2 2 0 0 0 -1.447 -1.447l-2.447 -1.106l2.447 -1.106a2 2 0 0 0 1.447 -1.447z" />
                            </svg>

                            <span class="nav-text">
                                AI Assistant
                            </span>

                        </NavLink>
                    </li>


                    <!-- JOURNAL ENTRY -->

                    <li class="nav-item">
                        <NavLink href="/journal-entry/create"
                                 class="nav-link icon-btn"
                                 title="Journal Entry"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M6 4h11a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-11a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1z" />
                                <path d="M13.5 15h-6.5" />
                                <path d="M13.5 11h-6.5" />
                                <path d="M13.5 7h-6.5" />
                                <path d="M16 3v18" />
                            </svg>

                            <span class="nav-text">
                                Journal Entry
                            </span>

                        </NavLink>
                    </li>


                    <!-- REPORTS -->

                    <li class="nav-item">
                        <button type="button"
                                class="nav-link icon-btn @(showReportsFlyout ? "active" : "")"
                                @onclick="ToggleReportsFlyout"
                                title="Reports"
                                aria-expanded="@showReportsFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M3 3v18h18" />
                                <path d="M20 18v3" />
                                <path d="M16 16v5" />
                                <path d="M12 13v8" />
                                <path d="M8 16v5" />
                                <path d="M3 11l5 -5l4 4l5 -5" />
                            </svg>

                            <span class="nav-text">
                                Reports
                            </span>

                        </button>


                        <!-- =====================================================
                             REPORTS DROPDOWN (expands downward, in-flow)
                             ===================================================== -->

                        @if (showReportsFlyout)
                        {
                            <div id="reports-flyout"
                                 class="sidebar-flyout">

                                <div class="flyout-header">

                                    <span class="flyout-title">
                                        Financial Reports
                                    </span>

                                    <button type="button"
                                            class="flyout-close"
                                            @onclick="CloseFlyout"
                                            aria-label="Close">

                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M18 6l-12 12" />
                                            <path d="M6 6l12 12" />
                                        </svg>

                                    </button>

                                </div>


                                <div class="reports-list">

                                    <NavLink href="/reports/general-journal"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        General Journal
                                    </NavLink>

                                    <NavLink href="/reports/general-ledger"
                                             Match="NavLinkMatch.All"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        GL (Permanent Accounts)
                                    </NavLink>

                                    <NavLink href="/reports/general-ledger/true"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        GL (Temporary Accounts)
                                    </NavLink>

                                    <NavLink href="/reports/trial-balance"
                                             Match="NavLinkMatch.All"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        Trial Balance
                                    </NavLink>

                                    <NavLink href="/reports/adjusting-journal"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        Adjusting Journal
                                    </NavLink>

                                    <NavLink href="/reports/trial-balance/true"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        Adjusted Trial Balance
                                    </NavLink>

                                    <NavLink href="/reports/worksheet"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        Worksheet
                                    </NavLink>

                                    <NavLink href="/reports/income-statement"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        Income Statement
                                    </NavLink>

                                    <NavLink href="/reports/retained-earnings"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        Retained Earnings
                                    </NavLink>

                                    <NavLink href="/reports/statement-of-financial-position"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        Financial Position
                                    </NavLink>

                                    <NavLink href="/reports/closing-journal"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        Closing Journal
                                    </NavLink>

                                    <NavLink href="/reports/post-closing-trial-balance"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        Post-Closing TB
                                    </NavLink>

                                    <NavLink href="/reports/cash-flow"
                                             class="report-link"
                                             @onclick="CloseFlyout">
                                        Cash Flow
                                    </NavLink>

                                </div>

                            </div>
                        }

                    </li>


                    <!-- CHART OF ACCOUNTS -->

                    <li class="nav-item">
                        <NavLink href="/chart-of-accounts"
                                 class="nav-link icon-btn"
                                 title="Chart of Accounts"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M13 5h8" />
                                <path d="M13 9h5" />
                                <path d="M13 15h8" />
                                <path d="M13 19h5" />
                                <path d="M3 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                                <path d="M3 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                            </svg>

                            <span class="nav-text">
                                Chart of Accounts
                            </span>

                        </NavLink>
                    </li>


                    <!-- FINANCIAL PERIODS -->

                    <li class="nav-item">
                        <NavLink href="/periods"
                                 class="nav-link icon-btn"
                                 title="Financial Periods"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M11.795 21h-6.795a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v4" />
                                <path d="M18 16.496v1.504l1 1" />
                                <path d="M3 10h18" />
                                <path d="M10 3v4" />
                                <path d="M16 3v4" />
                                <path d="M18 22m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                            </svg>

                            <span class="nav-text">
                                Financial Periods
                            </span>

                        </NavLink>
                    </li>


                    <!-- DOCUMENTS -->

                    <li class="nav-item">
                        <NavLink href="/documents"
                                 class="nav-link icon-btn"
                                 title="Economic Documents"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                                <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
                                <path d="M9 9l1 0" />
                                <path d="M9 13l6 0" />
                                <path d="M9 17l6 0" />
                            </svg>

                            <span class="nav-text">
                                Documents
                            </span>

                        </NavLink>
                    </li>


                    <!-- GUARDIAN -->

                    <li class="nav-item">
                        <NavLink href="/guardian"
                                 class="nav-link icon-btn"
                                 title="Guardian Security"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" />
                                <path d="M9 12l2 2l4 -4" />
                            </svg>

                            <span class="nav-text">
                                Guardian
                            </span>

                        </NavLink>
                    </li>


                    <!-- TOOLS -->

                    <li class="nav-item">
                        <NavLink href="/tools"
                                 class="nav-link icon-btn"
                                 title="Tools"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5" />
                            </svg>

                            <span class="nav-text">
                                Tools
                            </span>

                        </NavLink>
                    </li>

                </ul>


                <!-- =====================================================
                     USER MENU
                     ===================================================== -->

                <div class="user-menu">

                    <button id="userDropdown"
                            type="button"
                            class="nav-link icon-btn"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            title="@context.User.Identity?.Name">

                        <svg class="sidebar-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                            <path d="M12 10m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                            <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
                        </svg>

                        <span class="nav-text user-name">
                            @(context.User.Identity?.Name ?? "User")
                        </span>

                    </button>

                    <span class="user-status-indicator"></span>


                    <ul class="user-dropdown"
                        aria-labelledby="userDropdown">

                        <li class="dropdown-header">
                            @(context.User.Identity?.Name ?? "User")
                        </li>

                        <li class="dropdown-divider"></li>

                        <li>
                            <NavLink href="/settings"
                                     class="dropdown-item"
                                     @onclick="CloseFlyout">

                                <svg class="dropdown-icon"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z" />
                                    <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                                </svg>

                                <span>Settings</span>

                            </NavLink>
                        </li>

                        <li>
                            <form action="/auth/logout" method="post">

                                <AntiforgeryToken />

                                <button type="submit"
                                        class="dropdown-item dropdown-danger">

                                    <svg class="dropdown-icon"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2" />
                                        <path d="M7 12h14l-3 -3" />
                                        <path d="M18 15l3 -3" />
                                    </svg>

                                    <span>Sign Out</span>

                                </button>

                            </form>
                        </li>

                    </ul>

                </div>

            </nav>

        </div>
    </Authorized>
</AuthorizeView>
