@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<AuthorizeView>
    <Authorized>
        <div class="sidebar-wrapper sidebar-sticky-neon">

            <nav id="sidebar-icons"
                 class="sidebar-icons @(isExpanded ? "expanded" : "")">

                <!-- =====================================================
                     EXPAND / COLLAPSE
                     ===================================================== -->

                <button type="button"
                        class="btn-expand-edge"
                        @onclick="ToggleExpand"
                        title="@(isExpanded ? "Collapse Sidebar" : "Expand Sidebar")"
                        aria-label="@(isExpanded ? "Collapse Sidebar" : "Expand Sidebar")">

                    @if (isExpanded)
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    }

                </button>


                <!-- =====================================================
                     BRAND
                     ===================================================== -->

                <NavLink href="/"
                         Match="NavLinkMatch.All"
                         class="brand-container"
                         title="Aumo Finance Home"
                         @onclick="CloseFlyout">

                    <svg class="sidebar-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M3 10.5 12 3l9 7.5" />
                        <path d="M5 9.5V21h14V9.5" />
                        <path d="M9 21v-6h6v6" />
                    </svg>

                    <span class="nav-text">
                        Aumo Finance
                    </span>

                </NavLink>


                <!-- =====================================================
                     DIVIDER
                     ===================================================== -->

                <div class="sidebar-divider">
                    <hr class="hr-glow-white">
                </div>


                <!-- =====================================================
                     MAIN NAVIGATION
                     ===================================================== -->

                <ul class="sidebar-nav">

                    <!-- DASHBOARD -->

                    <li class="nav-item">
                        <NavLink href="/dashboard"
                                 class="nav-link icon-btn"
                                 title="Dashboard"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <rect x="3" y="3" width="7" height="7" rx="1" />
                                <rect x="14" y="3" width="7" height="7" rx="1" />
                                <rect x="3" y="14" width="7" height="7" rx="1" />
                                <rect x="14" y="14" width="7" height="7" rx="1" />
                            </svg>

                            <span class="nav-text">
                                Dashboard
                            </span>

                        </NavLink>
                    </li>


                    <!-- AI ASSISTANT -->

                    <li class="nav-item">
                        <NavLink href="/ai-assistant"
                                 class="nav-link icon-btn"
                                 title="AI Financial Assistant"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M12 3v3" />
                                <path d="M12 18v3" />
                                <path d="M3 12h3" />
                                <path d="M18 12h3" />
                                <path d="m5.6 5.6 2.1 2.1" />
                                <path d="m16.3 16.3 2.1 2.1" />
                                <path d="m18.4 5.6-2.1 2.1" />
                                <path d="m7.7 16.3-2.1 2.1" />
                                <circle cx="12" cy="12" r="4" />
                            </svg>

                            <span class="nav-text">
                                AI Assistant
                            </span>

                        </NavLink>
                    </li>


                    <!-- JOURNAL ENTRY -->

                    <li class="nav-item">
                        <NavLink href="/journal-entry/create"
                                 class="nav-link icon-btn"
                                 title="Journal Entry"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M4 4h13a3 3 0 0 1 3 3v13H7a3 3 0 0 1-3-3V4Z" />
                                <path d="M7 20V7a3 3 0 0 1 3-3" />
                                <path d="M12 9h5" />
                                <path d="M12 13h5" />
                                <path d="M12 17h3" />
                            </svg>

                            <span class="nav-text">
                                Journal Entry
                            </span>

                        </NavLink>
                    </li>


                    <!-- REPORTS -->

                    <li class="nav-item">
                        <button type="button"
                                class="nav-link icon-btn @(showReportsFlyout ? "active" : "")"
                                @onclick="ToggleReportsFlyout"
                                title="Reports"
                                aria-expanded="@showReportsFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M4 19V5" />
                                <path d="M4 19h17" />
                                <path d="m7 15 4-4 3 2 5-6" />
                                <path d="M19 7h-4" />
                                <path d="M19 7v4" />
                            </svg>

                            <span class="nav-text">
                                Reports
                            </span>

                        </button>
                    </li>


                    <!-- CHART OF ACCOUNTS -->

                    <li class="nav-item">
                        <NavLink href="/chart-of-accounts"
                                 class="nav-link icon-btn"
                                 title="Chart of Accounts"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <rect x="9" y="3" width="6" height="5" rx="1" />
                                <rect x="3" y="16" width="6" height="5" rx="1" />
                                <rect x="15" y="16" width="6" height="5" rx="1" />
                                <path d="M12 8v4" />
                                <path d="M6 16v-4h12v4" />
                            </svg>

                            <span class="nav-text">
                                Chart of Accounts
                            </span>

                        </NavLink>
                    </li>


                    <!-- FINANCIAL PERIODS -->

                    <li class="nav-item">
                        <NavLink href="/periods"
                                 class="nav-link icon-btn"
                                 title="Financial Periods"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <rect x="3" y="5" width="18" height="16" rx="2" />
                                <path d="M16 3v4" />
                                <path d="M8 3v4" />
                                <path d="M3 10h18" />
                                <path d="M8 14h.01" />
                                <path d="M12 14h.01" />
                                <path d="M16 14h.01" />
                                <path d="M8 18h.01" />
                                <path d="M12 18h.01" />
                            </svg>

                            <span class="nav-text">
                                Financial Periods
                            </span>

                        </NavLink>
                    </li>


                    <!-- DOCUMENTS -->

                    <li class="nav-item">
                        <NavLink href="/documents"
                                 class="nav-link icon-btn"
                                 title="Economic Documents"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M6 3h9l4 4v14H6z" />
                                <path d="M14 3v5h5" />
                                <path d="M9 13h6" />
                                <path d="M9 17h6" />
                            </svg>

                            <span class="nav-text">
                                Documents
                            </span>

                        </NavLink>
                    </li>


                    <!-- GUARDIAN -->

                    <li class="nav-item">
                        <NavLink href="/guardian"
                                 class="nav-link icon-btn"
                                 title="Guardian Security"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M12 3 20 6v6c0 5-3.3 8-8 10-4.7-2-8-5-8-10V6z" />
                                <path d="m8.5 12 2.3 2.3 4.7-5" />
                            </svg>

                            <span class="nav-text">
                                Guardian
                            </span>

                        </NavLink>
                    </li>


                    <!-- TOOLS -->

                    <li class="nav-item">
                        <NavLink href="/tools"
                                 class="nav-link icon-btn"
                                 title="Tools"
                                 @onclick="CloseFlyout">

                            <svg class="sidebar-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M12 3v18" />
                                <path d="M3 12h18" />
                                <path d="M5 5h14v14H5z" />
                                <path d="M8 8h8v8H8z" />
                            </svg>

                            <span class="nav-text">
                                Tools
                            </span>

                        </NavLink>
                    </li>

                </ul>


                <!-- =====================================================
                     USER MENU
                     ===================================================== -->

                <div class="user-menu">

                    <button id="userDropdown"
                            type="button"
                            class="nav-link icon-btn"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            title="@context.User.Identity?.Name">

                        <svg class="sidebar-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M4 21c0-4 3.5-7 8-7s8 3 8 7" />
                        </svg>

                        <span class="nav-text user-name">
                            @(context.User.Identity?.Name ?? "User")
                        </span>

                    </button>

                    <span class="user-status-indicator"></span>


                    <ul class="user-dropdown"
                        aria-labelledby="userDropdown">

                        <li class="dropdown-header">
                            @(context.User.Identity?.Name ?? "User")
                        </li>

                        <li class="dropdown-divider"></li>

                        <li>
                            <NavLink href="/settings"
                                     class="dropdown-item"
                                     @onclick="CloseFlyout">

                                <svg class="dropdown-icon"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true">
                                    <circle cx="12" cy="12" r="3" />
                                    <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.4 1.4-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-2v-.2a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.4-1.4.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H7v-2h.2a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1 1.4-1.4.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V7h2v.2a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.4 1.4-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v2h-.2a1.7 1.7 0 0 0-1.6 1Z" />
                                </svg>

                                <span>Settings</span>

                            </NavLink>
                        </li>

                        <li>
                            <form action="/auth/logout" method="post">

                                <AntiforgeryToken />

                                <button type="submit"
                                        class="dropdown-item dropdown-danger">

                                    <svg class="dropdown-icon"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M10 17l5-5-5-5" />
                                        <path d="M15 12H3" />
                                        <path d="M21 4v16" />
                                    </svg>

                                    <span>Sign Out</span>

                                </button>

                            </form>
                        </li>

                    </ul>

                </div>

            </nav>


            <!-- =====================================================
                 REPORTS FLYOUT
                 ===================================================== -->

            @if (showReportsFlyout)
            {
                <div id="reports-flyout"
                     class="sidebar-flyout">

                    <div class="flyout-header">

                        <span class="flyout-title">
                            Financial Reports
                        </span>

                        <button type="button"
                                class="flyout-close"
                                @onclick="CloseFlyout"
                                aria-label="Close">

                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m6 6 12 12" />
                                <path d="m18 6-12 12" />
                            </svg>

                        </button>

                    </div>


                    <div class="reports-list">

                        <NavLink href="/reports/general-journal"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            General Journal
                        </NavLink>

                        <NavLink href="/reports/general-ledger"
                                 Match="NavLinkMatch.All"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            GL (Permanent Accounts)
                        </NavLink>

                        <NavLink href="/reports/general-ledger/true"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            GL (Temporary Accounts)
                        </NavLink>

                        <NavLink href="/reports/trial-balance"
                                 Match="NavLinkMatch.All"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            Trial Balance
                        </NavLink>

                        <NavLink href="/reports/adjusting-journal"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            Adjusting Journal
                        </NavLink>

                        <NavLink href="/reports/trial-balance/true"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            Adjusted Trial Balance
                        </NavLink>

                        <NavLink href="/reports/worksheet"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            Worksheet
                        </NavLink>

                        <NavLink href="/reports/income-statement"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            Income Statement
                        </NavLink>

                        <NavLink href="/reports/retained-earnings"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            Retained Earnings
                        </NavLink>

                        <NavLink href="/reports/statement-of-financial-position"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            Financial Position
                        </NavLink>

                        <NavLink href="/reports/closing-journal"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            Closing Journal
                        </NavLink>

                        <NavLink href="/reports/post-closing-trial-balance"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            Post-Closing TB
                        </NavLink>

                        <NavLink href="/reports/cash-flow"
                                 class="report-link"
                                 @onclick="CloseFlyout">
                            Cash Flow
                        </NavLink>

                    </div>

                </div>
            }

        </div>
    </Authorized>
</AuthorizeView>
