@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="d-flex vh-100 overflow-hidden">
    <AuthorizeView>
        <Authorized>
            <!-- Sidebar Component -->
            <div class="sidebar-wrapper d-flex">
                <Sidebar />
            </div>
        </Authorized>
    </AuthorizeView>

    <!-- Area Kanan Utama -->
    <div class="d-flex flex-column flex-grow-1 min-vw-0">
        
        <!-- TopBar Component -->
        <TopBar />

        <!-- Main Content Area -->
        <main id="mainContent" class="content flex-grow-1 p-2 p-md-4 overflow-auto" role="main">
            @Body
        </main>

    </div>
</div>

<style>
    body {
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    .sidebar-wrapper {
        position: relative;
        z-index: 100;
    }

    /* Static Icon Bar (52px) */
    .sidebar-icons { 
        width: 52px; 
        min-height: 100vh;
        background-color: #181818; 
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        flex-shrink: 0;
        z-index: 2;
    }

    .sidebar-icons .icon-btn {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.375rem;
        color: #b0b0b0 !important;
        transition: all 0.2s ease;
    }

    .sidebar-icons .icon-btn:hover, 
    .sidebar-icons .icon-btn.active { 
        background-color: rgba(255, 255, 255, 0.15) !important; 
        color: #ffffff !important;
    }

    /* Compact Flyout Panel */
    .sidebar-flyout {
        width: 0;
        opacity: 0;
        visibility: hidden;
        overflow: hidden;
        min-height: 100vh;
        background-color: #212529 !important;
        transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
        white-space: nowrap;
        z-index: 1;
    }

    .sidebar-flyout.show {
        width: 190px;
        opacity: 1;
        visibility: visible;
    }

    .sidebar-flyout .list-group-item {
        font-size: 0.85rem;
    }

    .sidebar-flyout .list-group-item:hover {
        background-color: rgba(255, 255, 255, 0.1) !important;
    }

    [data-bs-theme="light"] .sidebar-icons {
        background-color: #1e2227 !important; 
    }

    .content { 
        transition: background-color 0.3s ease;
    }

    .fs-7 { font-size: 0.825rem; }
    .fs-8 { font-size: 0.725rem; }

    /* Di file .razor ganti @@media cukup dengan @media */
    @media (max-width: 767.98px) {
        #mainContent {
            padding: 0.75rem 0.5rem !important;
        }

        .table-responsive {
            border: 0;
        }

        body {
            font-size: 0.85rem;
        }
    }
</style>
