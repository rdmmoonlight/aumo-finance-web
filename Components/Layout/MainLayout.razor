@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<!-- ==========================================
     Aumo Finance - Main Layout
     Cosmic / Nebula Theme
     ========================================== -->

<div class="aumo-main-shell">

    <!-- TOPBAR -->
    <AuthorizeView>
        <Authorized>
            <AumoFinance.Components.Layout.TopBar />
        </Authorized>
    </AuthorizeView>

    <!-- SHELL UTAMA (Hapus overflow-hidden agar sticky sidebar berfungsi sempurna) -->
    <div class="aumo-body-row">

        <!-- SIDEBAR (Sticky di sebelah kiri) -->
        <AumoFinance.Components.Layout.Sidebar />

        <!-- MAIN CONTENT AREA (Hapus margin-left: 60px dan overflow-auto) -->
        <main id="mainContent" class="content" role="main">
            @Body
        </main>

    </div>

</div>

<style>
    body {
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    .aumo-main-shell {
        display: flex;
        flex-direction: column;

        min-height: 100vh;
        min-width: 0;
    }

    .aumo-body-row {
        display: flex;
        flex: 1 1 auto;

        position: relative;
    }

    .content {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;

        padding: 0.5rem 1rem;

        transition: background-color 0.3s ease;
    }

    @@media (min-width: 768px) {
        .content {
            padding: 1rem 1.5rem;
        }
    }

    @@media (max-width: 767.98px) {
        #mainContent {
            padding: 0.75rem 0.5rem !important;
        }
    }
</style>
