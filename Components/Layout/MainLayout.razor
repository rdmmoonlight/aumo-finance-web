@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<!-- ==========================================
     Aumo Finance - Main Layout
     Cosmic / Nebula Theme
     ========================================== -->

<!-- Tambahan 'min-vh-100' memastikan background/layout memenuhi tinggi layar 100% -->
<div class="d-flex flex-column flex-grow-1 min-vh-100 min-vw-0 aumo-main-shell">

    <AuthorizeView>
        <Authorized>
            <!-- TopBar hanya muncul jika SUDAH Login -->
            <TopBar />
        </Authorized>
        <Authorizing>
            <!-- Opsional: Merender elemen ini saat aplikasi sedang mengecek cookie/sesi -->
            <!-- Bisa diisi teks atau dibiarkan kosong agar layout tetap stabil -->
        </Authorizing>
        <NotAuthorized>
            <!-- Elemen untuk user yang BELUM Login (Guest) -->
            <!-- Dibiarkan kosong agar halaman seperti Login/Register hanya menampilkan @Body -->
        </NotAuthorized>
    </AuthorizeView>

    <!-- Main Content Area -->
    <main id="mainContent"
          class="content flex-grow-1 p-2 p-md-4 overflow-auto d-flex flex-column"
          role="main">

        @Body

    </main>

</div>
