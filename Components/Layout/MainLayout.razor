@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<!-- ==========================================
     Aumo Finance - Main Layout
     Cosmic / Nebula Theme
     ========================================== -->

<div class="d-flex flex-column flex-grow-1 min-vw-0 aumo-main-shell">

    <AuthorizeView>
        <Authorized>
            <!-- TopBar hanya muncul jika SUDAH Login -->
            <TopBar />
        </Authorized>
    </AuthorizeView>

    <!-- Main Content Area -->
    <main id="mainContent"
          class="content flex-grow-1 p-2 p-md-4 overflow-auto d-flex flex-column"
          role="main">

        @Body

    </main>

</div>
