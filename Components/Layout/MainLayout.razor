@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="d-flex flex-column min-vh-100 min-vw-0 aumo-main-shell">

    <!-- TOPBAR -->
    <AuthorizeView>
        <Authorized>
            <AumoFinance.Components.Layout.TopBar @rendermode="InteractiveServer" />
        </Authorized>
    </AuthorizeView>

    <!-- SHELL UTAMA -->
    <div class="d-flex flex-grow-1 overflow-hidden position-relative">
        
        <!-- SIDEBAR (Memanggil Sidebar.razor) -->
        <AumoFinance.Components.Layout.Sidebar @rendermode="InteractiveServer" />

        <!-- MAIN CONTENT AREA (Diberi margin-left 60px agar tidak tertutup sidebar absolute) -->
        <main id="mainContent" class="content flex-grow-1 p-2 p-md-4 overflow-auto d-flex flex-column" style="margin-left: 60px;" role="main">
            @Body
        </main>

    </div>

</div>
