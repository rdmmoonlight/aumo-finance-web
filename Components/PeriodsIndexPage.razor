@using AumoFinance.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject IJSRuntime JS

<div class="container-fluid py-4 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-body-emphasis mb-1">
                <i class="bi bi-calendar3 me-2 text-primary"></i> Accounting Periods
            </h2>
            <p class="text-secondary mb-0">
                Manage your financial reporting cycles.
                Click <i class="bi bi-eye"></i> to view a period — the whole app (Dashboard, journals, reports) will follow it.
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (selectedPeriodId != null)
            {
                <button class="btn btn-outline-secondary fw-semibold shadow-sm" @onclick="ClearSelection">
                    <i class="bi bi-eye-slash me-1"></i> Stop Viewing
                </button>
            }
            <a href="/Periods/Create" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Open New Period
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    @if (successMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm py-2" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center px-4">
            <h5 class="mb-0 fw-bold text-body-emphasis">Period List</h5>
            <span class="text-secondary small fw-semibold">Total Periods: @periods.Count</span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Period Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (periods.Any())
                        {
                            @foreach (var period in periods)
                            {
                                var isSelected = selectedPeriodId == period.Id;
                                <tr class="@(isSelected ? "table-primary" : "")">
                                    <td class="ps-4 fw-bold text-body">
                                        @period.PeriodName
                                        @if (isSelected)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2 small"><i class="bi bi-eye-fill me-1"></i>Viewing</span>
                                        }
                                    </td>
                                    <td><span class="text-secondary">@period.StartDate.ToString("dd MMM yyyy")</span></td>
                                    <td><span class="text-secondary">@period.EndDate.ToString("dd MMM yyyy")</span></td>
                                    <td class="text-center">
                                        @if (period.IsClosed)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1">
                                                <i class="bi bi-lock-fill me-1"></i> Closed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                                <i class="bi bi-unlock-fill me-1"></i> Active
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group shadow-sm">
                                            <button type="button" class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-secondary")"
                                                    title="View this period" @onclick="() => SelectPeriod(period)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            @if (!period.IsClosed)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-warning" title="Close Period"
                                                        @onclick="() => ConfirmAndClosePeriod(period)">
                                                    <i class="bi bi-lock"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="bi bi-calendar-x mb-3 d-block" style="font-size: 2.5rem;"></i>
                                    <p class="mb-0">No accounting periods have been initialized yet.</p>
                                    <small>Click "Open New Period" to start your first accounting cycle.</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid UserId { get; set; }

    private List<Period> periods = new();
    private int? selectedPeriodId;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPeriodsAsync();
    }

    private async Task LoadPeriodsAsync()
    {
        periods = await DbContext.Periods
            .Where(p => p.UserId == UserId)
            .OrderByDescending(p => p.StartDate)
            .ToListAsync();

        selectedPeriodId = (await SelectedPeriodHelper.GetSelectedPeriodAsync(DbContext, UserId))?.Id;
    }

    private async Task SelectPeriod(Period period)
    {
        errorMessage = null;
        var entity = await DbContext.Periods.FirstOrDefaultAsync(p => p.Id == period.Id && p.UserId == UserId);
        if (entity == null)
        {
            errorMessage = "Period not found.";
            return;
        }

        await SelectedPeriodHelper.SelectPeriodAsync(DbContext, UserId, entity.Id);
        successMessage = $"Now viewing {entity.PeriodName}" + (entity.IsClosed ? " (Closed)." : ".");
        await LoadPeriodsAsync();
    }

    private async Task ClearSelection()
    {
        await SelectedPeriodHelper.ClearSelectionAsync(DbContext, UserId);
        successMessage = "No period selected. Reports and journals are hidden until you view a period.";
        await LoadPeriodsAsync();
    }

    private async Task ConfirmAndClosePeriod(Period period)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to close {period.PeriodName}? No further edits will be allowed.");
        if (!confirmed) return;

        errorMessage = null;
        var entity = await DbContext.Periods.FirstOrDefaultAsync(p => p.Id == period.Id && p.UserId == UserId);
        if (entity == null)
        {
            errorMessage = "Period not found.";
            return;
        }

        if (entity.IsClosed)
        {
            errorMessage = $"Period {entity.PeriodName} is already closed.";
            return;
        }

        var hasEarlierOpenPeriod = await DbContext.Periods
            .AnyAsync(p => p.UserId == UserId && p.Id != entity.Id && p.StartDate < entity.StartDate && !p.IsClosed);

        if (hasEarlierOpenPeriod)
        {
            errorMessage = $"Cannot close {entity.PeriodName}: an earlier period is still open. Close earlier periods first.";
            return;
        }

        entity.IsClosed = true;
        await DbContext.SaveChangesAsync();
        successMessage = $"Period {entity.PeriodName} has been closed. Transactions in this period are now locked.";
        await LoadPeriodsAsync();
    }
}
