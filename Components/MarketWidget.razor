@inject NavigationManager NavManager
@inject IHttpClientFactory HttpClientFactory

<div class="market-widget-card card border-0 shadow-sm rounded-4 bg-body bg-opacity-75 backdrop-blur px-3 py-2 mx-auto mb-4" style="max-width: 620px;">
    @if (isLoading)
    {
        <!-- State: Loading -->
        <div class="d-flex justify-content-center align-items-center py-1 gap-2 text-secondary">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <span class="small fw-medium style-loading-text">Loading market indicators...</span>
        </div>
    }
    else if (marketData != null && marketData.Success)
    {
        <!-- State: Success (Centered Layout) -->
        <div class="row align-items-center g-2 text-center justify-content-center">
            
            <!-- USD / IDR -->
            <div class="col-12 col-md-4 border-end-md">
                <div class="d-flex flex-column align-items-center justify-content-center py-1">
                    <span class="text-uppercase text-secondary style-label mb-1">USD / IDR</span>
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span class="fw-bold style-value text-body-emphasis">
                            Rp @marketData.Usd?.Price.ToString("N2", new System.Globalization.CultureInfo("id-ID"))
                        </span>
                        <span class="badge rounded-pill @(marketData.Usd?.IsUp == true ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") style-badge">
                            <i class="bi @(marketData.Usd?.IsUp == true ? "bi-caret-up-fill" : "bi-caret-down-fill") me-1"></i>
                            @(marketData.Usd?.IsUp == true ? "+" : "")@marketData.Usd?.Percent.ToString("F2", new System.Globalization.CultureInfo("id-ID"))%
                        </span>
                    </div>
                </div>
            </div>

            <!-- IHSG (IDX COMPOSITE) -->
            <div class="col-12 col-md-4 border-end-md">
                <div class="d-flex flex-column align-items-center justify-content-center py-1">
                    <span class="text-uppercase text-secondary style-label mb-1">IDX Composite</span>
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span class="fw-bold style-value text-body-emphasis">
                            @marketData.Ihsg?.Price.ToString("N2", new System.Globalization.CultureInfo("id-ID"))
                        </span>
                        <span class="badge rounded-pill @(marketData.Ihsg?.IsUp == true ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") style-badge">
                            <i class="bi @(marketData.Ihsg?.IsUp == true ? "bi-caret-up-fill" : "bi-caret-down-fill") me-1"></i>
                            @(marketData.Ihsg?.IsUp == true ? "+" : "")@marketData.Ihsg?.Percent.ToString("F2", new System.Globalization.CultureInfo("id-ID"))%
                        </span>
                    </div>
                </div>
            </div>

            <!-- BI-RATE -->
            <div class="col-12 col-md-4">
                <div class="d-flex flex-column align-items-center justify-content-center py-1">
                    <span class="text-uppercase text-secondary style-label mb-1">BI-Rate</span>
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span class="fw-bold style-value text-primary">
                            @marketData.BiRate
                        </span>
                    </div>
                </div>
            </div>

        </div>
    }
    else
    {
        <!-- State: Error / Fallback -->
        <div class="d-flex align-items-center justify-content-center text-muted small py-1 gap-2">
            <i class="bi bi-exclamation-circle text-warning"></i>
            <span class="style-loading-text">Market indicators are temporarily unavailable.</span>
        </div>
    }
</div>

<style>
    .style-label {
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        font-weight: 600;
    }
    .style-value {
        font-size: 0.95rem;
    }
    .style-badge {
        font-size: 0.675rem;
        padding: 0.2em 0.5em;
    }
    .style-loading-text {
        font-size: 0.8rem;
    }
    @media (min-width: 768px) {
        .border-end-md {
            border-right: 1px solid var(--bs-border-color-translucent);
        }
    }
</style>

@code {
    private static MarketDataResponse? cachedMarketData;
    private static DateTime lastFetchTime = DateTime.MinValue;
    
    private MarketDataResponse? marketData;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Gunakan cache jika data berumur kurang dari 5 menit untuk menghindari load berulang
        if (cachedMarketData != null && DateTime.Now - lastFetchTime < TimeSpan.FromMinutes(5))
        {
            marketData = cachedMarketData;
            isLoading = false;
            return;
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            var client = HttpClientFactory.CreateClient();
            
            // Pastikan HttpClient menangani base address aplikasi dengan aman
            var baseUrl = NavManager.BaseUri.TrimEnd('/');
            var requestUrl = $"{baseUrl}/Market/GetMarketData";

            var response = await client.GetAsync(requestUrl);
            if (response.IsSuccessStatusCode)
            {
                marketData = await response.Content.ReadFromJsonAsync<MarketDataResponse>();
                if (marketData != null && marketData.Success)
                {
                    cachedMarketData = marketData;
                    lastFetchTime = DateTime.Now;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MarketWidget Error] {ex.Message}");
            // Fallback ke cache sebelumnya jika error saat fetch
            if (cachedMarketData != null)
            {
                marketData = cachedMarketData;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    public class MarketDataResponse
    {
        public bool Success { get; set; }
        public MarketDetail? Usd { get; set; }
        public MarketDetail? Ihsg { get; set; }
        public string? BiRate { get; set; }
    }

    public class MarketDetail
    {
        public double Price { get; set; }
        public double Percent { get; set; }
        public bool IsUp { get; set; }
    }
}
