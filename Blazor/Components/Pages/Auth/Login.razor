@page "/auth/login"
@using System.ComponentModel.DataAnnotations
@using AumoFinance.Models
@using AumoFinance.Services.Security
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Forms

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IGuardianService GuardianService
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Sign In - Aumo Finance</PageTitle>

<div class="d-flex align-items-center justify-content-center min-vh-100 w-100 py-5" style="background-color: var(--aumo-bg, #0D1117);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 text-start">
                
                <!-- Card Container dengan Variable CSS Fallback -->
                <div class="card border rounded-4 p-4 p-md-5 shadow-lg" 
                     style="background-color: var(--aumo-surface, #161B22); border-color: var(--bs-border-color, #2A313C) !important;">
                    <div class="card-body p-0">
                        
                        <!-- Icon Badge -->
                        <div class="text-center mb-3">
                            <div class="d-inline-block p-3 rounded-circle" style="background-color: rgba(59, 130, 246, 0.15); color: var(--aumo-primary, #3B82F6);">
                                <i class="bi bi-shield-lock-fill display-5 lh-1"></i>
                            </div>
                        </div>

                        <!-- Title & Subtitle -->
                        <div class="text-center mb-4">
                            <h2 class="fw-bold mb-1 tracking-tight" style="color: var(--aumo-text, #F8FAFC);">
                                Sign In
                            </h2>
                            <p class="small mb-0" style="color: var(--aumo-text-muted, #94A3B8);">
                                Access your financial dashboard
                            </p>
                        </div>

                        <!-- Alert Messages -->
                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(infoMessage))
                        {
                            <div class="alert alert-info py-2 px-3 small rounded-3 mb-3" role="alert">
                                <i class="bi bi-info-circle-fill me-2"></i>@infoMessage
                            </div>
                        }

                        <!-- Login Form dengan Antiforgery & SSR Form Handler -->
                        <EditForm Model="Input" OnValidSubmit="HandleLoginAsync" FormName="LoginForm" method="post">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger small mb-3" />

                            <!-- Email Input -->
                            <div class="mb-3">
                                <label class="form-label small fw-medium" style="color: var(--aumo-text-muted, #94A3B8);">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text border-end-0" style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C); color: var(--aumo-text-muted, #94A3B8);">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <InputText class="form-control border-start-0 ps-0 text-white" 
                                               style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C);" 
                                               @bind-Value="Input.Email" 
                                               autocomplete="username"
                                               placeholder="name@example.com" />
                                </div>
                                <ValidationMessage For="() => Input.Email" class="text-danger small mt-1" />
                            </div>

                            <!-- Password Input -->
                            <div class="mb-3">
                                <label class="form-label small fw-medium" style="color: var(--aumo-text-muted, #94A3B8);">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text border-end-0" style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C); color: var(--aumo-text-muted, #94A3B8);">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <InputText type="password" 
                                               class="form-control border-start-0 ps-0 text-white" 
                                               style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C);" 
                                               @bind-Value="Input.Password" 
                                               autocomplete="current-password"
                                               placeholder="••••••••" />
                                </div>
                                <ValidationMessage For="() => Input.Password" class="text-danger small mt-1" />
                            </div>

                            <!-- Remember Me -->
                            <div class="mb-4 form-check">
                                <InputCheckbox id="rememberMe" class="form-check-input" @bind-Value="Input.RememberMe" />
                                <label class="form-check-label small" for="rememberMe" style="color: var(--aumo-text-muted, #94A3B8);">
                                    Remember me
                                </label>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-pill fw-medium shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <span>Sign In</span>
                                <i class="bi bi-arrow-right-short fs-5"></i>
                            </button>
                        </EditForm>

                        <!-- Links -->
                        <div class="mt-4 pt-3 text-center border-top" style="border-color: var(--bs-border-color, #2A313C) !important;">
                            <a href="/auth/resend-verification" class="text-decoration-none small" style="color: var(--aumo-text-muted, #94A3B8);">
                                Didn't receive verification email?
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "message")]
    private string? QueryMessage { get; set; }

    [SupplyParameterFromQuery(Name = "successMessage")]
    private string? QuerySuccessMessage { get; set; }

    [SupplyParameterFromQuery(Name = "errorMessage")]
    private string? QueryErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "infoMessage")]
    private string? QueryInfoMessage { get; set; }

    [SupplyParameterFromForm]
    private LoginInputModel Input { get; set; } = default!;

    private string? successMessage;
    private string? errorMessage;
    private string? infoMessage;

    protected override void OnInitialized()
    {
        Input ??= new LoginInputModel();

        successMessage = QuerySuccessMessage ?? QueryMessage;
        errorMessage = QueryErrorMessage;
        infoMessage = QueryInfoMessage;
    }

    private async Task HandleLoginAsync()
    {
        try
        {
            var result = await SignInManager.PasswordSignInAsync(
                Input.Email, 
                Input.Password, 
                Input.RememberMe, 
                lockoutOnFailure: true);

            if (result.Succeeded)
            {
                Logger.LogInformation("User logged in successfully.");

                var user = await UserManager.FindByEmailAsync(Input.Email);
                if (user != null)
                {
                   
                Guid userIdGuid = user.Id != Guid.Empty ? user.Id : Guid.NewGuid();

                    await GuardianService.CreateSessionAsync(
                        userId: userIdGuid,
                        deviceName: "Web Browser",
                        browser: "Unknown",
                        ipAddress: "127.0.0.1",
                        country: "Unknown",
                        refreshTokenHash: "N/A"
                    );

                    await GuardianService.CreateLoginActivityAsync(
                        userId: userIdGuid,
                        activityType: "Login",
                        device: "Web Browser",
                        browser: "Unknown",
                        ipAddress: "127.0.0.1",
                        country: "Unknown",
                        isSuccess: true
                    );
                }

                Navigation.NavigateTo("/", forceLoad: true);
            }
            else if (result.RequiresTwoFactor)
            {
                Navigation.NavigateTo("/auth/login-2fa", forceLoad: true);
            }
            else if (result.IsLockedOut)
            {
                errorMessage = "This account has been locked out. Please try again later.";
            }
            else
            {
                errorMessage = "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error occurred during login attempt: {Message}", ex.Message);
            errorMessage = $"Error: {ex.Message} {(ex.InnerException != null ? "-> " + ex.InnerException.Message : "")}";
        }
    }

    public class LoginInputModel
    {
        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
